#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
bin_dir=${1:-}
case $bin_dir in
	/*) ;;
	*)
		printf 'Usage: %s ABSOLUTE_BIN_DIR\n' "$0" >&2
		exit 2
		;;
esac
mkdir -p "$bin_dir"

NVIM_BIN=${NVIM_BIN:-nvim}
version() {
	version_key=$1
	NVIM_CONFIG_VERSION_KEY=$version_key "$NVIM_BIN" --headless -u NONE -i NONE \
		--cmd "set runtimepath^=$repo_root" \
		-c 'lua local value = require("config.toolchain").versions[vim.env.NVIM_CONFIG_VERSION_KEY]; assert(value); io.write(value)' \
		-c 'quitall!'
}

stylua_version=$(version stylua)
shellcheck_version=$(version shellcheck)
actionlint_version=$(version actionlint)

if ! "$bin_dir/stylua" --version 2>/dev/null | grep -F -x -- "stylua $stylua_version" >/dev/null 2>&1; then
	command -v cargo >/dev/null 2>&1 || {
		printf '%s\n' 'cargo is required to install StyLua' >&2
		exit 1
	}
	cargo install stylua --version "$stylua_version" --locked --root "$(dirname -- "$bin_dir")"
fi

if ! "$bin_dir/actionlint" -version 2>/dev/null | grep -F -x -- "v$actionlint_version" >/dev/null 2>&1; then
	command -v go >/dev/null 2>&1 || {
		printf '%s\n' 'Go is required to install actionlint' >&2
		exit 1
	}
	GOBIN="$bin_dir" go install "github.com/rhysd/actionlint/cmd/actionlint@v$actionlint_version"
fi

if ! "$bin_dir/shellcheck" --version 2>/dev/null | grep -F -x -- "version: $shellcheck_version" >/dev/null 2>&1; then
	command -v curl >/dev/null 2>&1 || {
		printf '%s\n' 'curl is required to install ShellCheck' >&2
		exit 1
	}
	install_tmp=$(mktemp -d "${TMPDIR:-/tmp}/nvim-shellcheck.XXXXXX")
	cleanup() {
		rm -rf -- "$install_tmp"
	}
	trap cleanup 0 HUP INT TERM

	case $(uname -s):$(uname -m) in
		Linux:x86_64)
			platform=linux.x86_64
			archive_ext=tar.xz
			archive_sha=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
			;;
		Linux:aarch64 | Linux:arm64)
			platform=linux.aarch64
			archive_ext=tar.xz
			archive_sha=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588
			;;
		Darwin:x86_64)
			platform=darwin.x86_64
			archive_ext=tar.gz
			archive_sha=c2c15e08df0e8fbc374c335b230a7ee958c313fa5714817a59aa59f1aa594f51
			;;
		Darwin:arm64 | Darwin:aarch64)
			platform=darwin.aarch64
			archive_ext=tar.gz
			archive_sha=339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f
			;;
		*)
			printf 'Unsupported ShellCheck platform: %s %s\n' "$(uname -s)" "$(uname -m)" >&2
			exit 1
			;;
	esac

	archive="shellcheck-v$shellcheck_version.$platform.$archive_ext"
	url="https://github.com/koalaman/shellcheck/releases/download/v$shellcheck_version/$archive"
	curl --fail --location --retry 3 --output "$install_tmp/$archive" "$url"
	if command -v sha256sum >/dev/null 2>&1; then
		actual_sha=$(sha256sum "$install_tmp/$archive" | awk '{ print $1 }')
	else
		actual_sha=$(shasum -a 256 "$install_tmp/$archive" | awk '{ print $1 }')
	fi
	if [ "$actual_sha" != "$archive_sha" ]; then
		printf 'ShellCheck archive checksum mismatch: expected %s, got %s\n' "$archive_sha" "$actual_sha" >&2
		exit 1
	fi
	tar -xf "$install_tmp/$archive" -C "$install_tmp"
	cp "$install_tmp/shellcheck-v$shellcheck_version/shellcheck" "$bin_dir/shellcheck"
	chmod +x "$bin_dir/shellcheck"
fi

printf 'Installed validation tools in %s\n' "$bin_dir"
