#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

check_base_tmp=${TMPDIR:-/tmp}
check_tmp=$(mktemp -d "$check_base_tmp/nvim-config-check.XXXXXX")
# macOS exposes /var as a symlink to /private/var. Security-sensitive state
# roots reject that lexical alias, so publish only the canonical temp path.
check_tmp=$(CDPATH='' cd -- "$check_tmp" && pwd -P)
cleanup() {
	if [ -n "${check_tmp:-}" ] && [ -d "$check_tmp" ]; then
		rm -rf -- "$check_tmp"
	fi
}
trap cleanup 0 HUP INT TERM

mkdir -p "$check_tmp/config" "$check_tmp/state" "$check_tmp/cache" "$check_tmp/log" "$check_tmp/tmp"
export XDG_CONFIG_HOME="$check_tmp/config"
export XDG_STATE_HOME="$check_tmp/state"
export XDG_CACHE_HOME="$check_tmp/cache"
export NVIM_LOG_FILE="$check_tmp/log/nvim.log"
export NVIM_LSP_LOG_FILE="$check_tmp/log/lsp.log"
export NVIM_CONFIG_FILE="$check_tmp/no-local-config.lua"
low_bandwidth_config="$check_tmp/low-bandwidth.lua"
printf '%s\n' 'return { ui = { redraw_profile = "low-bandwidth" } }' > "$low_bandwidth_config"
pinned_theme_dark_config="$check_tmp/pinned-theme-dark.lua"
pinned_theme_light_config="$check_tmp/pinned-theme-light.lua"
printf '%s\n' 'return { plugins = { theme_router = { background = "dark" } } }' > "$pinned_theme_dark_config"
printf '%s\n' 'return { plugins = { theme_router = { background = "light" } } }' > "$pinned_theme_light_config"
export NVIM_CONFIG_ROOT="$repo_root"
export NVIM_CONFIG_OFFLINE=1
export PYTHONDONTWRITEBYTECODE=1
export TMPDIR="$check_tmp"
unset NVIM_APPNAME NVIMPAGER_FILETYPE

if [ -n "${NVIM_CONFIG_XDG_ROOT:-}" ]; then
	export XDG_DATA_HOME="$NVIM_CONFIG_XDG_ROOT/data"
fi

NVIM_BIN=${NVIM_BIN:-nvim}
if ! command -v "$NVIM_BIN" >/dev/null 2>&1; then
	printf 'Required command not found: %s\n' "$NVIM_BIN" >&2
	exit 1
fi

find_tool() {
	tool_name=$1
	if command -v "$tool_name" >/dev/null 2>&1; then
		command -v "$tool_name"
		return 0
	fi
	if [ -n "${XDG_DATA_HOME:-}" ]; then
		data_root="$XDG_DATA_HOME/nvim"
	else
		data_root=$(
			"$NVIM_BIN" --headless -u NONE -i NONE \
				-c 'lua io.write(vim.fn.stdpath("data"))' -c 'quitall!'
		)
	fi
	candidate="$data_root/mason/bin/$tool_name"
	if [ -x "$candidate" ]; then
		printf '%s\n' "$candidate"
		return 0
	fi
	return 1
}

toolchain_version() {
	version_key=$1
	NVIM_CONFIG_VERSION_KEY=$version_key "$NVIM_BIN" --headless -u NONE -i NONE \
		--cmd "set runtimepath^=$repo_root" \
		-c 'lua local value = require("config.toolchain").versions[vim.env.NVIM_CONFIG_VERSION_KEY]; assert(value); io.write(value)' \
		-c 'quitall!'
}

require_version() {
	tool_label=$1
	expected=$2
	expected_line=$3
	shift 3
	actual=$("$@" 2>&1)
	if ! printf '%s\n' "$actual" | grep -F -x -- "$expected_line" >/dev/null 2>&1; then
		printf '%s version mismatch: expected %s, got: %s\n' "$tool_label" "$expected" "$actual" >&2
		exit 1
	fi
}

if ! STYLUA_BIN=$(find_tool stylua); then
	printf 'Required formatter not found: stylua %s\n' "$(toolchain_version stylua)" >&2
	exit 1
fi
if ! SHELLCHECK_BIN=$(find_tool shellcheck); then
	printf 'Required linter not found: shellcheck %s\n' "$(toolchain_version shellcheck)" >&2
	exit 1
fi
if [ -d .github/workflows ]; then
	if ! ACTIONLINT_BIN=$(find_tool actionlint); then
		printf 'Required workflow linter not found: actionlint %s\n' "$(toolchain_version actionlint)" >&2
		exit 1
	fi
fi
if ! TREE_SITTER_BIN=$(find_tool tree-sitter); then
	printf 'Required parser tool not found: tree-sitter %s\n' "$(toolchain_version tree_sitter)" >&2
	exit 1
fi
if ! command -v cc >/dev/null 2>&1; then
	printf '%s\n' 'Required parser compiler not found: cc' >&2
	exit 1
fi

stylua_version=$(toolchain_version stylua)
shellcheck_version=$(toolchain_version shellcheck)
require_version StyLua "$stylua_version" "stylua $stylua_version" "$STYLUA_BIN" --version
require_version ShellCheck "$shellcheck_version" "version: $shellcheck_version" "$SHELLCHECK_BIN" --version
if [ -n "${ACTIONLINT_BIN:-}" ]; then
	actionlint_version=$(toolchain_version actionlint)
	require_version actionlint "$actionlint_version" "$actionlint_version" "$ACTIONLINT_BIN" -version
fi
tree_sitter_version=$(toolchain_version tree_sitter)
require_version tree-sitter "$tree_sitter_version" "tree-sitter $tree_sitter_version" "$TREE_SITTER_BIN" --version

check_timeout=${NVIM_CONFIG_CHECK_TIMEOUT:-90}
run_check() {
	label=$1
	shift
	printf '\n==> %s\n' "$label"
	"$@" &
	check_pid=$!
	(
		sleep "$check_timeout"
		if kill -0 "$check_pid" 2>/dev/null; then
			printf 'Timed out after %ss: %s\n' "$check_timeout" "$label" >&2
			kill -TERM "$check_pid" 2>/dev/null || true
			sleep 2
			kill -KILL "$check_pid" 2>/dev/null || true
		fi
	) &
	watchdog_pid=$!
	set +e
	wait "$check_pid"
	check_status=$?
	set -e
	kill "$watchdog_pid" 2>/dev/null || true
	wait "$watchdog_pid" 2>/dev/null || true
	if [ "$check_status" -ne 0 ]; then
		return "$check_status"
	fi
}

run_pure_test() {
	test_name=$1
	if [ "$test_name" = "local_plugins_spec" ]; then
		run_check "$test_name" "$NVIM_BIN" --headless -u NONE -i NONE -l "$repo_root/tests/$test_name.lua"
		return
	fi
	run_check "$test_name" "$NVIM_BIN" --headless -u NONE -i NONE \
		--cmd "set runtimepath^=$repo_root" \
		--cmd 'lua require("config.local_plugins").setup()' \
		-l "$repo_root/tests/$test_name.lua"
}

run_config_test() {
	test_name=$1
	test_path=$2
	run_check "$test_name" env "NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_config_test_without_file() {
	test_name=$1
	test_path=$2
	run_check "$test_name" env "NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua"
}

run_dap_view_test() {
	test_name=$1
	test_path=$2
	run_check "$test_name" env NVIM_DAP_UI=dap-view "NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_dap_session_test() {
	fixture=$1
	test_path=$2
	run_check "dap_session_spec ($fixture)" env NVIM_DAP_UI=dap-view "NVIM_DAP_FIXTURE=$fixture" \
		"NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" --headless -i NONE \
		--cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_theme_profile_test() {
	profile=$1
	background=$2
	test_path=$3
	if [ "$profile" = "pager" ]; then
		run_check "theme_profile_spec ($profile/$background)" env NVIM_APPNAME=nvimpager \
			NVIM_CONFIG_THEME_BACKGROUND="$background" "NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" \
			--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
		return
	fi
	run_check "theme_profile_spec ($profile/$background)" env NVIM_CONFIG_THEME_BACKGROUND="$background" \
		"NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" --headless -i NONE \
		--cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_pinned_theme_test() {
	background=$1
	test_path=$2
	if [ "$background" = "dark" ]; then
		config_file=$pinned_theme_dark_config
	else
		config_file=$pinned_theme_light_config
	fi
	run_check "theme_pinned_profile_spec ($background)" env NVIM_CONFIG_FILE="$config_file" \
		NVIM_CONFIG_THEME_BACKGROUND="$background" "NVIM_CONFIG_TEST=$test_path" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_pager_test() {
	run_check "pager_profile_spec" env NVIM_APPNAME=nvimpager NVIMPAGER_FILETYPE=markdown \
		NVIM_CONFIG_FILE="$low_bandwidth_config" \
		NVIM_CONFIG_TEST="$repo_root/tests/pager_profile_spec.lua" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_pager_lock_test() {
	run_check "pager profile lock" env NVIM_APPNAME=nvimpager \
		NVIM_CONFIG_TEST="$repo_root/tests/profile_lock_spec.lua" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua"
}

run_vscode_test() {
	run_check "vscode_profile_spec" env NVIM_CONFIG_FILE="$low_bandwidth_config" \
		NVIM_CONFIG_TEST="$repo_root/tests/vscode_profile_spec.lua" "$NVIM_BIN" \
		--headless -i NONE --cmd 'let g:vscode = 1' \
		--cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_redraw_profile_test() {
	label=$1
	profile=$2
	inline_diagnostics=$3
	config_file=$4
	shift 4
	run_check "redraw_profile_spec ($label)" env "$@" NVIM_CONFIG_FILE="$config_file" \
		NVIM_CONFIG_EXPECTED_REDRAW_PROFILE="$profile" \
		NVIM_CONFIG_EXPECTED_INLINE_DIAGNOSTICS="$inline_diagnostics" \
		NVIM_CONFIG_TEST="$repo_root/tests/redraw_profile_spec.lua" "$NVIM_BIN" \
		--headless -i NONE --cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$repo_root/AGENTS.md"
}

run_pure_test lock_spec
run_pure_test core_spec
run_pure_test clipboard_spec
run_pure_test whitespace_spec
run_pure_test execution_spec
run_pure_test ci_spec
run_pure_test security_spec
run_check "trusted_workspace_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/trusted-workspace.nvim/tests/trusted_workspace_spec.lua"
run_check "theme_router_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/theme-router.nvim/tests/theme_router_spec.lua"
run_check "terminal_lifecycle_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/terminal-lifecycle.nvim/tests/terminal_lifecycle_spec.lua"
run_check "exact_editor_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/exact-editor.nvim/tests/exact_editor_spec.lua"
run_check "treesitter_runtime_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/treesitter-runtime.nvim/tests/treesitter_runtime_spec.lua"
run_check "coverage_workbench_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/coverage-workbench.nvim/tests/coverage_workbench_spec.lua"
run_check "repo_scratch_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/repo-scratch.nvim/tests/repo_scratch_spec.lua"
run_check "tab_first_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/tab-first.nvim/tests/tab_first_spec.lua"
run_check "diagram_view_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/diagram-view.nvim/tests/diagram_view_spec.lua"
run_check "verified_tools_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/verified-tools.nvim/tests/verified_tools_spec.lua"
run_check "project_python_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/project-python.nvim/tests/project_python_spec.lua"
run_check "log_workbench_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/log-workbench.nvim/tests/log_workbench_spec.lua"
run_check "clangd_compile_db_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/clangd-compile-db.nvim/tests/clangd_compile_db_spec.lua"
run_check "just_workbench_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/just-workbench.nvim/tests/just_workbench_spec.lua"
run_check "native_review_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/native-review.nvim/tests/native_review_spec.lua"
run_check "native_review_changes_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_changes_spec.lua"
run_check "native_review_projection_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_projection_spec.lua"
run_check "native_review_diff_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_diff_spec.lua"
run_check "native_review_structural_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_structural_spec.lua"
run_check "review_structural_diff_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/review_structural_diff_spec.lua"
run_check "native_review_scope_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_scope_spec.lua"
run_check "native_review_store_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_store_spec.lua"
run_check "native_review_export_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_export_spec.lua"
run_check "native_review_lsp_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_lsp_spec.lua"
run_check "native_review_mode_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_mode_spec.lua"
run_check "native_review_panel_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_panel_spec.lua"
run_check "native_review_presenter_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/tests/native_review_presenter_spec.lua"
run_check "action_palette_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/action-palette.nvim/tests/action_palette_spec.lua"
run_check "devcontainer_editor_plugin_spec" "$NVIM_BIN" --headless -u NONE -i NONE \
	-l "$repo_root/local-plugins/devcontainer-editor.nvim/tests/devcontainer_editor_spec.lua"
run_check "devcontainer_editor_cli_spec" python3 "$repo_root/tests/devcontainer_editor_cli_spec.py"
run_check "verified_npm_bundle_spec" python3 "$repo_root/tests/verified_npm_bundle_spec.py"

for pure_spec in lazy_lock_spec lazy_attestation_spec local_plugins_spec local_config_plugins_spec trusted_workspace_spec markdown_spec project_settings_spec theme_router_spec diagram_view_spec verified_tools_host_spec log_watch_spec log_workbench_spec treesitter_spec pager_spec formatting_spec lint_spec menu_spec action_palette_adapter_spec tabs_spec editor_spec editor_actions_spec navigation_history_spec lsp_navigation_spec lsp_runtime_spec multicursor_spec oil_spec snacks_spec viewer_commands_spec jqx_spec hex_spec auto_session_spec notification_spec ux_spec statusline_performance_spec inline_diagnostics_spec toolchain_spec tombi_spec tool_paths_spec tool_state_spec release_installer_spec npm_release_installer_spec tool_bootstrap_spec provision_runtime_spec health_spec code_review_spec exact_editor_host_spec exact_editor_open_spec devcontainer_editor_host_spec devcontainer_runtime_spec terminal_spec python_spec clangd_cmake_spec just_spec trouble_spec scratch_spec dap_ui_spec workflow_execution_spec redraw_profile_lifecycle_spec; do
	run_pure_test "$pure_spec"
done
run_pure_test markdown_view_spec
run_pure_test markdown_render_navigation_spec
run_pure_test markdown_codeblocks_spec

run_config_test startup_spec "$repo_root/tests/startup_spec.lua"
hex_binary="$check_tmp/initial.bin"
hex_text="$check_tmp/initial.txt"
printf '\001\002binary fixture\n' > "$hex_binary"
printf '%s\n' 'plain text' > "$hex_text"
run_check "hex_startup_spec (binary)" env NVIM_CONFIG_TEST="$repo_root/tests/hex_startup_spec.lua" \
	NVIM_CONFIG_HEX_FILE="$hex_binary" NVIM_CONFIG_HEX_EXPECTED=binary "$NVIM_BIN" --headless -i NONE \
	--cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$hex_binary"
run_check "hex_startup_spec (text)" env NVIM_CONFIG_TEST="$repo_root/tests/hex_startup_spec.lua" \
	NVIM_CONFIG_HEX_FILE="$hex_text" NVIM_CONFIG_HEX_EXPECTED=text "$NVIM_BIN" --headless -i NONE \
	--cmd 'lua dofile(vim.env.NVIM_CONFIG_TEST)' -u "$repo_root/init.lua" "$hex_text"
run_config_test load_contract_spec "$repo_root/tests/load_contract_spec.lua"
run_config_test oil_git_status_spec "$repo_root/tests/oil_git_status_spec.lua"
run_redraw_profile_test full full current-line "$check_tmp/no-local-config.lua" SSH_TTY= SSH_CONNECTION=
run_redraw_profile_test low-bandwidth low-bandwidth off "$low_bandwidth_config" SSH_TTY= SSH_CONNECTION=
run_redraw_profile_test ssh full settled-line "$check_tmp/no-local-config.lua" SSH_TTY= SSH_CONNECTION=fixture
run_config_test log_profile_spec "$repo_root/tests/log_profile_spec.lua"
run_config_test menu_lifecycle_spec "$repo_root/tests/menu_lifecycle_spec.lua"
run_config_test tooling_spec "$repo_root/tests/tooling_spec.lua"
# Keep this DAP/formatter boundary independent from file-triggered LSP startup:
# opening AGENTS.md legitimately resolves Marksman before VimEnter.
run_config_test_without_file tooling_ui_spec "$repo_root/tests/tooling_ui_spec.lua"
run_dap_view_test dap_view_profile_spec "$repo_root/tests/dap_view_profile_spec.lua"
run_dap_session_test python "$repo_root/tests/dap_session_spec.lua"
run_dap_session_test cpp "$repo_root/tests/dap_session_spec.lua"
run_theme_profile_test editor dark "$repo_root/tests/theme_profile_spec.lua"
run_theme_profile_test editor light "$repo_root/tests/theme_profile_spec.lua"
run_theme_profile_test pager dark "$repo_root/tests/theme_profile_spec.lua"
run_theme_profile_test pager light "$repo_root/tests/theme_profile_spec.lua"
run_pinned_theme_test dark "$repo_root/tests/theme_pinned_profile_spec.lua"
run_pinned_theme_test light "$repo_root/tests/theme_pinned_profile_spec.lua"
run_config_test dependency_spec "$repo_root/tests/dependency_spec.lua"
run_config_test coverage_spec "$repo_root/tests/coverage_spec.lua"
run_pager_lock_test
run_pager_test
run_vscode_test

run_check "startup smoke" "$NVIM_BIN" --headless -i NONE -u "$repo_root/init.lua" \
	-c 'lua if vim.g.nvim_config_initialized ~= true then vim.api.nvim_err_writeln("init.lua did not complete"); vim.cmd("cquit 41") end' \
	"+quitall"
run_check "provision-runtime syntax" sh -n scripts/provision-runtime
run_check "devcontainer-runtime syntax" sh -n scripts/devcontainer-runtime
run_check "devcontainer-runtime shellcheck" "$SHELLCHECK_BIN" -s sh scripts/devcontainer-runtime
run_check "StyLua" "$STYLUA_BIN" --check init.lua lua tests local-plugins
run_check "ShellCheck" "$SHELLCHECK_BIN" \
	scripts/check-config scripts/bootstrap-config scripts/install-ci-tools scripts/provision-runtime
if [ -n "${ACTIONLINT_BIN:-}" ]; then
	run_check "actionlint" "$ACTIONLINT_BIN" -shellcheck="$SHELLCHECK_BIN"
fi
run_check "Git whitespace" git diff HEAD --check

printf '\nAll Neovim config checks passed.\n'
