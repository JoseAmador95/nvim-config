from typing import Any, NamedTuple, NoReturn

VERSION = 2
MAX_JSON_BYTES = 64 * 1024
MAX_LOG_BYTES = 256 * 1024
MAX_RECORD_ERROR_CHARS = 4096
RECORD_ERROR_SUFFIX = "... [truncated; see lifecycle log]"
DEFAULT_TIMEOUT_SECONDS = 600.0
SPOOL_TIMEOUT_SECONDS = 5.0
POLL_SECONDS = 0.05
HOST_ACTIONS = {
