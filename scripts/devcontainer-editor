CONTAINER_AGENT_PROXY = (
    r"""import contextlib
import hashlib
import hmac
import os
import pathlib
import selectors
import socket
import stat
import sys
import threading

SOCKET_PATH = pathlib.Path(sys.argv[1])
PORT = int(sys.argv[2])
NONCE = sys.argv[3]
TOKEN_LINE = sys.stdin.buffer.readline(AGENT_AUTH_FRAME_BYTES)
TOKEN_KEY = b""
STOP = threading.Event()
ACTIVE = set()
ACTIVE_LOCK = threading.Lock()
SLOTS = threading.BoundedSemaphore(MAX_AGENT_GATE_CONNECTIONS)
ACCEPT_FAILURE = []


def receive_exact(stream, size):
    payload = bytearray()
    while len(payload) < size:
        chunk = stream.recv(size - len(payload))
        if not chunk:
            break
        payload.extend(chunk)
    return bytes(payload)


def relay_streams(left, right):
    with selectors.DefaultSelector() as selector:
        selector.register(left, selectors.EVENT_READ, right)
        selector.register(right, selectors.EVENT_READ, left)
        while selector.get_map() and not STOP.is_set():
            for key, _mask in selector.select(0.2):
                payload = key.fileobj.recv(65536)
                if payload:
                    key.data.sendall(payload)
                    continue
                selector.unregister(key.fileobj)
                with contextlib.suppress(OSError):
                    key.data.shutdown(socket.SHUT_WR)


def close_stream(stream):
    if stream is not None:
        with contextlib.suppress(OSError):
            stream.shutdown(socket.SHUT_RDWR)
        with contextlib.suppress(OSError):
            stream.close()


def report_cleanup_failures(primary, failures):
    detail = "; ".join(failures)[:4096]
    if primary is None:
        raise RuntimeError(detail)
    with contextlib.suppress(OSError, ValueError):
        print(
            f"container SSH-agent proxy cleanup failed: {detail}",
            file=sys.stderr,
            flush=True,
        )
    if hasattr(primary, "add_note"):
        primary.add_note(detail)


def remember_accept_failure(message):
    with ACTIVE_LOCK:
        if not ACCEPT_FAILURE:
            ACCEPT_FAILURE.append(message)


def serve(client):
    upstream = None
    try:
        upstream = socket.create_connection(("127.0.0.1", PORT), 5.0)
        challenge = receive_exact(upstream, AGENT_AUTH_CHALLENGE_BYTES)
        if len(challenge) != AGENT_AUTH_CHALLENGE_BYTES:
            return
        response = hmac.new(
            TOKEN_KEY,
            PROXY_AUTH_CONTEXT + challenge,
            hashlib.sha256,
        ).digest()
        upstream.sendall(response)
        acknowledgement = receive_exact(upstream, AGENT_AUTH_ACK_BYTES)
        expected = hmac.new(
            TOKEN_KEY,
            GATE_AUTH_CONTEXT + challenge + response,
            hashlib.sha256,
        ).digest()
        if not hmac.compare_digest(acknowledgement, expected):
            return
        upstream.settimeout(None)
        relay_streams(client, upstream)
    except OSError:
        pass
    finally:
        with ACTIVE_LOCK:
            ACTIVE.discard(client)
            if upstream is not None:
                ACTIVE.discard(upstream)
        close_stream(upstream)
        close_stream(client)
        SLOTS.release()


def accept_clients(listener):
    while not STOP.is_set():
        try:
            client, _address = listener.accept()
        except socket.timeout:
            continue
        except OSError as error:
            if not STOP.is_set():
                remember_accept_failure(f"proxy accept failed: {error}")
            return
        if not SLOTS.acquire(blocking=False):
            close_stream(client)
            continue
        with ACTIVE_LOCK:
            ACTIVE.add(client)
        worker = threading.Thread(target=serve, args=(client,), daemon=True)
        try:
            worker.start()
        except RuntimeError as error:
            with ACTIVE_LOCK:
                ACTIVE.discard(client)
            close_stream(client)
            SLOTS.release()
            remember_accept_failure(f"proxy worker start failed: {error}")
            return


def remove_owned_socket(identity):
    try:
        current = SOCKET_PATH.lstat()
    except FileNotFoundError:
        return
    if (current.st_dev, current.st_ino, current.st_uid) != identity:
        raise RuntimeError("proxy socket changed before cleanup")
    SOCKET_PATH.unlink()


def remove_owned_directory(directory, identity):
    try:
        current = real_directory_identity(directory, "proxy directory")
    except FileNotFoundError:
        return
    if current != identity:
        raise RuntimeError("proxy directory changed before cleanup")
    if current[2] != os.getuid() or stat.S_IMODE(current[4]) != 0o700:
        raise RuntimeError("proxy directory is unsafe during cleanup")
    directory.rmdir()


def real_directory_identity(path, label):
    details = path.lstat()
    if stat.S_ISLNK(details.st_mode) or not stat.S_ISDIR(details.st_mode):
        raise RuntimeError(f"{label} is not a real directory")
    return (
        details.st_dev,
        details.st_ino,
        details.st_uid,
        details.st_gid,
        details.st_mode,
    )


def proxy_parent_authority(directory):
    parent = directory.parent
    root = parent.parent
    if root == parent:
        raise RuntimeError("proxy parent authority is incomplete")
    root_identity = real_directory_identity(root, "proxy root")
    parent_identity = real_directory_identity(parent, "proxy parent")
    current_uid = os.getuid()
    for identity, child_owner in (
        (root_identity, parent_identity[2]),
        (parent_identity, current_uid),
    ):
        owner = identity[2]
        mode = identity[4]
        if owner not in (0, current_uid):
            raise RuntimeError("proxy parent authority has an untrusted owner")
        if stat.S_IMODE(mode) & 0o022 and not (
            mode & stat.S_ISVTX and child_owner in (0, current_uid)
        ):
            raise RuntimeError("proxy parent authority is unsafely writable")
    return ((root, root_identity), (parent, parent_identity))


def require_directory_identity(path, expected, label):
    if real_directory_identity(path, label) != expected:
        raise RuntimeError(f"{label} changed during proxy setup")


def require_parent_authority(authority):
    for path, identity in authority:
        require_directory_identity(path, identity, "proxy parent authority")


def prove_listener_path(listener):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    accepted = None
    try:
        client.settimeout(2.0)
        listener.settimeout(2.0)
        client.connect(os.fspath(SOCKET_PATH))
        accepted, _address = listener.accept()
    finally:
        close_stream(accepted)
        close_stream(client)


def prepare_listener():
    directory = SOCKET_PATH.parent
    authority = proxy_parent_authority(directory)
    directory_identity = None
    listener = None
    identity = None
    bound = False
    try:
        previous_umask = os.umask(0o077)
        try:
            directory.mkdir(mode=0o700)
        finally:
            os.umask(previous_umask)
        require_parent_authority(authority)
        directory_identity = real_directory_identity(directory, "proxy directory")
        if (
            directory_identity[2] != os.getuid()
            or stat.S_IMODE(directory_identity[4]) != 0o700
        ):
            raise RuntimeError("proxy directory is unsafe")
        try:
            SOCKET_PATH.lstat()
        except FileNotFoundError:
            pass
        else:
            raise RuntimeError("proxy socket path already exists")
        require_parent_authority(authority)
        require_directory_identity(directory, directory_identity, "proxy directory")
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        previous_umask = os.umask(0o177)
        try:
            listener.bind(os.fspath(SOCKET_PATH))
            bound = True
        finally:
            os.umask(previous_umask)
        created = SOCKET_PATH.lstat()
        identity = (created.st_dev, created.st_ino, created.st_uid)
        if (
            not stat.S_ISSOCK(created.st_mode)
            or created.st_uid != os.getuid()
            or stat.S_IMODE(created.st_mode) != 0o600
        ):
            raise RuntimeError("proxy socket metadata is unsafe after bind")
        os.chmod(SOCKET_PATH, 0o600)
        created = SOCKET_PATH.lstat()
        if (
            not stat.S_ISSOCK(created.st_mode)
            or created.st_uid != os.getuid()
            or stat.S_IMODE(created.st_mode) != 0o600
            or (created.st_dev, created.st_ino, created.st_uid) != identity
        ):
            raise RuntimeError("proxy socket metadata is unsafe")
        require_parent_authority(authority)
        require_directory_identity(directory, directory_identity, "proxy directory")
        listener.listen(MAX_AGENT_GATE_CONNECTIONS)
        prove_listener_path(listener)
        require_parent_authority(authority)
        require_directory_identity(directory, directory_identity, "proxy directory")
        current = SOCKET_PATH.lstat()
        if (current.st_dev, current.st_ino, current.st_uid) != identity:
            raise RuntimeError("proxy socket changed during path proof")
        listener.settimeout(0.2)
        return listener, identity, directory_identity, authority
    except BaseException as primary:
        close_stream(listener)
        cleanup_failures = []
        try:
            if identity is not None:
                remove_owned_socket(identity)
            elif bound:
                raise RuntimeError("proxy socket identity unavailable for cleanup")
        except BaseException as cleanup:
            cleanup_failures.append(f"proxy listener cleanup failed: {cleanup}")
        if directory_identity is not None:
            try:
                require_parent_authority(authority)
                remove_owned_directory(directory, directory_identity)
            except BaseException as cleanup:
                cleanup_failures.append(f"proxy directory cleanup failed: {cleanup}")
        if cleanup_failures:
            report_cleanup_failures(primary, cleanup_failures)
        raise


def authenticate_upstream():
    with socket.create_connection(("127.0.0.1", PORT), 5.0) as upstream:
        challenge = receive_exact(upstream, AGENT_AUTH_CHALLENGE_BYTES)
        if len(challenge) != AGENT_AUTH_CHALLENGE_BYTES:
            raise RuntimeError("relay challenge was incomplete")
        response = hmac.new(
            TOKEN_KEY,
            PROXY_AUTH_CONTEXT + challenge,
            hashlib.sha256,
        ).digest()
        upstream.sendall(response)
        acknowledgement = receive_exact(upstream, AGENT_AUTH_ACK_BYTES)
        expected = hmac.new(
            TOKEN_KEY,
            GATE_AUTH_CONTEXT + challenge + response,
            hashlib.sha256,
        ).digest()
        if not hmac.compare_digest(acknowledgement, expected):
            raise RuntimeError("relay authentication failed")


def wait_for_parent(worker):
    with selectors.DefaultSelector() as selector:
        selector.register(sys.stdin.buffer, selectors.EVENT_READ)
        while True:
            with ACTIVE_LOCK:
                failure = ACCEPT_FAILURE[0] if ACCEPT_FAILURE else None
            if failure is not None:
                raise RuntimeError(failure)
            if not worker.is_alive():
                raise RuntimeError("proxy accept loop exited")
            if not selector.select(0.2):
                continue
            try:
                payload = os.read(sys.stdin.buffer.fileno(), 65536)
            except OSError as error:
                raise RuntimeError(f"proxy parent leash failed: {error}") from error
            if not payload:
                return


def main():
    global TOKEN_KEY
    if (
        len(TOKEN_LINE) != AGENT_AUTH_FRAME_BYTES
        or not TOKEN_LINE.endswith(b"\n")
    ):
        raise RuntimeError("relay token is invalid")
    try:
        TOKEN_KEY = bytes.fromhex(TOKEN_LINE[:-1].decode("ascii"))
    except (UnicodeError, ValueError) as error:
        raise RuntimeError("relay token is invalid") from error
    if len(TOKEN_KEY) != AGENT_AUTH_TOKEN_BYTES:
        raise RuntimeError("relay token is invalid")
    listener, identity, directory_identity, authority = prepare_listener()
    worker = None
    try:
        authenticate_upstream()
        candidate = threading.Thread(target=accept_clients, args=(listener,), daemon=True)
        candidate.start()
        worker = candidate
        if not worker.is_alive():
            raise RuntimeError("proxy accept loop exited before readiness")
        print(NONCE, flush=True)
        wait_for_parent(worker)
    finally:
        primary = sys.exc_info()[1]
        cleanup_failures = []
        STOP.set()
        close_stream(listener)
        with ACTIVE_LOCK:
            streams = tuple(ACTIVE)
        for stream in streams:
            close_stream(stream)
        if worker is not None:
            try:
                worker.join(2.0)
                if worker.is_alive():
                    cleanup_failures.append("proxy accept loop did not stop")
            except BaseException as error:
                cleanup_failures.append(f"proxy accept-loop cleanup failed: {error}")
        try:
            remove_owned_socket(identity)
        except BaseException as error:
            cleanup_failures.append(f"proxy socket cleanup failed: {error}")
        try:
            require_parent_authority(authority)
            remove_owned_directory(SOCKET_PATH.parent, directory_identity)
        except BaseException as error:
            cleanup_failures.append(f"proxy directory cleanup failed: {error}")
        if cleanup_failures:
            report_cleanup_failures(primary, cleanup_failures)


try:
    main()
except Exception as error:
    print(f"container SSH-agent proxy failed: {error}", file=sys.stderr, flush=True)
    raise SystemExit(1)""".replace(
        "AGENT_AUTH_FRAME_BYTES", str(AGENT_AUTH_FRAME_BYTES)
    )
    .replace("AGENT_AUTH_TOKEN_BYTES", str(AGENT_AUTH_TOKEN_BYTES))
    .replace("AGENT_AUTH_CHALLENGE_BYTES", str(AGENT_AUTH_CHALLENGE_BYTES))
    .replace("AGENT_AUTH_ACK_BYTES", str(AGENT_AUTH_ACK_BYTES))
    .replace("PROXY_AUTH_CONTEXT", repr(AGENT_AUTH_PROXY_CONTEXT))
    .replace("GATE_AUTH_CONTEXT", repr(AGENT_AUTH_GATE_CONTEXT))
    .replace("MAX_AGENT_GATE_CONNECTIONS", str(MAX_AGENT_GATE_CONNECTIONS))
)
