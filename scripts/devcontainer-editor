class PaneObservation(NamedTuple):
    """One exact tmux pane observation."""

    dead: bool
    pid: int
    exit_code: int | None
    marker: str


class HostPaneSnapshot(NamedTuple):
    """One atomic tmux projection used to adopt a restarted host editor."""

    pane: str
    dead: bool
    pid: int
    window_name: str
    window_panes: int
    current_path: str
    current_command: str
    marker: str


class SpoolDirectories(NamedTuple):
    """Pinned directory descriptors for one authenticated workspace spool."""

    root: pathlib.Path
    root_fd: int
    inbox_fd: int
    outbox_fd: int
    acks_fd: int


class FileIdentity(NamedTuple):
    """Exact identity of one private regular file."""

    device: int
    inode: int
    size: int
    mode: int
    links: int
    owner: int


class DirectoryIdentity(NamedTuple):
    """Stable identity fields for one owner-controlled directory."""

    device: int
    inode: int
    owner: int


class DirectoryAuthority(NamedTuple):
    """Canonical directory identity and mode protecting one path component."""

    path: pathlib.Path
    device: int
    inode: int
    owner: int
    group: int
    mode: int


class SnapshotSourceIdentity(NamedTuple):
    """Fields that must remain unchanged while copying one source entry."""

    device: int
    inode: int
    size: int
    mode: int
    links: int
    owner: int
    modified_ns: int


class SnapshotTotals(NamedTuple):
    """Bounded file count and byte size for one runtime snapshot."""

    files: int
    size: int
    directories: int = 0


class ConfigSnapshot(NamedTuple):
    """Pinned claim-specific Neovim configuration snapshot."""

    name: str
    path: pathlib.Path
    descriptor: int
    identity: DirectoryIdentity
    marker: str
    totals: SnapshotTotals


class SnapshotLease(NamedTuple):
    """Host-only proof authorizing cleanup of one exact claim snapshot."""

    state_name: str
    state_identity: FileIdentity
    snapshot_name: str
    snapshot_identity: DirectoryIdentity
    marker: str


class HostAgentSnapshot(NamedTuple):
    """Canonical host-agent socket and the identity authorized for forwarding."""

    path: pathlib.Path
    device: int
    inode: int
    owner: int
    mode: int
    authority: tuple[DirectoryAuthority, ...]


class SocketIdentity(NamedTuple):
    """Exact identity of one owned Unix-domain socket leaf."""

    device: int
    inode: int
    owner: int
    mode: int


class PodmanMachine(NamedTuple):
    """Validated local rootless Podman Machine SSH endpoint."""

    name: str
    user: str
    host: str
    port: int
    uid: int
    identity: pathlib.Path
    identity_device: int
    identity_inode: int
    created: str
    pin_id: str


class AgentForwarding(NamedTuple):
    """Resolved SSH-agent transport for one lifecycle."""

    transport: str
    host: HostAgentSnapshot | None
    machine: PodmanMachine | None
    mount_source: pathlib.Path | None
    container_socket: str | None


class StateDirectories(Mapping[str, pathlib.Path]):
    """Pinned private state hierarchy with path-compatible projections."""

    def __init__(
        self, paths: Mapping[str, pathlib.Path], descriptors: Mapping[str, int]
    ) -> None:
        self._paths = dict(paths)
        self._descriptors = dict(descriptors)
        self._closed = False

    def __getitem__(self, name: str) -> pathlib.Path:
        return self._paths[name]

    def __iter__(self) -> Iterator[str]:
        return iter(self._paths)

    def __len__(self) -> int:
        return len(self._paths)

    def descriptor(self, name: str) -> int:
        """Return one live descriptor for a pinned state directory."""
        if self._closed:
            fail("private state hierarchy is already closed")
        return self._descriptors[name]

    def close(self) -> None:
        """Close every pinned state descriptor exactly once."""
        if self._closed:
            return
        self._closed = True
        for descriptor in reversed(tuple(self._descriptors.values())):
            with contextlib.suppress(OSError):
                os.close(descriptor)

    def __del__(self) -> None:
        self.close()


class EditorError(Exception):
    """Report one fail-closed Dev Container editor error."""


class NoActiveEditor(EditorError):
    """Report the only state in which host-editor fallback is allowed."""


class HostPaneTransitioned(EditorError):
    """Report a failure after destructive host-pane restoration began."""


class PanePidChanged(EditorError):
    """Report that a lifecycle pane no longer has its recorded process."""


def fail(message: str) -> NoReturn:
    """Raise one bounded user-facing error.

    :param message: Error detail.
    """
    raise EditorError(message)


def progress(message: str) -> None:
    """Write one launcher progress line.

    :param message: Progress detail.
    """
    print(f"devcontainer-editor: {message}", file=sys.stderr, flush=True)


def warn_nonfatal(message: str) -> None:
    """Emit one warning without changing an already-decided workflow result."""
    with contextlib.suppress(OSError, ValueError):
        progress(message)


def state_root() -> pathlib.Path:
    """Return the private host state root."""
    configured = os.environ.get("NVIM_DEVCONTAINER_STATE_HOME")
    if configured:
        root = pathlib.Path(configured)
    elif os.environ.get("XDG_STATE_HOME"):
        root = pathlib.Path(os.environ["XDG_STATE_HOME"]) / "nvim-devcontainer"
    else:
        root = pathlib.Path.home() / ".local" / "state" / "nvim-devcontainer"
    lexical = pathlib.Path(os.path.abspath(os.fspath(root.expanduser())))
    if lexical.is_symlink():
        fail(f"state path is not a real directory: {lexical}")
    resolved = lexical.resolve(strict=False)
    home = pathlib.Path.home().expanduser().resolve(strict=True)
    temporary = pathlib.Path(tempfile.gettempdir()).resolve(strict=True)
    allowed = (home, temporary)
    if not any(resolved == parent or parent in resolved.parents for parent in allowed):
        fail("Dev Container state must remain below HOME or the private temporary root")
    return resolved


def ensure_dir(path: pathlib.Path) -> pathlib.Path:
    """Create or validate one owner-only, non-symlink directory.

    :param path: Directory to prepare.
    :raises EditorError: If the path is unsafe.
    """
    try:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        mode = path.lstat().st_mode
    except OSError as error:
        raise EditorError(
            f"could not prepare state directory {path}: {error}"
        ) from error
    details = path.lstat()
    if path.is_symlink() or not stat.S_ISDIR(mode) or details.st_uid != os.getuid():
        fail(f"state path is not a real directory: {path}")
    path.chmod(0o700)
    return path


def prepare_state() -> StateDirectories:
    """Prepare and pin every private lifecycle directory."""
    root = ensure_dir(state_root())
    descriptors: dict[str, int] = {}
    try:
        descriptors["root"] = open_directory_path(root, "state root")
        for name in ("workspaces", "locks", "spool", "logs", "machines"):
            descriptors[name] = open_child_directory(
                descriptors["root"],
                name,
                f"state {name} directory",
            )
    except (OSError, EditorError):
        for descriptor in reversed(tuple(descriptors.values())):
            with contextlib.suppress(OSError):
                os.close(descriptor)
        raise
    paths = {
        "root": root,
        **{
            name: root / name
            for name in ("workspaces", "locks", "spool", "logs", "machines")
        },
    }
    return StateDirectories(paths, descriptors)


def directory_flags() -> int:
    """Return flags for opening one directory without following its final name."""
    return os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)


def private_basename(name: str) -> str:
    """Require one non-special basename for descriptor-relative state access."""
    if (
        not name
        or name in {".", ".."}
        or pathlib.PurePath(name).name != name
        or "\0" in name
    ):
        fail("private state entry name is not a basename")
    return name


def validate_directory_descriptor(descriptor: int, label: str) -> None:
    """Require one owner-only real directory descriptor."""
    details = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o700
    ):
        fail(f"{label} is not one owner-only real directory")


def open_directory_path(path: pathlib.Path, label: str) -> int:
    """Open and identity-check one prepared directory path."""
    ensure_dir(path)
    try:
        descriptor = os.open(path, directory_flags())
        opened = os.fstat(descriptor)
        lexical = path.lstat()
    except OSError as error:
        if "descriptor" in locals():
            os.close(descriptor)
        raise EditorError(f"could not open {label}: {error}") from error
    if stat.S_ISLNK(lexical.st_mode) or (opened.st_dev, opened.st_ino) != (
        lexical.st_dev,
        lexical.st_ino,
    ):
        os.close(descriptor)
        fail(f"{label} changed while opening")
    try:
        os.fchmod(descriptor, 0o700)
        validate_directory_descriptor(descriptor, label)
    except (OSError, EditorError):
        os.close(descriptor)
        raise
    return descriptor


def open_existing_directory_path(path: pathlib.Path, label: str) -> int:
    """Open and identity-check an already-private directory without mutating it."""
    try:
        descriptor = os.open(path, directory_flags())
        opened = os.fstat(descriptor)
        lexical = path.lstat()
    except OSError as error:
        if "descriptor" in locals():
            os.close(descriptor)
        raise EditorError(f"could not open {label}: {error}") from error
    if stat.S_ISLNK(lexical.st_mode) or (opened.st_dev, opened.st_ino) != (
        lexical.st_dev,
        lexical.st_ino,
    ):
        os.close(descriptor)
        fail(f"{label} changed while opening")
    try:
        validate_directory_descriptor(descriptor, label)
    except EditorError:
        os.close(descriptor)
        raise
    return descriptor


def open_child_directory(parent_fd: int, name: str, label: str) -> int:
    """Create, open, and pin one owner-only child directory by basename."""
    name = private_basename(name)
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    except OSError as error:
        raise EditorError(f"could not prepare {label}: {error}") from error
    try:
        descriptor = os.open(name, directory_flags(), dir_fd=parent_fd)
        lexical = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        opened = os.fstat(descriptor)
        if stat.S_ISLNK(lexical.st_mode) or (opened.st_dev, opened.st_ino) != (
            lexical.st_dev,
            lexical.st_ino,
        ):
            fail(f"{label} changed while opening")
        os.fchmod(descriptor, 0o700)
        validate_directory_descriptor(descriptor, label)
    except OSError as error:
        if "descriptor" in locals():
            os.close(descriptor)
        raise EditorError(f"could not open {label}: {error}") from error
    except EditorError:
        if "descriptor" in locals():
            os.close(descriptor)
        raise
    return descriptor


@contextlib.contextmanager
def workspace_spool(
    path: pathlib.Path, *, parent_fd: int | None = None
) -> Iterator[SpoolDirectories]:
    """Hold pinned descriptors for one workspace's authenticated spool."""
    descriptors: list[int] = []
    try:
        root_fd = (
            open_child_directory(parent_fd, path.name, "workspace spool")
            if parent_fd is not None
            else open_directory_path(path, "workspace spool")
        )
        descriptors.append(root_fd)
        inbox_fd = open_child_directory(root_fd, "inbox", "workspace spool inbox")
        descriptors.append(inbox_fd)
        outbox_fd = open_child_directory(root_fd, "outbox", "workspace spool outbox")
        descriptors.append(outbox_fd)
        acks_fd = open_child_directory(
            root_fd, "acks", "workspace spool acknowledgements"
        )
        descriptors.append(acks_fd)
        yield SpoolDirectories(path, root_fd, inbox_fd, outbox_fd, acks_fd)
    finally:
        for descriptor in reversed(descriptors):
            with contextlib.suppress(OSError):
                os.close(descriptor)


def revalidate_directory_path(path: pathlib.Path, descriptor: int, label: str) -> None:
    """Require a lexical directory path to still name one pinned identity."""
    try:
        lexical = path.lstat()
        opened = os.fstat(descriptor)
    except OSError as error:
        raise EditorError(f"could not revalidate {label}: {error}") from error
    if (
        stat.S_ISLNK(lexical.st_mode)
        or not stat.S_ISDIR(lexical.st_mode)
        or lexical.st_uid != os.getuid()
        or stat.S_IMODE(lexical.st_mode) != 0o700
        or (lexical.st_dev, lexical.st_ino) != (opened.st_dev, opened.st_ino)
    ):
        fail(f"{label} path no longer names its pinned directory")


def regular_owner_file(path: pathlib.Path) -> bool:
    """Return whether a path is one owner-only regular non-symlink file."""
    try:
        mode = path.lstat().st_mode
    except OSError:
        return False
    details = path.lstat()
    return (
        stat.S_ISREG(mode)
        and not stat.S_ISLNK(mode)
        and stat.S_IMODE(mode) == 0o600
        and details.st_uid == os.getuid()
        and details.st_nlink == 1
    )


def unlink_regular(path: pathlib.Path) -> None:
    """Remove only one regular non-symlink file."""
    try:
        mode = path.lstat().st_mode
    except OSError:
        return
    if stat.S_ISREG(mode) and not stat.S_ISLNK(mode):
        with contextlib.suppress(OSError):
            path.unlink()


def fsync_directory(descriptor: int, label: str) -> None:
    """Persist directory-entry changes through one pinned descriptor."""
    try:
        os.fsync(descriptor)
    except OSError as error:
        raise EditorError(f"could not persist {label}: {error}") from error


def fsync_parent(path: pathlib.Path, label: str) -> None:
    """Persist one path's parent directory after a namespace change."""
    try:
        descriptor = os.open(path.parent, directory_flags())
        opened = os.fstat(descriptor)
        lexical = path.parent.lstat()
        if stat.S_ISLNK(lexical.st_mode) or (opened.st_dev, opened.st_ino) != (
            lexical.st_dev,
            lexical.st_ino,
        ):
            fail(f"{label} directory changed while opening")
        validate_directory_descriptor(descriptor, f"{label} directory")
    except OSError as error:
        if "descriptor" in locals():
            os.close(descriptor)
        raise EditorError(f"could not open {label} directory: {error}") from error
    except EditorError:
        if "descriptor" in locals():
            os.close(descriptor)
        raise
    try:
        fsync_directory(descriptor, f"{label} directory")
    finally:
        os.close(descriptor)


def file_identity(details: os.stat_result) -> FileIdentity:
    """Project one filesystem result into an exact private-file identity."""
    return FileIdentity(
        details.st_dev,
        details.st_ino,
        details.st_size,
        details.st_mode,
        details.st_nlink,
        details.st_uid,
    )


def validate_private_file(
    details: os.stat_result, label: str, maximum: int = MAX_JSON_BYTES
) -> FileIdentity:
    """Require one bounded owner-only, single-link regular file."""
    if (
        not stat.S_ISREG(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o600
        or details.st_nlink != 1
        or details.st_size > maximum
    ):
        fail(
            f"{label} is unsafe, not single-link owner-only, or exceeds {maximum} bytes"
        )
    return file_identity(details)


def exclusive_rename_at(directory_fd: int, source: str, destination: str) -> bool:
    """Move one basename without clobbering through the pinned directory."""
    source = private_basename(source)
    destination = private_basename(destination)
    try:
        if sys.platform == "darwin":
            operation = LIBC.renameatx_np
            flag = 0x00000004
        elif sys.platform.startswith("linux"):
            operation = LIBC.renameat2
            flag = 0x00000001
        else:
            fail("exclusive private-state rename requires Darwin or Linux")
    except AttributeError as error:
        raise EditorError("exclusive private-state rename is unavailable") from error
    operation.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    operation.restype = ctypes.c_int
    ctypes.set_errno(0)
    result = operation(
        directory_fd,
        os.fsencode(source),
        directory_fd,
        os.fsencode(destination),
        flag,
    )
    if result == 0:
        return True
    number = ctypes.get_errno()
    if number == errno.EEXIST:
        return False
    if number == errno.ENOENT:
        raise FileNotFoundError(source)
    raise EditorError(
        f"could not rename private entry {source} to {destination}: {os.strerror(number)}"
    )


def restore_reserved_at(directory_fd: int, reserve: str, name: str) -> None:
    """Restore a displaced replacement without clobbering a newer entry."""
    try:
        restored = exclusive_rename_at(directory_fd, reserve, name)
    except FileNotFoundError as error:
        raise EditorError(
            f"private replacement reservation disappeared: {reserve}"
        ) from error
    if not restored:
        fail(f"private replacement remains preserved at {reserve}")


def report_cleanup_failure(
    primary: BaseException, label: str, cleanup: BaseException
) -> None:
    """Keep a control-flow exception primary while reporting cleanup failure."""
    message = f"{label}: {cleanup}"
    if isinstance(primary, Exception):
        raise EditorError(f"{primary}; {message}") from primary
    if hasattr(primary, "add_note"):
        primary.add_note(message)
    warn_nonfatal(f"warning: {message}")


def restore_reserved_on_failure(
    directory_fd: int,
    reserve: str,
    name: str,
    label: str,
) -> None:
    """Restore a reservation on every exceptional control-flow exit."""
    try:
        restored = exclusive_rename_at(directory_fd, reserve, name)
    except FileNotFoundError:
        return
    except OSError as cleanup:
        raise EditorError(f"{label}: {cleanup}") from cleanup
    if not restored:
        fail(f"{label}: private replacement remains preserved at {reserve}")


def retirement_reservation_name(name: str) -> str:
    """Return one caller-known no-clobber reservation basename."""
    name = private_basename(name)
    return f".{name}.{os.getpid()}.{secrets.token_hex(16)}.retire"


def reserve_private_entry_at(
    directory_fd: int, name: str, reserve: str | None = None
) -> str | None:
    """Move one current basename to a unique no-clobber reservation."""
    name = private_basename(name)
    reserve = private_basename(reserve or retirement_reservation_name(name))
    completed = False
    try:
        if exclusive_rename_at(directory_fd, name, reserve):
            completed = True
            return reserve
    except FileNotFoundError:
        completed = True
        return None
    finally:
        if not completed:
            primary = sys.exc_info()[1]
            assert primary is not None
            try:
                restore_reserved_on_failure(
                    directory_fd,
                    reserve,
                    name,
                    "retirement reservation restoration failed",
                )
            except (EditorError, OSError) as cleanup:
                report_cleanup_failure(
                    primary,
                    "retirement reservation restoration failed",
                    cleanup,
                )
    fail(f"could not allocate a retirement reservation for {name}")


def fail_retirement_after_restore(
    directory_fd: int,
    reserve: str,
    name: str,
    message: str,
    cause: OSError,
) -> NoReturn:
    """Best-effort restore a reserved basename before reporting retirement failure."""
    try:
        raise EditorError(message) from cause
    except EditorError as primary:
        try:
            restore_reserved_at(directory_fd, reserve, name)
        except (EditorError, OSError) as restoration:
            raise EditorError(
                f"{primary}; retirement reservation restoration failed: {restoration}"
            ) from primary
        raise


def retire_expected_private_file_at(
    directory_fd: int,
    name: str,
    expected: FileIdentity,
) -> bool:
    """Reserve, revalidate, and retire one expected private file."""
    reservation = retirement_reservation_name(name)
    reserve: str | None = None
    retired = False
    try:
        reserve = reserve_private_entry_at(directory_fd, name, reservation)
        if reserve is None:
            return False
        try:
            reserved = os.stat(reserve, dir_fd=directory_fd, follow_symlinks=False)
        except OSError as error:
            raise EditorError(
                f"could not inspect retirement reservation {reserve}: {error}"
            ) from error
        if file_identity(reserved) != expected:
            fail(f"private entry changed during conditional retirement: {name}")
        try:
            os.unlink(reserve, dir_fd=directory_fd)
        except OSError as error:
            raise EditorError(
                f"could not retire private entry {name}: {error}"
            ) from error
        retired = True
    finally:
        primary = sys.exc_info()[1]
        if not retired and primary is not None:
            try:
                restore_reserved_on_failure(
                    directory_fd,
                    reserve or reservation,
                    name,
                    "retirement reservation restoration failed",
                )
            except (EditorError, OSError) as cleanup:
                report_cleanup_failure(
                    primary,
                    "retirement reservation restoration failed",
                    cleanup,
                )
    return True


def unlink_regular_at(
    directory_fd: int,
    name: str,
    *,
    durable: bool = False,
    expected: FileIdentity | None = None,
    maximum: int = MAX_JSON_BYTES,
) -> bool:
    """Conditionally retire one exact private file through a pinned directory."""
    name = private_basename(name)
    try:
        details = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return False
    except OSError as error:
        raise EditorError(f"could not inspect private entry {name}: {error}") from error
    current = validate_private_file(details, f"private entry {name}", maximum)
    if not retire_expected_private_file_at(
        directory_fd,
        name,
        expected or current,
    ):
        return False
    if durable:
        try:
            fsync_directory(directory_fd, f"private entry removal {name}")
        except EditorError as warning:
            warn_nonfatal(f"warning: {warning}; retirement was already committed")
    return True


def entry_exists_at(directory_fd: int, name: str) -> bool:
    """Return whether one basename exists without following it."""
    name = private_basename(name)
    try:
        os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return False
    except OSError as error:
        raise EditorError(f"could not inspect private entry {name}: {error}") from error
    return True


def directory_identity(details: os.stat_result) -> DirectoryIdentity:
    """Project the stable identity of one owner-controlled directory."""
    return DirectoryIdentity(details.st_dev, details.st_ino, details.st_uid)


def snapshot_source_identity(
    details: os.stat_result, label: str
) -> SnapshotSourceIdentity:
    """Validate and identify one safe runtime-snapshot source entry."""
    mode = details.st_mode
    safe_kind = stat.S_ISDIR(mode) or (stat.S_ISREG(mode) and details.st_nlink == 1)
    if (
        not safe_kind
        or stat.S_ISLNK(mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(mode) & 0o022
    ):
        fail(
            f"{label} is not an owner-controlled, non-writable directory "
            "or single-link regular file"
        )
    return SnapshotSourceIdentity(
        details.st_dev,
        details.st_ino,
        details.st_size,
        details.st_mode,
        details.st_nlink,
        details.st_uid,
        details.st_mtime_ns,
    )


def snapshot_name(claim_id: object) -> str:
    """Return the private config-snapshot basename for one lifecycle claim."""
    claim = canonical_uuid4(claim_id, "lifecycle claim id")
    return f"config-{claim}"


def remote_snapshot_path(remote_spool: str, claim_id: object) -> str:
    """Return one canonical in-container path for a claim snapshot."""
    if not canonical_posix_absolute(remote_spool):
        fail("remote spool path is invalid")
    return posixpath.join(remote_spool, snapshot_name(claim_id))


def open_snapshot_source_path(path: pathlib.Path) -> tuple[int, SnapshotSourceIdentity]:
    """Open and pin the canonical host config root without following symlinks."""
    if not path.is_absolute() or path.resolve(strict=False) != path:
        fail("Neovim config snapshot source must be canonical and absolute")
    descriptor: int | None = None
    retained = False
    try:
        descriptor = os.open(path, directory_flags())
        lexical = path.lstat()
        opened = os.fstat(descriptor)
        lexical_identity = snapshot_source_identity(
            lexical, "Neovim config snapshot source"
        )
        opened_identity = snapshot_source_identity(
            opened, "opened Neovim config snapshot source"
        )
        if lexical_identity != opened_identity or not stat.S_ISDIR(opened.st_mode):
            fail("Neovim config snapshot source changed while opening")
        retained = True
        return descriptor, opened_identity
    except OSError as error:
        raise EditorError(
            f"could not open Neovim config snapshot source: {error}"
        ) from error
    finally:
        if descriptor is not None and not retained:
            with contextlib.suppress(OSError):
                os.close(descriptor)


def source_entry_at(
    directory_fd: int, name: str, label: str
) -> tuple[os.stat_result, SnapshotSourceIdentity]:
    """Inspect one no-follow source entry relative to a pinned directory."""
    name = private_basename(name)
    try:
        details = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except OSError as error:
        raise EditorError(f"could not inspect {label}: {error}") from error
    return details, snapshot_source_identity(details, label)


def open_snapshot_source_directory_at(
    parent_fd: int,
    name: str,
    expected: SnapshotSourceIdentity,
    label: str,
) -> int:
    """Open an exact source child directory through its pinned parent."""
    descriptor: int | None = None
    retained = False
    try:
        descriptor = os.open(name, directory_flags(), dir_fd=parent_fd)
        opened = os.fstat(descriptor)
        if snapshot_source_identity(opened, label) != expected or not stat.S_ISDIR(
            opened.st_mode
        ):
            fail(f"{label} changed while opening")
        retained = True
        return descriptor
    except OSError as error:
        raise EditorError(f"could not open {label}: {error}") from error
    finally:
        if descriptor is not None and not retained:
            with contextlib.suppress(OSError):
                os.close(descriptor)


def bounded_snapshot_totals(totals: SnapshotTotals, file_size: int) -> SnapshotTotals:
    """Add one file to the bounded runtime-snapshot accounting."""
    candidate = SnapshotTotals(
        totals.files + 1,
        totals.size + file_size,
        totals.directories,
    )
    if candidate.files > MAX_CONFIG_SNAPSHOT_FILES:
        fail("Neovim config snapshot exceeds its file-count limit")
    if candidate.size > MAX_CONFIG_SNAPSHOT_BYTES:
        fail("Neovim config snapshot exceeds its byte-size limit")
    return candidate


def bounded_snapshot_directory(totals: SnapshotTotals) -> SnapshotTotals:
    """Add one directory to bounded runtime-snapshot accounting."""
    candidate = SnapshotTotals(
        totals.files,
        totals.size,
        totals.directories + 1,
    )
    if candidate.directories > MAX_CONFIG_SNAPSHOT_DIRECTORIES:
        fail("Neovim config snapshot exceeds its directory-count limit")
    return candidate


def bounded_directory_names(directory_fd: int, label: str) -> list[str]:
    """Collect one directory's basenames without unbounded materialization."""
    names: list[str] = []
    try:
        with os.scandir(directory_fd) as entries:
            for entry in entries:
                if len(names) >= MAX_CONFIG_SNAPSHOT_DIRECTORY_ENTRIES:
                    fail(
                        "Neovim config snapshot exceeds its per-directory "
                        "entry-count limit"
                    )
                names.append(private_basename(entry.name))
    except OSError as error:
        raise EditorError(f"could not scan {label}: {error}") from error
    names.sort()
    return names


def write_snapshot_bytes(
    source_fd: int, destination_fd: int, expected_size: int
) -> int:
    """Copy one bounded file exactly between already-validated descriptors."""
    copied = 0
    while True:
        chunk = os.read(source_fd, min(64 * 1024, expected_size - copied + 1))
        if not chunk:
            return copied
        copied += len(chunk)
        if copied > expected_size or copied > MAX_CONFIG_SNAPSHOT_BYTES:
            fail("Neovim config snapshot source changed size while copying")
        offset = 0
        while offset < len(chunk):
            written = os.write(destination_fd, chunk[offset:])
            if written <= 0:
                fail("could not make progress while copying config snapshot")
            offset += written


def copy_or_validate_snapshot_file_at(
    source_parent_fd: int,
    destination_parent_fd: int | None,
    name: str,
    identity: SnapshotSourceIdentity,
    totals: SnapshotTotals,
) -> SnapshotTotals:
    """Validate one source file and optionally make an independent private copy."""
    updated = bounded_snapshot_totals(totals, identity.size)
    source_fd: int | None = None
    destination_fd: int | None = None
    copied = identity.size
    committed = destination_parent_fd is None
    try:
        source_fd = os.open(
            name,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=source_parent_fd,
        )
        if snapshot_source_identity(os.fstat(source_fd), name) != identity:
            fail(f"Neovim config snapshot source changed while opening: {name}")
        if destination_parent_fd is not None:
            destination_fd = os.open(
                name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=destination_parent_fd,
            )
            copied = write_snapshot_bytes(source_fd, destination_fd, identity.size)
            os.fchmod(destination_fd, 0o500 if identity.mode & 0o111 else 0o400)
            os.fsync(destination_fd)
        current = snapshot_source_identity(os.fstat(source_fd), name)
        _, lexical = source_entry_at(source_parent_fd, name, name)
        if current != identity or lexical != identity or copied != identity.size:
            fail(f"Neovim config snapshot source changed while copying: {name}")
        committed = True
    except OSError as error:
        raise EditorError(
            f"could not copy Neovim config snapshot file {name}: {error}"
        ) from error
    finally:
        try:
            if source_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(source_fd)
        finally:
            try:
                if destination_fd is not None:
                    with contextlib.suppress(OSError):
                        os.close(destination_fd)
            finally:
                if not committed and destination_parent_fd is not None:
                    with contextlib.suppress(OSError):
                        os.unlink(name, dir_fd=destination_parent_fd)
    return updated


def create_snapshot_directory_at(parent_fd: int, name: str) -> int:
    """Exclusively create and open one owner-only destination directory."""
    created = False
    descriptor: int | None = None
    retained = False
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
        created = True
        descriptor = os.open(name, directory_flags(), dir_fd=parent_fd)
        os.fchmod(descriptor, 0o700)
        retained = True
        return descriptor
    except OSError as error:
        raise EditorError(
            f"could not create config snapshot directory {name}: {error}"
        ) from error
    finally:
        if not retained:
            if descriptor is not None:
                with contextlib.suppress(OSError):
                    os.close(descriptor)
            if created:
                with contextlib.suppress(OSError):
                    os.rmdir(name, dir_fd=parent_fd)


def copy_or_validate_snapshot_entry_at(
    source_parent_fd: int,
    destination_parent_fd: int | None,
    name: str,
    depth: int,
    totals: SnapshotTotals,
) -> SnapshotTotals:
    """Validate or copy one bounded runtime-closure entry."""
    if depth > MAX_CONFIG_SNAPSHOT_DEPTH:
        fail("Neovim config snapshot exceeds its directory-depth limit")
    details, identity = source_entry_at(source_parent_fd, name, name)
    if stat.S_ISREG(details.st_mode):
        return copy_or_validate_snapshot_file_at(
            source_parent_fd, destination_parent_fd, name, identity, totals
        )
    source_fd: int | None = None
    destination_fd: int | None = None
    try:
        source_fd = open_snapshot_source_directory_at(
            source_parent_fd, name, identity, name
        )
        directory_totals = bounded_snapshot_directory(totals)
        if destination_parent_fd is not None:
            destination_fd = create_snapshot_directory_at(
                destination_parent_fd,
                name,
            )
        updated = copy_or_validate_snapshot_directory(
            source_fd, destination_fd, depth, directory_totals
        )
        _, lexical = source_entry_at(source_parent_fd, name, name)
        if (
            snapshot_source_identity(os.fstat(source_fd), name) != identity
            or lexical != identity
        ):
            fail(f"Neovim config snapshot source changed while copying: {name}")
        if destination_fd is not None:
            os.fchmod(destination_fd, 0o500)
            os.fsync(destination_fd)
        return updated
    except OSError as error:
        raise EditorError(
            f"could not copy config snapshot directory {name}: {error}"
        ) from error
    finally:
        try:
            if source_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(source_fd)
        finally:
            if destination_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(destination_fd)


def copy_or_validate_snapshot_directory(
    source_fd: int,
    destination_fd: int | None,
    depth: int,
    totals: SnapshotTotals,
) -> SnapshotTotals:
    """Walk one pinned runtime directory without following entry links."""
    names = bounded_directory_names(source_fd, "Neovim config snapshot source")
    updated = totals
    for name in names:
        updated = copy_or_validate_snapshot_entry_at(
            source_fd, destination_fd, name, depth + 1, updated
        )
    return updated


def populate_or_validate_config_snapshot(
    source: pathlib.Path, destination_fd: int | None = None
) -> SnapshotTotals:
    """Validate the explicit runtime closure and optionally copy it."""
    source_fd: int | None = None
    try:
        source_fd, source_identity = open_snapshot_source_path(source)
        totals = SnapshotTotals(0, 0)
        for name in CONFIG_SNAPSHOT_REQUIRED + CONFIG_SNAPSHOT_OPTIONAL:
            try:
                os.stat(name, dir_fd=source_fd, follow_symlinks=False)
            except FileNotFoundError:
                if name in CONFIG_SNAPSHOT_OPTIONAL:
                    continue
                fail(f"required Neovim config snapshot entry is missing: {name}")
            except OSError as error:
                raise EditorError(
                    f"could not inspect config snapshot entry {name}: {error}"
                ) from error
            totals = copy_or_validate_snapshot_entry_at(
                source_fd, destination_fd, name, 1, totals
            )
        current = snapshot_source_identity(
            os.fstat(source_fd), "Neovim config snapshot source"
        )
        try:
            lexical_details = source.lstat()
        except OSError as error:
            raise EditorError(
                f"could not revalidate Neovim config snapshot source: {error}"
            ) from error
        lexical = snapshot_source_identity(
            lexical_details, "Neovim config snapshot source"
        )
        if current != source_identity or lexical != source_identity:
            fail("Neovim config snapshot source changed while copying")
        return totals
    finally:
        if source_fd is not None:
            with contextlib.suppress(OSError):
                os.close(source_fd)


def validate_config_snapshot_source(
    source: pathlib.Path | None = None,
) -> SnapshotTotals:
    """Read-only validate the bounded Neovim runtime snapshot closure."""
    return populate_or_validate_config_snapshot(source or CONFIG_ROOT)


def valid_snapshot_marker(value: object) -> bool:
    """Return whether a marker is one bounded URL-safe opaque value."""
    alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
    return (
        isinstance(value, str)
        and 32 <= len(value) <= 128
        and all(character in alphabet for character in value)
    )


def write_all_bytes(descriptor: int, payload: bytes, label: str) -> None:
    """Write a complete bounded payload or fail without losing ownership."""
    offset = 0
    while offset < len(payload):
        written = os.write(descriptor, payload[offset:])
        if written <= 0:
            fail(f"could not make progress while writing {label}")
        offset += written


def close_descriptor_error(descriptor: int | None) -> OSError | None:
    """Close one optional descriptor and return a non-fatal close failure."""
    if descriptor is None:
        return None
    try:
        os.close(descriptor)
    except OSError as cleanup:
        return cleanup
    return None


def close_created_file(
    descriptor: int | None,
    directory_fd: int,
    name: str,
    identity: tuple[int, int, int] | None,
    remove: bool,
) -> OSError | None:
    """Close one created file and optionally unlink only its exact inode."""
    cleanup_failure: OSError | None = None
    try:
        if descriptor is not None and remove and identity is None:
            try:
                opened = os.fstat(descriptor)
                identity = (opened.st_dev, opened.st_ino, opened.st_uid)
            except OSError as cleanup:
                cleanup_failure = cleanup
    finally:
        close_failure = close_descriptor_error(descriptor)
        cleanup_failure = cleanup_failure or close_failure
    if not remove or identity is None:
        return cleanup_failure
    try:
        lexical = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (lexical.st_dev, lexical.st_ino, lexical.st_uid) == identity:
            os.unlink(name, dir_fd=directory_fd)
    except FileNotFoundError:
        pass
    except OSError as cleanup:
        cleanup_failure = cleanup_failure or cleanup
    return cleanup_failure


def finish_cleanup(
    primary: BaseException | None,
    label: str,
    cleanup_failure: BaseException | None,
) -> None:
    """Raise or annotate one cleanup failure after all cleanup was attempted."""
    if cleanup_failure is None:
        return
    if primary is None:
        raise EditorError(f"{label}: {cleanup_failure}") from cleanup_failure
    report_cleanup_failure(primary, label, cleanup_failure)


def create_snapshot_marker_at(directory_fd: int, marker: str) -> int:
    """Create and freeze the marker that binds host and mounted snapshots."""
    if not valid_snapshot_marker(marker):
        fail("config snapshot marker is invalid")
    payload = f"{marker}\n".encode()
    descriptor: int | None = None
    created = False
    completed = False
    opened_identity: tuple[int, int, int] | None = None
    try:
        try:
            descriptor = os.open(
                CONFIG_SNAPSHOT_MARKER_NAME,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=directory_fd,
            )
            created = True
            opened = os.fstat(descriptor)
            opened_identity = (opened.st_dev, opened.st_ino, opened.st_uid)
            write_all_bytes(descriptor, payload, "config snapshot marker")
            os.fchmod(descriptor, 0o400)
            os.fsync(descriptor)
            completed = True
            return len(payload)
        except OSError as error:
            raise EditorError(
                f"could not create config snapshot marker: {error}"
            ) from error
    finally:
        primary = sys.exc_info()[1] if not completed else None
        cleanup_failure = close_created_file(
            descriptor,
            directory_fd,
            CONFIG_SNAPSHOT_MARKER_NAME,
            opened_identity,
            created and not completed,
        )
        finish_cleanup(
            primary,
            "config snapshot marker cleanup failed",
            cleanup_failure,
        )


def read_snapshot_file_at(
    directory_fd: int, name: str, expected_mode: int, maximum: int
) -> bytes:
    """Read one exact frozen snapshot file through its pinned parent."""
    name = private_basename(name)
    descriptor: int | None = None
    try:
        before = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        descriptor = os.open(
            name,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=directory_fd,
        )
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.getuid()
            or stat.S_IMODE(before.st_mode) != expected_mode
            or before.st_nlink != 1
            or before.st_size > maximum
            or file_identity(before) != file_identity(opened)
        ):
            fail(f"config snapshot file is unsafe or changed: {name}")
        chunks: list[bytes] = []
        total = 0
        while total <= maximum:
            chunk = os.read(descriptor, min(64 * 1024, maximum + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        payload = b"".join(chunks)
        after = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if len(payload) != opened.st_size or file_identity(after) != file_identity(
            opened
        ):
            fail(f"config snapshot file changed while reading: {name}")
        return payload
    except OSError as error:
        raise EditorError(
            f"could not read config snapshot file {name}: {error}"
        ) from error
    finally:
        if descriptor is not None:
            os.close(descriptor)


def validate_frozen_snapshot_directory(directory_fd: int) -> None:
    """Require one pinned snapshot directory to remain owner-read-only."""
    details = os.fstat(directory_fd)
    if (
        not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o500
    ):
        fail("config snapshot contains an unsafe directory")


def merge_snapshot_totals(
    totals: SnapshotTotals, nested: SnapshotTotals
) -> SnapshotTotals:
    """Merge bounded totals from one validated child directory."""
    merged = SnapshotTotals(
        totals.files + nested.files,
        totals.size + nested.size,
        totals.directories + nested.directories + 1,
    )
    if merged.files > MAX_CONFIG_SNAPSHOT_FILES:
        fail("Neovim config snapshot exceeds its file-count limit")
    if merged.size > MAX_CONFIG_SNAPSHOT_BYTES:
        fail("Neovim config snapshot exceeds its byte-size limit")
    if merged.directories > MAX_CONFIG_SNAPSHOT_DIRECTORIES:
        fail("Neovim config snapshot exceeds its directory-count limit")
    return merged


def validate_snapshot_regular_file(
    directory_fd: int,
    name: str,
    details: os.stat_result,
    marker: str,
    depth: int,
    totals: SnapshotTotals,
) -> SnapshotTotals:
    """Validate and account for one frozen regular snapshot file."""
    if (
        not stat.S_ISREG(details.st_mode)
        or details.st_uid != os.getuid()
        or details.st_nlink != 1
        or stat.S_IMODE(details.st_mode) not in {0o400, 0o500}
    ):
        fail(f"config snapshot contains an unsafe file: {name}")
    updated = bounded_snapshot_totals(totals, details.st_size)
    if depth == 0 and name == CONFIG_SNAPSHOT_MARKER_NAME:
        expected_payload = f"{marker}\n".encode()
        if read_snapshot_file_at(directory_fd, name, 0o400, 256) != expected_payload:
            fail("config snapshot marker does not match its lifecycle")
    return updated


def validate_snapshot_child_directory(
    directory_fd: int,
    name: str,
    details: os.stat_result,
    marker: str,
    depth: int,
    totals: SnapshotTotals,
) -> SnapshotTotals:
    """Open, validate, and account for one snapshot child directory."""
    if details.st_uid != os.getuid() or stat.S_IMODE(details.st_mode) != 0o500:
        fail(f"config snapshot contains an unsafe directory: {name}")
    expected = directory_identity(details)
    child_fd, opened = open_snapshot_directory_at(directory_fd, name)
    if child_fd is None:
        fail(f"config snapshot directory changed while opening: {name}")
    try:
        if opened != expected:
            fail(f"config snapshot directory changed while opening: {name}")
        nested = validate_config_snapshot_tree(child_fd, marker, depth + 1)
    finally:
        with contextlib.suppress(OSError):
            os.close(child_fd)
    return merge_snapshot_totals(totals, nested)


def validate_config_snapshot_tree(
    directory_fd: int,
    marker: str,
    depth: int = 0,
) -> SnapshotTotals:
    """Revalidate one complete frozen snapshot without following links."""
    if depth > MAX_CONFIG_SNAPSHOT_DEPTH:
        fail("Neovim config snapshot exceeds its directory-depth limit")
    validate_frozen_snapshot_directory(directory_fd)
    names = bounded_directory_names(directory_fd, "Neovim config snapshot")
    if depth == 0:
        required = set(CONFIG_SNAPSHOT_REQUIRED) | {CONFIG_SNAPSHOT_MARKER_NAME}
        allowed = required | set(CONFIG_SNAPSHOT_OPTIONAL)
        if not required.issubset(names) or any(name not in allowed for name in names):
            fail("config snapshot runtime closure is incomplete or contains extras")
    totals = SnapshotTotals(0, 0)
    for name in names:
        try:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        except OSError as error:
            raise EditorError(
                f"could not inspect config snapshot entry {name}: {error}"
            ) from error
        if stat.S_ISDIR(child.st_mode) and not stat.S_ISLNK(child.st_mode):
            totals = validate_snapshot_child_directory(
                directory_fd, name, child, marker, depth, totals
            )
        else:
            totals = validate_snapshot_regular_file(
                directory_fd, name, child, marker, depth, totals
            )
    return totals


def open_snapshot_directory_at(
    parent_fd: int, name: str
) -> tuple[int, DirectoryIdentity] | tuple[None, None]:
    """Open one existing owner directory without following its basename."""
    name = private_basename(name)
    try:
        lexical = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None, None
    except OSError as error:
        raise EditorError(
            f"could not inspect config snapshot {name}: {error}"
        ) from error
    if (
        not stat.S_ISDIR(lexical.st_mode)
        or stat.S_ISLNK(lexical.st_mode)
        or lexical.st_uid != os.getuid()
    ):
        fail(f"config snapshot {name} is not an owner-controlled real directory")
    descriptor: int | None = None
    retained = False
    try:
        descriptor = os.open(name, directory_flags(), dir_fd=parent_fd)
        opened = os.fstat(descriptor)
        expected = directory_identity(lexical)
        if directory_identity(opened) != expected:
            fail(f"config snapshot {name} changed while opening")
        retained = True
        return descriptor, expected
    except OSError as error:
        raise EditorError(f"could not open config snapshot {name}: {error}") from error
    finally:
        if descriptor is not None and not retained:
            with contextlib.suppress(OSError):
                os.close(descriptor)


def clear_snapshot_directory(descriptor: int, depth: int = 0) -> None:
    """Recursively clear a pinned private tree without following child links."""
    if depth > MAX_CONFIG_SNAPSHOT_DEPTH + 1:
        fail("config snapshot cleanup exceeds its directory-depth limit")
    details = os.fstat(descriptor)
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.getuid():
        fail("config snapshot cleanup directory is unsafe")
    try:
        os.fchmod(descriptor, 0o700)
        names = bounded_directory_names(descriptor, "config snapshot cleanup")
        for name in names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if stat.S_ISDIR(child.st_mode) and not stat.S_ISLNK(child.st_mode):
                child_fd, expected = open_snapshot_directory_at(descriptor, name)
                if child_fd is None or expected is None:
                    fail(f"config snapshot child disappeared during cleanup: {name}")
                try:
                    clear_snapshot_directory(child_fd, depth + 1)
                    current = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
                    if directory_identity(current) != expected:
                        fail(f"config snapshot child changed during cleanup: {name}")
                finally:
                    with contextlib.suppress(OSError):
                        os.close(child_fd)
                os.rmdir(name, dir_fd=descriptor)
            else:
                if stat.S_ISREG(child.st_mode) and child.st_nlink != 1:
                    fail(
                        f"config snapshot contains a hard-linked cleanup entry: {name}"
                    )
                os.unlink(name, dir_fd=descriptor)
        os.fsync(descriptor)
    except OSError as error:
        raise EditorError(f"could not clear config snapshot: {error}") from error


def recover_interrupted_snapshot_removal(
    parent_fd: int,
    name: str,
    reservation: str,
    reserve: str | None,
    descriptor: int | None,
    clearing_started: bool,
) -> BaseException | None:
    """Finish a partial deletion or restore an untouched reservation."""
    candidate = reserve or reservation
    try:
        if clearing_started and descriptor is not None:
            if entry_exists_at(parent_fd, candidate):
                clear_snapshot_directory(descriptor)
                os.rmdir(candidate, dir_fd=parent_fd)
        else:
            restore_reserved_on_failure(
                parent_fd,
                candidate,
                name,
                "config snapshot reservation restoration failed",
            )
    except (EditorError, OSError) as cleanup:
        return cleanup
    return None


def remove_snapshot_entry_at(
    parent_fd: int,
    name: str,
    expected: DirectoryIdentity | None = None,
) -> bool:
    """Idempotently retire one exact private snapshot directory."""
    name = private_basename(name)
    reservation = retirement_reservation_name(name)
    descriptor: int | None = None
    current: DirectoryIdentity | None = None
    reserve: str | None = None
    clearing_started = False
    completed = False
    try:
        descriptor, current = open_snapshot_directory_at(parent_fd, name)
        if descriptor is None or current is None:
            completed = True
            return False
        if expected is not None and current != expected:
            fail(f"config snapshot identity changed before cleanup: {name}")
        reserve = reserve_private_entry_at(parent_fd, name, reservation)
        if reserve is None:
            completed = True
            return False
        try:
            reserved = os.stat(reserve, dir_fd=parent_fd, follow_symlinks=False)
            if directory_identity(reserved) != current:
                fail(f"config snapshot changed during cleanup: {name}")
            clearing_started = True
            clear_snapshot_directory(descriptor)
            os.rmdir(reserve, dir_fd=parent_fd)
            completed = True
        except OSError as error:
            raise EditorError(
                f"could not remove config snapshot {name}: {error}"
            ) from error
    finally:
        primary = sys.exc_info()[1] if not completed else None
        cleanup_failure = None
        try:
            if not completed:
                cleanup_failure = recover_interrupted_snapshot_removal(
                    parent_fd,
                    name,
                    reservation,
                    reserve,
                    descriptor,
                    clearing_started,
                )
        finally:
            close_failure = close_descriptor_error(descriptor)
        cleanup_failure = cleanup_failure or close_failure
        finish_cleanup(primary, "config snapshot cleanup failed", cleanup_failure)
    try:
        fsync_directory(parent_fd, f"config snapshot removal {name}")
    except EditorError as warning:
        warn_nonfatal(f"warning: {warning}; snapshot removal was already committed")
    return True


def remove_claim_snapshot(
    spool: SpoolDirectories,
    claim_id: object,
    expected: DirectoryIdentity | None = None,
) -> bool:
    """Retire the claim-addressable config snapshot through the pinned spool."""
    return remove_snapshot_entry_at(spool.root_fd, snapshot_name(claim_id), expected)


def remove_snapshot_identity_at(
    parent_fd: int,
    names: Sequence[str],
    expected: DirectoryIdentity,
) -> bool:
    """Retire one exact snapshot identity from a bounded set of basenames."""
    matching: list[str] = []
    for candidate in names:
        candidate = private_basename(candidate)
        try:
            details = os.stat(candidate, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError as error:
            raise EditorError(
                f"could not inspect config snapshot cleanup candidate {candidate}: {error}"
            ) from error
        if stat.S_ISDIR(details.st_mode) and directory_identity(details) == expected:
            matching.append(candidate)
    if len(matching) > 1:
        fail("config snapshot identity is reachable through multiple basenames")
    if not matching:
        return False
    return remove_snapshot_entry_at(parent_fd, matching[0], expected)


def snapshot_cleanup_candidates(parent_fd: int, name: str) -> tuple[str, ...]:
    """Return every bounded spool basename for exact-identity cleanup."""
    name = private_basename(name)
    candidates = bounded_directory_names(parent_fd, "config snapshot spool")
    if name not in candidates:
        candidates.insert(0, name)
    return tuple(candidates)


def freeze_config_snapshot_contents(
    descriptor: int, snapshot_source: pathlib.Path
) -> tuple[str, SnapshotTotals]:
    """Copy, double-check, mark, and freeze one runtime closure."""
    totals = populate_or_validate_config_snapshot(snapshot_source, descriptor)
    if populate_or_validate_config_snapshot(snapshot_source) != totals:
        fail("Neovim config snapshot source changed across validation passes")
    marker = secrets.token_urlsafe(32)
    marker_size = create_snapshot_marker_at(descriptor, marker)
    frozen_totals = SnapshotTotals(
        totals.files + 1,
        totals.size + marker_size,
        totals.directories,
    )
    if frozen_totals.files > MAX_CONFIG_SNAPSHOT_FILES:
        fail("Neovim config snapshot exceeds its file-count limit")
    if frozen_totals.size > MAX_CONFIG_SNAPSHOT_BYTES:
        fail("Neovim config snapshot exceeds its byte-size limit")
    os.fchmod(descriptor, 0o500)
    os.fsync(descriptor)
    if validate_config_snapshot_tree(descriptor, marker) != frozen_totals:
        fail("config snapshot changed during its whole-closure validation")
    return marker, frozen_totals


def publish_config_snapshot_directory(
    spool: SpoolDirectories,
    staging: str,
    name: str,
    claim_id: object,
    identity: DirectoryIdentity,
) -> None:
    """Publish one frozen directory without clobbering and verify its identity."""
    if not exclusive_rename_at(spool.root_fd, staging, name):
        fail(f"config snapshot already exists for lifecycle claim: {claim_id}")
    lexical = os.stat(name, dir_fd=spool.root_fd, follow_symlinks=False)
    if directory_identity(lexical) != identity:
        fail("config snapshot changed during publication")
    try:
        fsync_directory(spool.root_fd, f"config snapshot publication {name}")
    except EditorError as warning:
        warn_nonfatal(f"warning: {warning}; snapshot publication was already committed")


def cleanup_unfinished_config_snapshot(
    spool: SpoolDirectories,
    descriptor: int,
    identity: DirectoryIdentity | None,
    name: str,
    staging: str,
) -> BaseException | None:
    """Remove an unpublished or commit-then-failed snapshot and close its FD."""
    cleanup_failure: BaseException | None = None
    try:
        try:
            cleanup_identity = identity or directory_identity(os.fstat(descriptor))
            remove_snapshot_identity_at(
                spool.root_fd,
                (name, staging),
                cleanup_identity,
            )
        except (EditorError, OSError) as cleanup:
            cleanup_failure = cleanup
    finally:
        close_failure = close_descriptor_error(descriptor)
    return cleanup_failure or close_failure


def create_config_snapshot(
    spool: SpoolDirectories,
    claim_id: object,
    source: pathlib.Path | None = None,
    snapshot_handoff: list[ConfigSnapshot] | None = None,
) -> ConfigSnapshot:
    """Copy and publish one bounded, non-writable runtime snapshot."""
    name = snapshot_name(claim_id)
    staging = f".{name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    descriptor: int | None = None
    identity: DirectoryIdentity | None = None
    published = False
    completed = False
    try:
        try:
            descriptor = create_snapshot_directory_at(spool.root_fd, staging)
            identity = directory_identity(os.fstat(descriptor))
            snapshot_source = source or CONFIG_ROOT
            marker, frozen_totals = freeze_config_snapshot_contents(
                descriptor, snapshot_source
            )
            publish_config_snapshot_directory(
                spool,
                staging,
                name,
                claim_id,
                identity,
            )
            published = True
            snapshot = ConfigSnapshot(
                name,
                spool.root / name,
                descriptor,
                identity,
                marker,
                frozen_totals,
            )
            if snapshot_handoff is not None:
                snapshot_handoff.append(snapshot)
            completed = True
            return snapshot
        except OSError as error:
            raise EditorError(f"could not prepare config snapshot: {error}") from error
    finally:
        primary = sys.exc_info()[1]
        if descriptor is not None and not completed:
            cleanup_failure = cleanup_unfinished_config_snapshot(
                spool,
                descriptor,
                identity,
                name if published else staging,
                staging if published else name,
            )
            finish_cleanup(
                primary,
                "config snapshot preparation cleanup failed",
                cleanup_failure,
            )


def revalidate_config_snapshot(
    spool: SpoolDirectories, snapshot: ConfigSnapshot
) -> None:
    """Require the mounted basename to retain the complete pinned snapshot."""
    if snapshot.path != spool.root / snapshot.name:
        fail("config snapshot path does not match its pinned spool")
    try:
        lexical = os.stat(
            snapshot.name,
            dir_fd=spool.root_fd,
            follow_symlinks=False,
        )
        opened = os.fstat(snapshot.descriptor)
    except OSError as error:
        raise EditorError(f"could not revalidate config snapshot: {error}") from error
    if (
        not stat.S_ISDIR(lexical.st_mode)
        or stat.S_ISLNK(lexical.st_mode)
        or stat.S_IMODE(lexical.st_mode) != 0o500
        or stat.S_IMODE(opened.st_mode) != 0o500
        or directory_identity(lexical) != snapshot.identity
        or directory_identity(opened) != snapshot.identity
    ):
        fail("config snapshot path no longer names its pinned directory")
    if (
        validate_config_snapshot_tree(snapshot.descriptor, snapshot.marker)
        != snapshot.totals
    ):
        fail("config snapshot changed after publication")
    try:
        final_lexical = os.stat(
            snapshot.name,
            dir_fd=spool.root_fd,
            follow_symlinks=False,
        )
        final_opened = os.fstat(snapshot.descriptor)
    except OSError as error:
        raise EditorError(
            f"could not complete config snapshot revalidation: {error}"
        ) from error
    if (
        not stat.S_ISDIR(final_lexical.st_mode)
        or stat.S_ISLNK(final_lexical.st_mode)
        or stat.S_IMODE(final_lexical.st_mode) != 0o500
        or stat.S_IMODE(final_opened.st_mode) != 0o500
        or directory_identity(final_lexical) != snapshot.identity
        or directory_identity(final_opened) != snapshot.identity
    ):
        fail("config snapshot path changed during whole-closure validation")


def snapshot_lease_name(root: pathlib.Path) -> str:
    """Return the non-record host-only lease basename for one repository."""
    return f"{workspace_id(root)}.snapshot"


def snapshot_lease_value(
    root: pathlib.Path, claim_id: object, snapshot: ConfigSnapshot
) -> dict[str, object]:
    """Serialize the closed cleanup authority for one exact snapshot."""
    claim = canonical_uuid4(claim_id, "lifecycle claim id")
    if snapshot.name != snapshot_name(claim):
        fail("config snapshot does not match its lifecycle claim")
    identity = snapshot.identity
    return {
        "version": SNAPSHOT_LEASE_VERSION,
        "host_root": str(root),
        "claim_id": claim,
        "snapshot_name": snapshot.name,
        "device": identity.device,
        "inode": identity.inode,
        "owner": identity.owner,
        "marker": snapshot.marker,
    }


def load_snapshot_lease(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    claim_id: object,
    expected: DirectoryIdentity | None = None,
) -> SnapshotLease | None:
    """Load host-only cleanup authority and bind it to the current artifact."""
    claim = canonical_uuid4(claim_id, "lifecycle claim id")
    state = pinned_state(paths)
    state_name = snapshot_lease_name(root)
    artifact_name = snapshot_name(claim)
    if not entry_exists_at(state.descriptor("workspaces"), state_name):
        if entry_exists_at(spool.root_fd, artifact_name):
            fail("config snapshot exists without host-only cleanup authority")
        return None
    payload, state_identity = read_private_snapshot_at(
        state.descriptor("workspaces"),
        state_name,
        "config snapshot lease",
    )
    value = decode_json_object(payload, "config snapshot lease")
    if set(value) != SNAPSHOT_LEASE_KEYS:
        fail("config snapshot lease schema is invalid")
    numbers = tuple(value.get(field) for field in ("device", "inode", "owner"))
    if (
        value.get("version") != SNAPSHOT_LEASE_VERSION
        or value.get("host_root") != str(root)
        or value.get("claim_id") != claim
        or value.get("snapshot_name") != artifact_name
        or not valid_snapshot_marker(value.get("marker"))
        or any(type(number) is not int or number < 0 for number in numbers)
        or numbers[2] != os.getuid()
    ):
        fail("config snapshot lease identity is invalid")
    snapshot_identity = DirectoryIdentity(*numbers)
    if expected is not None and snapshot_identity != expected:
        fail("config snapshot lease does not match the live snapshot identity")
    descriptor, current = open_snapshot_directory_at(spool.root_fd, artifact_name)
    if descriptor is not None:
        try:
            if current != snapshot_identity:
                fail("config snapshot identity changed before lease use")
            marker_payload = read_snapshot_file_at(
                descriptor,
                CONFIG_SNAPSHOT_MARKER_NAME,
                0o400,
                256,
            )
            if marker_payload != f"{value['marker']}\n".encode():
                fail("config snapshot marker does not match its host-only lease")
        finally:
            os.close(descriptor)
    return SnapshotLease(
        state_name,
        state_identity,
        artifact_name,
        snapshot_identity,
        str(value["marker"]),
    )


def publish_snapshot_lease(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    claim_id: object,
    snapshot: ConfigSnapshot,
    lease_handoff: list[SnapshotLease] | None = None,
) -> SnapshotLease:
    """Publish and re-read one no-clobber host-only snapshot lease."""
    state = pinned_state(paths)
    state_name = snapshot_lease_name(root)
    value = snapshot_lease_value(root, claim_id, snapshot)
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    identity_handoff: list[FileIdentity] = []
    completed = False
    try:
        published_identity = atomic_create_bytes_at(
            state.descriptor("workspaces"),
            state_name,
            payload,
            identity_handoff=identity_handoff,
        )
        lease = load_snapshot_lease(paths, spool, root, claim_id, snapshot.identity)
        if lease is None or lease.state_identity != published_identity:
            fail("config snapshot lease changed after publication")
        if lease_handoff is not None:
            lease_handoff.append(lease)
        completed = True
        return lease
    finally:
        if not completed:
            primary = sys.exc_info()[1]
            cleanup_failure: BaseException | None = None
            cleanup_identity = identity_handoff[0] if identity_handoff else None
            try:
                if cleanup_identity is not None:
                    remove_file_identity_at(
                        state.descriptor("workspaces"),
                        (state_name,),
                        cleanup_identity,
                    )
            except (EditorError, OSError) as cleanup:
                cleanup_failure = cleanup
            if lease_handoff is not None:
                lease_handoff.clear()
            if cleanup_failure is not None:
                if primary is None:
                    raise cleanup_failure
                report_cleanup_failure(
                    primary,
                    "config snapshot lease rollback failed",
                    cleanup_failure,
                )


def retire_snapshot_lease(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    lease: SnapshotLease,
) -> bool:
    """Retire only the snapshot and sidecar identities previously validated."""
    removed = remove_snapshot_identity_at(
        spool.root_fd,
        snapshot_cleanup_candidates(spool.root_fd, lease.snapshot_name),
        lease.snapshot_identity,
    )
    state = pinned_state(paths)
    if not unlink_regular_at(
        state.descriptor("workspaces"),
        lease.state_name,
        durable=True,
        expected=lease.state_identity,
    ):
        fail("config snapshot lease disappeared before retirement")
    return removed


def retire_claim_snapshot(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    claim_id: object,
    expected: DirectoryIdentity | None = None,
) -> bool:
    """Conditionally retire a claim snapshot through host-only authority."""
    lease = load_snapshot_lease(paths, spool, root, claim_id, expected)
    if lease is None:
        return False
    return retire_snapshot_lease(paths, spool, root, lease)


@contextlib.contextmanager
def lifecycle_config_snapshot(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    claim_id: object,
) -> Iterator[ConfigSnapshot]:
    """Own one leased snapshot and clean it for every control-flow exit."""
    snapshot: ConfigSnapshot | None = None
    snapshot_handoff: list[ConfigSnapshot] = []
    lease: SnapshotLease | None = None
    lease_handoff: list[SnapshotLease] = []
    try:
        snapshot = create_config_snapshot(
            spool,
            claim_id,
            snapshot_handoff=snapshot_handoff,
        )
        lease = publish_snapshot_lease(
            paths,
            spool,
            root,
            claim_id,
            snapshot,
            lease_handoff,
        )
        yield snapshot
    finally:
        primary = sys.exc_info()[1]
        cleanup_snapshot = snapshot or (
            snapshot_handoff[0] if snapshot_handoff else None
        )
        if cleanup_snapshot is not None:
            cleanup_failure: BaseException | None = None
            try:
                cleanup_lease = lease or (lease_handoff[0] if lease_handoff else None)
                if cleanup_lease is not None:
                    retire_snapshot_lease(
                        paths,
                        spool,
                        root,
                        cleanup_lease,
                    )
                else:
                    remove_snapshot_identity_at(
                        spool.root_fd,
                        snapshot_cleanup_candidates(
                            spool.root_fd, cleanup_snapshot.name
                        ),
                        cleanup_snapshot.identity,
                    )
            except (EditorError, OSError) as cleanup:
                cleanup_failure = cleanup
            finally:
                with contextlib.suppress(OSError):
                    os.close(cleanup_snapshot.descriptor)
            if cleanup_failure is not None:
                if primary is None:
                    raise cleanup_failure
                report_cleanup_failure(
                    primary,
                    "config snapshot cleanup failed",
                    cleanup_failure,
                )


def atomic_bytes(
    path: pathlib.Path,
    payload: bytes,
    maximum: int = MAX_JSON_BYTES,
) -> None:
    """Atomically write owner-only bytes through one pinned parent.

    :param path: Destination file.
    :param payload: Bounded payload bytes.
    """
    descriptor = open_existing_directory_path(
        path.parent, f"private parent for {path.name}"
    )
    try:
        atomic_replace_bytes_at(descriptor, path.name, payload, maximum)
    finally:
        os.close(descriptor)


def atomic_json(path: pathlib.Path, value: Mapping[str, object]) -> None:
    """Atomically serialize one owner-only JSON object."""
    atomic_bytes(
        path, (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    )


def write_descriptor(descriptor: int, payload: bytes) -> None:
    """Write and fsync one already-created private file descriptor."""
    with os.fdopen(descriptor, "wb", closefd=True) as stream:
        stream.write(payload)
        stream.flush()
        os.fchmod(stream.fileno(), 0o600)
        os.fsync(stream.fileno())


def create_temporary_at(
    directory_fd: int,
    name: str,
    payload: bytes,
    *,
    temporary_name: str | None = None,
) -> str:
    """Persist one private temporary file in a pinned directory."""
    name = private_basename(name)
    temporary = private_basename(
        temporary_name or f".{name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    )
    descriptor: int | None = None
    created = False
    completed = False
    opened_identity: tuple[int, int, int] | None = None
    try:
        try:
            descriptor = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=directory_fd,
            )
            created = True
            opened = os.fstat(descriptor)
            opened_identity = (opened.st_dev, opened.st_ino, opened.st_uid)
            write_all_bytes(descriptor, payload, "private temporary file")
            os.fchmod(descriptor, 0o600)
            os.fsync(descriptor)
            completed = True
            return temporary
        except OSError as error:
            raise EditorError(
                f"could not persist private temporary file: {error}"
            ) from error
    finally:
        primary = sys.exc_info()[1] if not completed else None
        cleanup_failure = close_created_file(
            descriptor,
            directory_fd,
            temporary,
            opened_identity,
            created and not completed,
        )
        finish_cleanup(primary, "private temporary cleanup failed", cleanup_failure)


def atomic_replace_bytes_at(
    directory_fd: int,
    name: str,
    payload: bytes,
    maximum: int = MAX_JSON_BYTES,
) -> FileIdentity:
    """Replace one private basename and return its committed identity."""
    name = private_basename(name)
    if len(payload) > maximum:
        fail("private payload exceeds its size limit")
    try:
        existing = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        existing = None
    except OSError as error:
        raise EditorError(
            f"could not inspect private target {name}: {error}"
        ) from error
    if existing is not None:
        validate_private_file(existing, f"private target {name}", maximum)
    temporary = create_temporary_at(directory_fd, name, payload)
    committed = False
    try:
        prepared = os.stat(temporary, dir_fd=directory_fd, follow_symlinks=False)
        identity = validate_private_file(
            prepared, f"private temporary file {temporary}", maximum
        )
        os.replace(
            temporary,
            name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        committed = True
        persisted = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if file_identity(persisted) != identity:
            fail(f"private target changed after replacement: {name}")
        try:
            fsync_directory(directory_fd, f"private file {name}")
        except EditorError as warning:
            warn_nonfatal(f"warning: {warning}; replacement was already committed")
        return identity
    except OSError as error:
        raise EditorError(f"could not replace private file {name}: {error}") from error
    finally:
        if not committed:
            with contextlib.suppress(OSError):
                os.unlink(temporary, dir_fd=directory_fd)


def atomic_replace_json_at(
    directory_fd: int,
    name: str,
    value: Mapping[str, object],
) -> FileIdentity:
    """Replace one private JSON basename and return its committed identity."""
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    return atomic_replace_bytes_at(directory_fd, name, payload)


def remove_file_identity_at(
    directory_fd: int,
    names: Sequence[str],
    expected: FileIdentity,
    maximum: int = MAX_JSON_BYTES,
) -> bool:
    """Retire one exact private-file identity from bounded candidate names."""
    matching: list[str] = []
    for candidate in names:
        candidate = private_basename(candidate)
        try:
            details = os.stat(candidate, dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError as error:
            raise EditorError(
                f"could not inspect private cleanup candidate {candidate}: {error}"
            ) from error
        if file_identity(details) == expected:
            matching.append(candidate)
    if len(matching) > 1:
        fail("private file identity is reachable through multiple basenames")
    if not matching:
        return False
    return unlink_regular_at(
        directory_fd,
        matching[0],
        expected=expected,
        maximum=maximum,
    )


def cleanup_private_publication(
    directory_fd: int,
    name: str,
    temporary: str,
    identity: FileIdentity | None,
    maximum: int,
) -> BaseException | None:
    """Roll back only the file identity created by one failed publication."""
    try:
        cleanup_identity = identity
        if cleanup_identity is None:
            try:
                candidate = os.stat(
                    temporary,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
            except FileNotFoundError:
                candidate = None
            if candidate is not None:
                cleanup_identity = validate_private_file(
                    candidate,
                    f"private temporary file {temporary}",
                    maximum,
                )
        if cleanup_identity is not None:
            remove_file_identity_at(
                directory_fd,
                (name, temporary),
                cleanup_identity,
                maximum,
            )
    except (EditorError, OSError) as cleanup:
        return cleanup
    return None


def atomic_create_bytes_at(
    directory_fd: int,
    name: str,
    payload: bytes,
    maximum: int = MAX_JSON_BYTES,
    *,
    identity_handoff: list[FileIdentity] | None = None,
) -> FileIdentity:
    """Durably publish owner-only bytes by basename without clobbering."""
    name = private_basename(name)
    if len(payload) > maximum:
        fail("private payload exceeds its size limit")
    temporary = f".{name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    identity: FileIdentity | None = None
    committed = False
    completed = False
    try:
        try:
            create_temporary_at(
                directory_fd,
                name,
                payload,
                temporary_name=temporary,
            )
            prepared = os.stat(
                temporary,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
            identity = validate_private_file(
                prepared,
                f"private temporary file {temporary}",
                maximum,
            )
            committed = exclusive_rename_at(directory_fd, temporary, name)
        except (EditorError, FileNotFoundError) as error:
            raise EditorError(
                f"could not publish private file {name}: {error}"
            ) from error
        if not committed:
            fail(f"private message already exists: {name}")
        persisted = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if file_identity(persisted) != identity:
            fail(f"private target changed after publication: {name}")
        try:
            fsync_directory(directory_fd, f"private message {name}")
        except EditorError as warning:
            warn_nonfatal(f"warning: {warning}; publication was already committed")
        if identity_handoff is not None:
            identity_handoff.append(identity)
        completed = True
        return identity
    except OSError as error:
        raise EditorError(f"could not publish private file {name}: {error}") from error
    finally:
        if not completed:
            primary = sys.exc_info()[1]
            cleanup_failure = cleanup_private_publication(
                directory_fd,
                name,
                temporary,
                identity,
                maximum,
            )
            finish_cleanup(
                primary,
                "private publication cleanup failed",
                cleanup_failure,
            )


def atomic_create_json_at(
    directory_fd: int,
    name: str,
    value: Mapping[str, object],
) -> FileIdentity:
    """Durably publish one exact JSON message by basename."""
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    return atomic_create_bytes_at(directory_fd, name, payload)


def direct_create_bytes_at(directory_fd: int, name: str, payload: bytes) -> None:
    """Create one durable owner-only single-link file at its final basename."""
    name = private_basename(name)
    descriptor: int | None = None
    created = False
    created_identity: FileIdentity | None = None
    try:
        descriptor = os.open(
            name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=directory_fd,
        )
        created = True
        opened = os.fstat(descriptor)
        created_identity = validate_private_file(opened, "private authentication file")
        writer = descriptor
        descriptor = None
        write_descriptor(writer, payload)
        persisted = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(persisted.st_mode)
            or persisted.st_uid != os.getuid()
            or stat.S_IMODE(persisted.st_mode) != 0o600
            or persisted.st_nlink != 1
            or (persisted.st_dev, persisted.st_ino) != (opened.st_dev, opened.st_ino)
        ):
            fail("private authentication file changed while creating")
        fsync_directory(directory_fd, f"private authentication file {name}")
    except FileExistsError as error:
        raise EditorError(f"private message already exists: {name}") from error
    except OSError as error:
        raise EditorError(
            f"could not create private authentication file: {error}"
        ) from error
    except EditorError:
        raise
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if created and created_identity is not None and sys.exc_info()[0] is not None:
            try:
                unlink_regular_at(
                    directory_fd,
                    name,
                    durable=True,
                    expected=created_identity,
                )
            except EditorError as cleanup_error:
                warn_nonfatal(
                    f"warning: private authentication cleanup failed: {cleanup_error}"
                )


def read_private_json(path: pathlib.Path, label: str) -> dict[str, Any]:
    """Read one bounded owner-only regular JSON object with identity checks."""
    try:
        before = path.lstat()
    except OSError as error:
        raise EditorError(f"{label} is unavailable: {error}") from error
    if (
        not stat.S_ISREG(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_uid != os.getuid()
        or stat.S_IMODE(before.st_mode) != 0o600
        or before.st_nlink != 1
        or before.st_size > MAX_JSON_BYTES
    ):
        fail(f"{label} is unsafe or exceeds 64 KiB")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
        with os.fdopen(descriptor, "rb") as stream:
            opened = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(opened.st_mode)
                or opened.st_uid != os.getuid()
                or stat.S_IMODE(opened.st_mode) != 0o600
                or opened.st_nlink != 1
                or (opened.st_dev, opened.st_ino, opened.st_size, opened.st_mode)
                != (
                    before.st_dev,
                    before.st_ino,
                    before.st_size,
                    before.st_mode,
                )
            ):
                fail(f"{label} changed while opening")
            payload = stream.read(MAX_JSON_BYTES + 1)
    except OSError as error:
        raise EditorError(f"could not read {label}: {error}") from error
    try:
        after = path.lstat()
    except OSError as error:
        raise EditorError(f"{label} changed while validating: {error}") from error
    if (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mode,
        after.st_nlink,
        after.st_uid,
    ) != (
        opened.st_dev,
        opened.st_ino,
        opened.st_size,
        opened.st_mode,
        opened.st_nlink,
        opened.st_uid,
    ):
        fail(f"{label} changed while validating")
    return decode_json_object(payload, label)


def decode_json_object(payload: bytes, label: str) -> dict[str, Any]:
    """Decode one bounded payload as an exact JSON object."""
    try:
        value = json.loads(payload)
    except (UnicodeError, json.JSONDecodeError, RecursionError) as error:
        raise EditorError(f"{label} is not valid JSON: {error}") from error
    if not isinstance(value, dict):
        fail(f"{label} must contain one JSON object")
    return value


def read_private_snapshot_at(
    directory_fd: int,
    name: str,
    label: str,
) -> tuple[bytes, FileIdentity]:
    """Read exact private bytes and return their descriptor-bound identity."""
    name = private_basename(name)
    try:
        before = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except OSError as error:
        raise EditorError(f"{label} is unavailable: {error}") from error
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.getuid()
        or stat.S_IMODE(before.st_mode) != 0o600
        or before.st_nlink != 1
        or before.st_size > MAX_JSON_BYTES
    ):
        fail(f"{label} is unsafe or exceeds 64 KiB")
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=directory_fd,
        )
        with os.fdopen(descriptor, "rb") as stream:
            opened = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(opened.st_mode)
                or opened.st_uid != os.getuid()
                or stat.S_IMODE(opened.st_mode) != 0o600
                or opened.st_nlink != 1
                or (opened.st_dev, opened.st_ino, opened.st_size, opened.st_mode)
                != (
                    before.st_dev,
                    before.st_ino,
                    before.st_size,
                    before.st_mode,
                )
            ):
                fail(f"{label} changed while opening")
            payload = stream.read(MAX_JSON_BYTES + 1)
            if len(payload) != opened.st_size:
                fail(f"{label} changed while reading")
    except OSError as error:
        raise EditorError(f"could not read {label}: {error}") from error
    try:
        after = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except OSError as error:
        raise EditorError(f"{label} changed while validating: {error}") from error
    if (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mode,
        after.st_nlink,
        after.st_uid,
    ) != (
        opened.st_dev,
        opened.st_ino,
        opened.st_size,
        opened.st_mode,
        opened.st_nlink,
        opened.st_uid,
    ):
        fail(f"{label} changed while validating")
    return payload, file_identity(opened)


def read_private_json_snapshot_at(
    directory_fd: int,
    name: str,
    label: str,
) -> tuple[dict[str, Any], FileIdentity]:
    """Read and decode one private JSON snapshot with its exact identity."""
    payload, identity = read_private_snapshot_at(directory_fd, name, label)
    return decode_json_object(payload, label), identity


def read_private_json_at(directory_fd: int, name: str, label: str) -> dict[str, Any]:
    """Read one bounded owner-only JSON basename from a pinned directory."""
    value, _ = read_private_json_snapshot_at(directory_fd, name, label)
    return value


def utc_now() -> str:
    """Return a stable UTC protocol timestamp."""
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def recent_timestamp(value: object, now: dt.datetime | None = None) -> bool:
    """Return whether a protocol timestamp is within the bounded replay window."""
    if not isinstance(value, str):
        return False
    try:
        parsed = dt.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=dt.timezone.utc
        )
    except ValueError:
        return False
    current = now or dt.datetime.now(dt.timezone.utc)
    age = (current - parsed).total_seconds()
    return -300 <= age <= 600


def canonical_uuid4(value: object, label: str) -> str:
    """Validate and return one lowercase canonical RFC 4122 UUIDv4."""
    if not isinstance(value, str):
        fail(f"{label} is invalid")
    try:
        parsed = uuid.UUID(value)
    except (ValueError, TypeError, AttributeError) as error:
        raise EditorError(f"{label} is invalid") from error
    if parsed.version != 4 or parsed.variant != uuid.RFC_4122 or str(parsed) != value:
        fail(f"{label} is not one canonical UUIDv4")
    return value


def canonical_request_id(value: object) -> str:
    """Validate one exact spool request UUIDv4."""
    return canonical_uuid4(value, "spool request id")


def message_scalar(value: object) -> str:
    """Project one protocol scalar into its language-neutral signed form."""
    if value is None:
        return ""
    if value is True:
        return "1"
    if value is False:
        return "0"
    if isinstance(value, (str, int)) and not isinstance(value, bool):
        return str(value)
    fail("authenticated message contains an invalid scalar")


def message_payload(kind: str, value: Mapping[str, object]) -> bytes:
    """Build one deterministic length-prefixed authentication payload."""
    fields = MESSAGE_FIELDS.get(kind)
    if fields is None:
        fail("authenticated message kind is invalid")
    parts = [kind.encode()]
    for field in fields:
        encoded = message_scalar(value.get(field)).encode("utf-8")
        parts.append(str(len(encoded)).encode("ascii") + b":" + encoded)
    return b"|".join(parts)


def message_auth(token: str, kind: str, value: Mapping[str, object]) -> str:
    """Return one HMAC-SHA256 over the exact protocol projection."""
    return hmac.new(
        token.encode("utf-8"), message_payload(kind, value), hashlib.sha256
    ).hexdigest()


def signed_message(
    token: str, kind: str, value: Mapping[str, object]
) -> dict[str, object]:
    """Copy and authenticate one protocol message without exposing the secret."""
    result = dict(value)
    result["auth"] = message_auth(token, kind, result)
    return result


def valid_message_auth(token: str, kind: str, value: Mapping[str, object]) -> bool:
    """Constant-time validate one exact protocol message authentication code."""
    supplied = value.get("auth")
    return isinstance(supplied, str) and hmac.compare_digest(
        supplied, message_auth(token, kind, value)
    )


def pid_alive(pid: object) -> bool:
    """Return whether a positive process identifier is still live."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid < 1:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def valid_tmux_pane(value: object) -> bool:
    """Return whether a value is one exact tmux pane identifier."""
    return (
        isinstance(value, str)
        and len(value) >= 2
        and value[0] == "%"
        and value[1:].isdigit()
        and "\n" not in value
        and "\r" not in value
        and "\0" not in value
    )


def canonical_posix_absolute(value: object) -> bool:
    """Return whether a path is absolute and lexically normalized for POSIX."""
    return (
        isinstance(value, str)
        and value.startswith("/")
        and not value.startswith("//")
        and "\0" not in value
        and posixpath.normpath(value) == value
    )


def canonical_root(value: str | os.PathLike[str]) -> pathlib.Path:
    """Resolve one canonical existing directory."""
    try:
        path = pathlib.Path(value).expanduser().resolve(strict=True)
    except OSError as error:
        raise EditorError(f"directory is unavailable: {error}") from error
    if not path.is_dir():
        fail(f"path is not a directory: {path}")
    return path


def run(
    argv: Sequence[str],
    *,
    cwd: pathlib.Path | None = None,
    env: Mapping[str, str] | None = None,
    timeout: float = DEFAULT_TIMEOUT_SECONDS,
    check: bool = True,
) -> subprocess.CompletedProcess[bytes]:
    """Run one bounded argv command without a shell."""
    try:
        result = subprocess.run(
            list(argv),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            cwd=cwd,
            env=dict(env) if env is not None else None,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise EditorError(f"could not run {argv[0]}: {error}") from error
    except KeyboardInterrupt as error:
        raise EditorError(f"{argv[0]} was cancelled") from error
    if check and result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip()
        fail(detail or f"{argv[0]} exited {result.returncode}")
    return result


def retain_bounded_tail(captured: bytearray, payload: bytes, maximum: int) -> None:
    """Retain only the newest ``maximum`` bytes from one drained stream."""
    if len(payload) >= maximum:
        captured[:] = payload[-maximum:]
        return
    captured.extend(payload)
    if len(captured) > maximum:
        del captured[: len(captured) - maximum]


def drain_bounded_capture(
    process: subprocess.Popen[bytes],
    timeout: float,
    stdout_limit: int,
    stderr_limit: int,
) -> tuple[bytes, bytes, bool]:
    """Drain both command pipes while retaining bounded output projections."""
    if process.stdout is None or process.stderr is None:
        fail("bounded command did not expose output pipes")
    stdout = bytearray()
    stderr = bytearray()
    stdout_overflow = False
    deadline = time.monotonic() + timeout
    with selectors.DefaultSelector() as selector:
        for stream, label in ((process.stdout, "stdout"), (process.stderr, "stderr")):
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, label)
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(process.args, timeout)
            events = selector.select(min(remaining, 0.1))
            for key, _mask in events:
                stream = key.fileobj
                try:
                    payload = os.read(stream.fileno(), STREAM_CHUNK_BYTES)
                except BlockingIOError:
                    continue
                if not payload:
                    close_process_stream(selector, stream)
                elif key.data == "stdout":
                    available = max(0, stdout_limit - len(stdout))
                    stdout.extend(payload[:available])
                    stdout_overflow = stdout_overflow or len(payload) > available
                else:
                    retain_bounded_tail(stderr, payload, stderr_limit)
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise subprocess.TimeoutExpired(process.args, timeout)
    process.wait(timeout=remaining)
    return bytes(stdout), bytes(stderr), stdout_overflow


def run_bounded_capture(
    argv: Sequence[str],
    *,
    timeout: float,
    stdout_limit: int,
    stderr_limit: int = MAX_COMMAND_STDERR_BYTES,
    env: Mapping[str, str] | None = None,
) -> tuple[subprocess.CompletedProcess[bytes], bool]:
    """Run one command while draining and retaining strictly bounded output."""
    if timeout <= 0 or stdout_limit < 1 or stderr_limit < 1:
        fail("bounded command limits are invalid")
    try:
        process = subprocess.Popen(
            list(argv),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=dict(env) if env is not None else None,
            close_fds=True,
            shell=False,
        )
    except OSError as error:
        raise EditorError(f"could not run {argv[0]}: {error}") from error
    try:
        stdout, stderr, overflow = drain_bounded_capture(
            process,
            timeout,
            stdout_limit,
            stderr_limit,
        )
    except subprocess.TimeoutExpired as error:
        raise EditorError(
            f"could not run {argv[0]}: timed out after {timeout:g} seconds"
        ) from error
    except KeyboardInterrupt as error:
        raise EditorError(f"{argv[0]} was cancelled") from error
    except OSError as error:
        raise EditorError(f"could not run {argv[0]}: {error}") from error
    finally:
        primary = sys.exc_info()[1]
        cleanup_error: EditorError | None = None
        try:
            stop_and_reap_process(process)
        except EditorError as cleanup:
            cleanup_error = cleanup
        finally:
            for stream in (process.stdout, process.stderr):
                if stream is not None and not stream.closed:
                    with contextlib.suppress(OSError):
                        stream.close()
        if cleanup_error is not None:
            if primary is None:
                raise cleanup_error
            report_cleanup_failure(
                primary,
                "bounded command cleanup failed",
                cleanup_error,
            )
    return (
        subprocess.CompletedProcess(list(argv), process.returncode, stdout, stderr),
        overflow,
    )


def repo_root(start: str | os.PathLike[str]) -> pathlib.Path:
    """Resolve one logical Git repository root."""
    directory = canonical_root(start)
    result = run(
        ["git", "-C", str(directory), "rev-parse", "--show-toplevel"],
        timeout=5.0,
    )
    try:
        value = result.stdout.decode("utf-8").strip()
    except UnicodeError as error:
        raise EditorError("git returned a non-UTF-8 repository root") from error
    return canonical_root(value)


def contained(root: pathlib.Path, path: pathlib.Path) -> bool:
    """Return whether a canonical path is contained by a canonical root."""
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True


def contained_file(root: pathlib.Path, value: str | os.PathLike[str]) -> pathlib.Path:
    """Resolve one regular non-symlink file contained by a repository."""
    candidate = pathlib.Path(value).expanduser()
    lexical = candidate if candidate.is_absolute() else root / candidate
    try:
        resolved = lexical.resolve(strict=True)
        mode = lexical.lstat().st_mode
    except OSError as error:
        raise EditorError(f"file is unavailable: {error}") from error
    if not contained(root, resolved) or not stat.S_ISREG(mode) or stat.S_ISLNK(mode):
        fail("file is not a contained regular non-symlink file")
    return resolved


def discover_config(root: pathlib.Path, requested: str | None) -> pathlib.Path:
    """Resolve an explicit or conventional Dev Container configuration."""
    if requested:
        return contained_file(root, requested)
    for relative in (".devcontainer/devcontainer.json", ".devcontainer.json"):
        candidate = root / relative
        if candidate.is_file() and not candidate.is_symlink():
            return candidate.resolve(strict=True)
    fail(f"no Dev Container configuration exists under {root}")


def workspace_id(root: pathlib.Path) -> str:
    """Return the stable host-root identity used for state files."""
    return hashlib.sha256(os.fsencode(root)).hexdigest()


def pinned_state(paths: Mapping[str, pathlib.Path]) -> StateDirectories:
    """Require the descriptor-owning state hierarchy used by CLI operations."""
    if not isinstance(paths, StateDirectories):
        fail("private state hierarchy is not pinned")
    return paths


def record_name(root: pathlib.Path) -> str:
    """Return one workspace record basename."""
    return f"{workspace_id(root)}.json"


def record_path(paths: Mapping[str, pathlib.Path], root: pathlib.Path) -> pathlib.Path:
    """Return the exact record path for one host repository."""
    return paths["workspaces"] / record_name(root)


def spool_path(paths: Mapping[str, pathlib.Path], root: pathlib.Path) -> pathlib.Path:
    """Return the exact authenticated spool root for one repository."""
    return paths["spool"] / workspace_id(root)


def auth_path(spool: pathlib.Path | SpoolDirectories) -> pathlib.Path:
    """Return the sole on-disk location allowed to contain the spool secret."""
    root = spool.root if isinstance(spool, SpoolDirectories) else spool
    return root / "auth.json"


def create_auth(spool: SpoolDirectories, token: str) -> None:
    """Create a private lifecycle authentication file without replacement."""
    if len(token) < 32 or "\0" in token:
        fail("spool authentication token is invalid")
    payload = (
        json.dumps(
            {"version": MESSAGE_VERSION, "token": token},
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    ).encode()
    direct_create_bytes_at(spool.root_fd, "auth.json", payload)


def read_auth(spool: SpoolDirectories) -> str:
    """Read the exact private authentication secret for one active spool."""
    value = read_private_json_at(spool.root_fd, "auth.json", "spool authentication")
    token = value.get("token")
    if set(value) != AUTH_KEYS or value.get("version") != MESSAGE_VERSION:
        fail("spool authentication schema is invalid")
    if not isinstance(token, str) or len(token) < 32 or "\0" in token:
        fail("spool authentication token is invalid")
    return token


def remove_auth(spool: SpoolDirectories) -> None:
    """Durably remove the active spool authentication secret if present."""
    unlink_regular_at(spool.root_fd, "auth.json", durable=True)


def log_path(paths: Mapping[str, pathlib.Path], root: pathlib.Path) -> pathlib.Path:
    """Return the bounded private lifecycle log path."""
    return paths["logs"] / f"{workspace_id(root)}.log"


def sanitize_log_text(value: str) -> str:
    """Remove terminal controls while retaining readable Unicode log text."""
    normalized = value.replace("\r\n", "\n").replace("\r", "\n")
    without_escapes = ANSI_ESCAPE_RE.sub("", normalized)
    return CONTROL_CHARACTER_RE.sub("", without_escapes)


def bounded_log_detail(value: str, maximum: int = MAX_LOG_EVENT_CHARS) -> str:
    """Bound one sanitized log projection without returning terminal controls."""
    sanitized = sanitize_log_text(value)
    if len(sanitized) <= maximum:
        return sanitized
    suffix = "... [event truncated]"
    return sanitized[: maximum - len(suffix)] + suffix


def utf8_tail(value: bytes, maximum: int) -> bytes:
    """Return a bounded tail beginning at a UTF-8 codepoint boundary."""
    tail = value[-maximum:]
    while tail and tail[0] & 0xC0 == 0x80:
        tail = tail[1:]
    return tail


class LifecycleLogWriter:
    """Own one pinned, private, incrementally bounded lifecycle log."""

    def __init__(self, path: pathlib.Path) -> None:
        """Open the exact log inode without following a link."""
        self.path = path
        self.parent_fd = open_directory_path(path.parent, "lifecycle log directory")
        self.name = private_basename(path.name)
        self.descriptor = -1
        created = False
        flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
        try:
            try:
                self.descriptor = os.open(
                    self.name,
                    flags | os.O_CREAT | os.O_EXCL,
                    0o600,
                    dir_fd=self.parent_fd,
                )
                created = True
            except FileExistsError:
                self.descriptor = os.open(
                    self.name,
                    flags,
                    dir_fd=self.parent_fd,
                )
            os.set_inheritable(self.descriptor, False)
            if created:
                os.fchmod(self.descriptor, 0o600)
            self._validate_identity()
            if created:
                fsync_directory(self.parent_fd, "lifecycle log directory")
        except EditorError:
            self.close()
            raise
        except OSError as error:
            self.close()
            raise EditorError(
                f"could not open private lifecycle log: {error}"
            ) from error

    # ``typing.Self`` is unavailable on the system Python 3.9 we support.
    def __enter__(self) -> LifecycleLogWriter:  # noqa: PYI034
        """Return this open writer."""
        return self

    def __exit__(
        self,
        _exception_type: type[BaseException] | None,
        _exception: BaseException | None,
        _traceback: object,
    ) -> None:
        """Close owned descriptors on every control-flow exit."""
        self.close()

    def close(self) -> None:
        """Close the pinned file and parent directory descriptors."""
        if self.descriptor >= 0:
            with contextlib.suppress(OSError):
                os.close(self.descriptor)
            self.descriptor = -1
        if self.parent_fd >= 0:
            with contextlib.suppress(OSError):
                os.close(self.parent_fd)
            self.parent_fd = -1

    def _validate_identity(self) -> os.stat_result:
        """Require the pathname to keep naming this exact safe log inode."""
        if self.descriptor < 0 or self.parent_fd < 0:
            fail("private lifecycle log writer is closed")
        try:
            opened = os.fstat(self.descriptor)
            lexical = os.stat(
                self.name,
                dir_fd=self.parent_fd,
                follow_symlinks=False,
            )
        except OSError as error:
            raise EditorError(
                f"could not inspect private lifecycle log: {error}"
            ) from error
        validate_private_file(opened, "private lifecycle log", MAX_LOG_BYTES)
        validate_private_file(lexical, "private lifecycle log", MAX_LOG_BYTES)
        if (opened.st_dev, opened.st_ino) != (lexical.st_dev, lexical.st_ino):
            fail("private lifecycle log changed while writing")
        return opened

    def append(self, message: str) -> None:
        """Append sanitized text and compact only when the byte cap is crossed."""
        rendered = sanitize_log_text(message).rstrip("\n")
        if not rendered:
            return
        data = (rendered + "\n").encode("utf-8", "replace")
        opened = self._validate_identity()
        if opened.st_size + len(data) <= MAX_LOG_BYTES:
            try:
                os.lseek(self.descriptor, 0, os.SEEK_END)
                write_all_bytes(self.descriptor, data, "private lifecycle log")
            except OSError as error:
                raise EditorError(
                    f"could not append private lifecycle log: {error}"
                ) from error
            return
        self._compact_with(data, opened.st_size)

    def _compact_with(self, data: bytes, current_size: int) -> None:
        """Retain the newest complete UTF-8 tail behind a truncation marker."""
        try:
            previous = os.pread(self.descriptor, current_size, 0)
        except OSError as error:
            raise EditorError(
                f"could not compact private lifecycle log: {error}"
            ) from error
        previous = previous.removeprefix(LOG_TRUNCATION_MARKER)
        available = MAX_LOG_BYTES - len(LOG_TRUNCATION_MARKER)
        payload = LOG_TRUNCATION_MARKER + utf8_tail(previous + data, available)
        try:
            os.lseek(self.descriptor, 0, os.SEEK_SET)
            os.ftruncate(self.descriptor, 0)
            write_all_bytes(self.descriptor, payload, "private lifecycle log")
        except OSError as error:
            raise EditorError(
                f"could not compact private lifecycle log: {error}"
            ) from error


def json_event_detail(value: object) -> str:
    """Serialize one parsed event into bounded deterministic raw detail."""
    return bounded_log_detail(
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    )


def raw_event_content(value: object) -> str | None:
    """Decode the string or Node Buffer projection used by raw CLI events."""
    if isinstance(value, str):
        return value
    if isinstance(value, list) and all(
        type(item) is int and 0 <= item <= 255 for item in value
    ):
        return bytes(value).decode("utf-8", "replace")
    if not isinstance(value, dict) or value.get("type") != "Buffer":
        return None
    data = value.get("data")
    if not isinstance(data, list) or not all(
        type(item) is int and 0 <= item <= 255 for item in data
    ):
        return None
    return bytes(data).decode("utf-8", "replace")


def event_message(value: Mapping[str, object]) -> str | None:
    """Extract the readable payload shared by known CLI event variants."""
    if value.get("type") == "progress":
        name = value.get("name")
        status_value = value.get("status")
        detail = value.get("stepDetail")
        summary = name if isinstance(name, str) and name else None
        if isinstance(status_value, str) and status_value:
            summary = f"{summary}: {status_value}" if summary else status_value
        if isinstance(detail, str) and detail:
            summary = f"{summary} - {detail}" if summary else detail
        if summary:
            return summary
    for key in ("text", "message", "description", "status"):
        item = value.get(key)
        if isinstance(item, str) and item:
            return item
    return raw_event_content(value.get("content"))


def render_devcontainer_log_line(payload: bytes, overflow: bool = False) -> str:
    """Humanize one JSON log event or retain a safe bounded raw projection."""
    decoded = payload.decode("utf-8", "replace")
    if overflow:
        decoded += "... [event truncated]"
    try:
        value = json.loads(decoded)
    except json.JSONDecodeError:
        return "[raw] " + bounded_log_detail(decoded)
    if not isinstance(value, dict):
        return "[raw] " + json_event_detail(value)
    kind = value.get("type")
    if kind not in {"text", "raw", "start", "stop", "progress"}:
        return "[unknown] " + json_event_detail(value)
    message = event_message(value)
    if message is None:
        return f"[{kind}] " + json_event_detail(value)
    detail = bounded_log_detail(message)
    if kind in {"text", "raw"}:
        return detail
    return f"[{kind}] {detail}"


class DevcontainerLogStream:
    """Incrementally frame and persist bounded Dev Containers JSON log events."""

    def __init__(self, writer: LifecycleLogWriter) -> None:
        """Bind the decoder to the writer visible to live log followers."""
        self.writer = writer
        self.buffer = bytearray()
        self.overflow = False
        self.skip_line_feed = False
        self.error_tail = ""

    def feed(self, payload: bytes) -> None:
        """Consume one arbitrary stderr fragment without buffering an unbounded line."""
        rendered: list[str] = []
        for byte in payload:
            if self.skip_line_feed:
                self.skip_line_feed = False
                if byte == 0x0A:
                    continue
            if byte in {0x0A, 0x0D}:
                line = self._finish_line()
                if line:
                    rendered.append(line)
                self.skip_line_feed = byte == 0x0D
            elif len(self.buffer) < MAX_LOG_EVENT_BYTES:
                self.buffer.append(byte)
            else:
                self.overflow = True
        self._publish(rendered)

    def finish(self) -> None:
        """Publish a final unterminated event after stderr reaches EOF."""
        line = self._finish_line()
        if line:
            self._publish([line])

    def _finish_line(self) -> str:
        """Render and reset the current event frame."""
        payload = bytes(self.buffer)
        overflow = self.overflow
        self.buffer.clear()
        self.overflow = False
        if not payload and not overflow:
            return ""
        return render_devcontainer_log_line(payload, overflow)

    def _publish(self, lines: Sequence[str]) -> None:
        """Write one batch immediately and retain a bounded failure projection."""
        if not lines:
            return
        stamped = [f"{utc_now()} devcontainer: {line}" for line in lines]
        self.writer.append("\n".join(stamped))
        combined = "\n".join(lines)
        self.error_tail = (self.error_tail + "\n" + combined)[-MAX_LOG_ERROR_CHARS:]


def append_log(path: pathlib.Path, message: str) -> None:
    """Append one message through the pinned incremental log writer."""
    with LifecycleLogWriter(path) as writer:
        writer.append(message)


def validate_record_identity(value: Mapping[str, object], root: pathlib.Path) -> None:
    """Validate lifecycle identity, ownership, and status fields."""
    if value.get("version") not in {
        LEGACY_RECORD_VERSION,
        CLI_RECORD_VERSION,
        RUNTIME_RECORD_VERSION,
        PHASE_RECORD_VERSION,
        RECORD_VERSION,
    } or value.get("host_root") != str(root):
        fail("workspace record identity is invalid")
    if value.get("status") not in {"starting", "running", "stopped", "error", "dead"}:
        fail("workspace record status is invalid")
    if (
        not isinstance(value.get("pid"), int)
        or isinstance(value.get("pid"), bool)
        or value["pid"] < 1
    ):
        fail("workspace record coordinator pid is invalid")
    if not valid_tmux_pane(value.get("tmux_pane")):
        fail("workspace record tmux pane is invalid")
    if (
        not isinstance(value.get("pane_pid"), int)
        or isinstance(value.get("pane_pid"), bool)
        or value["pane_pid"] < 1
    ):
        fail("workspace record pane pid is invalid")
    canonical_uuid4(value.get("claim_id"), "workspace record claim id")
    if (
        type(value.get("network_authorized")) is not bool
        or type(value.get("ssh_agent_forwarding")) is not bool
    ):
        fail("workspace record authorization flags are invalid")
    container_id = value.get("container_id")
    if container_id is not None and (
        not isinstance(container_id, str) or not container_id or "\0" in container_id
    ):
        fail("workspace record container id is invalid")
    if value.get("status") in {"running", "stopped", "dead"} and container_id is None:
        fail("workspace record is missing its container id")
    if (
        value.get("version") in PHASE_RECORD_VERSIONS
        and value.get("phase") not in RECORD_PHASES
    ):
        fail("workspace record phase is invalid")


def validate_record_optional_fields(value: Mapping[str, object]) -> None:
    """Validate optional outcome fields and the persisted timestamp."""
    exit_code = value.get("exit_code")
    if exit_code is not None and (
        not isinstance(exit_code, int) or isinstance(exit_code, bool)
    ):
        fail("workspace record exit code is invalid")
    error = value.get("error")
    if error is not None and (
        not isinstance(error, str)
        or len(error) > MAX_RECORD_ERROR_CHARS
        or "\0" in error
    ):
        fail("workspace record error is invalid")
    try:
        dt.datetime.strptime(
            str(value.get("updated_at")), "%Y-%m-%dT%H:%M:%SZ"
        ).replace(tzinfo=dt.timezone.utc)
    except ValueError as timestamp_error:
        raise EditorError("workspace record timestamp is invalid") from timestamp_error


def validate_record_podman_connection(value: Mapping[str, object]) -> None:
    """Validate the optional exact Podman connection persisted by version 6."""
    if value.get("version") != RECORD_VERSION:
        return
    connection = value.get("podman_connection")
    if connection is None:
        return
    if not isinstance(connection, dict) or set(connection) != {
        "name",
        "machine_pin",
    }:
        fail("workspace record Podman connection is invalid")
    name = connection.get("name")
    machine_pin = connection.get("machine_pin")
    if (
        not isinstance(name, str)
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", name) is None
        or not isinstance(machine_pin, str)
        or re.fullmatch(r"[0-9a-f]{64}", machine_pin) is None
    ):
        fail("workspace record Podman connection is invalid")


def validate_record_executable_field(
    value: Mapping[str, object],
    field: str,
    label: str,
) -> None:
    """Validate one persisted absolute runtime executable path."""
    executable = value.get(field)
    if executable is None and value.get("status") in {"starting", "error"}:
        return
    if (
        not isinstance(executable, str)
        or not executable.startswith("/")
        or executable.startswith("//")
        or "\0" in executable
        or os.path.normpath(executable) != executable
    ):
        fail(f"workspace record {label} path is invalid")


def validate_record_paths(value: Mapping[str, object], root: pathlib.Path) -> None:
    """Validate host paths without permitting lexical escapes."""
    config_path = value.get("config_path")
    if (
        not isinstance(config_path, str)
        or not config_path.startswith("/")
        or "\0" in config_path
        or os.path.normpath(config_path) != config_path
        or not contained(root, pathlib.Path(config_path))
    ):
        fail("workspace record config path is invalid")
    log = value.get("log_path")
    if (
        not isinstance(log, str)
        or not log.startswith("/")
        or "\0" in log
        or os.path.normpath(log) != log
    ):
        fail("workspace record log path is invalid")
    if value.get("version") != LEGACY_RECORD_VERSION:
        validate_record_executable_field(value, "cli_path", "Dev Containers CLI")
    if value.get("version") in RUNTIME_RECORD_VERSIONS:
        validate_record_executable_field(
            value,
            "docker_path",
            "Docker-compatible engine",
        )


def validate_workspace_key(value: Mapping[str, object], root: pathlib.Path) -> None:
    """Validate the all-or-none container workspace identity."""
    key = value.get("workspace_key")
    if not isinstance(key, dict) or set(key) != {"runtime", "root", "repo_identity"}:
        fail("workspace key schema is invalid")
    if key.get("runtime") != "container" or key.get("repo_identity") != str(root):
        fail("workspace key identity is invalid")
    for field in ("root", "container_root"):
        item = value.get(field) if field == "container_root" else key.get(field)
        if not canonical_posix_absolute(item):
            fail("container root is invalid")
    if key.get("root") != value.get("container_root"):
        fail("workspace record roots do not match")


def record_keys(version: object) -> frozenset[str] | set[str]:
    """Return the exact closed key set for one supported record version."""
    if version == LEGACY_RECORD_VERSION:
        return LEGACY_RECORD_KEYS
    if version == CLI_RECORD_VERSION:
        return CLI_RECORD_KEYS
    if version == RUNTIME_RECORD_VERSION:
        return RUNTIME_RECORD_KEYS
    if version == PHASE_RECORD_VERSION:
        return PHASE_RECORD_KEYS
    if version == RECORD_VERSION:
        return RECORD_KEYS
    fail("workspace record identity is invalid")


def validate_record(value: object, root: pathlib.Path) -> dict[str, Any]:
    """Validate one exact lifecycle record."""
    if not isinstance(value, dict):
        fail("workspace record schema is invalid")
    keys = record_keys(value.get("version"))
    if set(value) != keys:
        fail("workspace record schema is invalid")
    validate_record_identity(value, root)
    validate_record_optional_fields(value)
    validate_record_podman_connection(value)
    validate_record_paths(value, root)
    validate_workspace_key(value, root)
    return dict(value)


def validate_workspace_record(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    value: object,
) -> dict[str, Any]:
    """Validate one record including its exact workspace-bound host paths."""
    candidate = validate_record(value, root)
    if candidate["log_path"] != str(log_path(paths, root)):
        fail("workspace record log path does not match its host root")
    return candidate


def load_record(
    paths: Mapping[str, pathlib.Path], root: pathlib.Path
) -> dict[str, Any]:
    """Read and validate one workspace record."""
    state = pinned_state(paths)
    return validate_workspace_record(
        paths,
        root,
        read_private_json_at(
            state.descriptor("workspaces"), record_name(root), "workspace record"
        ),
    )


def selected_record(
    paths: Mapping[str, pathlib.Path], root: pathlib.Path
) -> dict[str, Any]:
    """Return an active record or the exact safe-fallback signal."""
    state = pinned_state(paths)
    if not entry_exists_at(state.descriptor("workspaces"), record_name(root)):
        raise NoActiveEditor(
            f"no Dev Container editor owns repository {root}"
        ) from None
    record = load_record(paths, root)
    if record["status"] != "running":
        fail(
            f"Dev Container lifecycle is {record['status']}; host fallback is disabled"
        )
    if not pid_alive(record["pid"]):
        fail(
            "registered Dev Container coordinator is unreachable; host fallback is disabled"
        )
    return record


def lock_value() -> dict[str, object]:
    """Build one private cross-process lock record."""
    return {"version": MESSAGE_VERSION, "pid": os.getpid(), "created_at": utc_now()}


@contextlib.contextmanager
def workspace_lock(
    paths: Mapping[str, pathlib.Path], root: pathlib.Path
) -> Iterator[int]:
    """Hold one advisory lock across a lifecycle or exact-host handoff."""
    state = pinned_state(paths)
    directory_fd = state.descriptor("locks")
    name = record_name(root)
    payload = (json.dumps(lock_value(), sort_keys=True) + "\n").encode()
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(name, flags, 0o600, dir_fd=directory_fd)
        os.set_inheritable(descriptor, False)
        opened = os.fstat(descriptor)
        lexical = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(opened.st_mode)
            or stat.S_ISLNK(lexical.st_mode)
            or opened.st_uid != os.getuid()
            or stat.S_IMODE(opened.st_mode) != 0o600
            or opened.st_nlink != 1
            or lexical.st_nlink != 1
            or (opened.st_dev, opened.st_ino) != (lexical.st_dev, lexical.st_ino)
        ):
            fail("Dev Container lifecycle lock is unsafe")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise EditorError("Dev Container lifecycle lock is busy") from error
        os.ftruncate(descriptor, 0)
        os.write(descriptor, payload)
        os.fsync(descriptor)
        fsync_directory(directory_fd, "Dev Container lifecycle lock directory")
    except EditorError:
        if "descriptor" in locals():
            os.close(descriptor)
        raise
    except OSError as error:
        if "descriptor" in locals():
            os.close(descriptor)
        raise EditorError(f"could not claim lifecycle lock: {error}") from error
    try:
        yield descriptor
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def exact_executable_path(configured: object, label: str) -> str:
    """Revalidate one canonical executable without consulting ``PATH``.

    :param configured: Exact absolute executable path supplied by the host.
    :param label: Runtime component name used in diagnostics.
    :returns: The unchanged canonical absolute path.
    :raises EditorError: If the path is missing, indirect, or non-executable.
    """
    if (
        not isinstance(configured, str)
        or not configured.startswith("/")
        or configured.startswith("//")
        or "\0" in configured
        or os.path.normpath(configured) != configured
    ):
        fail(f"{label} path must be canonical and absolute")
    candidate = pathlib.Path(configured)
    try:
        details = candidate.lstat()
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise EditorError(f"{label} is unavailable: {error}") from error
    if (
        stat.S_ISLNK(details.st_mode)
        or not stat.S_ISREG(details.st_mode)
        or resolved != candidate
        or not os.access(candidate, os.X_OK)
    ):
        fail(f"{label} is not one canonical executable regular file")
    return configured


def cli_path(configured: object) -> str:
    """Revalidate the certified Dev Containers CLI selected by the host."""
    return exact_executable_path(configured, "certified Dev Containers CLI")


def docker_path(configured: object) -> str:
    """Revalidate the exact Docker-compatible engine selected by the host."""
    return exact_executable_path(configured, "Docker-compatible engine")


def stored_cli_path(record: Mapping[str, object]) -> str:
    """Return the exact persisted CLI without consulting the current ``PATH``.

    :param record: Validated version-3 workspace record.
    :raises EditorError: If the record predates the pinned CLI contract or the
        recorded executable is no longer usable.
    """
    if record.get("version") not in CLI_RECORD_VERSIONS:
        fail("legacy workspace records cannot execute or restart a Dev Container")
    value = record.get("cli_path")
    if not isinstance(value, str):
        fail("workspace record has no canonical Dev Containers CLI path")
    return exact_executable_path(value, "recorded Dev Containers CLI")


def stored_docker_path(record: Mapping[str, object]) -> str:
    """Return the exact persisted Docker-compatible engine executable."""
    if record.get("version") not in RUNTIME_RECORD_VERSIONS:
        fail("workspace record predates the pinned Docker-compatible engine contract")
    value = record.get("docker_path")
    if not isinstance(value, str):
        fail("workspace record has no canonical Docker-compatible engine path")
    return docker_path(value)


def stored_runtime_paths(record: Mapping[str, object]) -> tuple[str, str]:
    """Revalidate both persisted executables required for lifecycle actions."""
    return stored_cli_path(record), stored_docker_path(record)


def stored_podman_machine(
    record: Mapping[str, object], docker: str
) -> PodmanMachine | None:
    """Re-resolve and attest the Podman endpoint pinned by a version-6 record."""
    value = record.get("podman_connection")
    required = sys.platform == "darwin" and pathlib.Path(docker).name in {
        "podman",
        "podman-remote",
    }
    if value is None:
        if required:
            fail("workspace record predates the pinned Podman connection contract")
        return None
    if not required:
        fail("workspace record has an unexpected Podman connection identity")
    if not isinstance(value, dict):
        fail("workspace record Podman connection is invalid")
    name = value.get("name")
    pin = value.get("machine_pin")
    if not isinstance(name, str) or not isinstance(pin, str):
        fail("workspace record Podman connection is invalid")
    machine = discover_podman_machine(docker, name)
    if machine.pin_id != pin:
        fail("recorded Podman Machine identity changed")
    return machine


def canonical_socket_path(value: str) -> pathlib.Path:
    """Resolve one absolute socket path while rejecting a symlink leaf."""
    if (
        not value
        or len(os.fsencode(value)) > 1024
        or any(character in value for character in ("\0", "\n", "\r", ":"))
    ):
        fail("SSH_AUTH_SOCK is explicitly set to an invalid path")
    lexical = pathlib.Path(value).expanduser()
    if not lexical.is_absolute():
        fail("SSH_AUTH_SOCK must be absolute")
    try:
        parent = lexical.parent.resolve(strict=True)
        candidate = parent / lexical.name
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise EditorError(f"SSH_AUTH_SOCK is unavailable: {error}") from error
    if resolved != candidate:
        fail("SSH_AUTH_SOCK must not be a symlink")
    return resolved


def darwin_launchd_runtime_exception(
    authority: DirectoryAuthority,
    child: DirectoryAuthority | None,
) -> bool:
    """Recognize the one system-owned writable ancestor used by launchd."""
    if sys.platform != "darwin" or child is None:
        return False
    return (
        authority.path == pathlib.Path("/private/var/run")
        and authority.owner == 0
        and authority.group == 1
        and stat.S_IMODE(authority.mode) == 0o775
        and child.path.parent == authority.path
        and re.fullmatch(r"com[.]apple[.]launchd[.][A-Za-z0-9]+", child.path.name)
        is not None
        and child.owner == os.getuid()
        and stat.S_IMODE(child.mode) == 0o700
    )


def host_agent_authority_chain(
    parent: pathlib.Path,
) -> tuple[DirectoryAuthority, ...]:
    """Snapshot every directory that controls the canonical agent pathname."""
    directories = (*reversed(parent.parents), parent)
    authorities: list[DirectoryAuthority] = []
    try:
        for directory in directories:
            details = directory.lstat()
            if stat.S_ISLNK(details.st_mode) or not stat.S_ISDIR(details.st_mode):
                fail("SSH_AUTH_SOCK authority contains a non-directory component")
            authorities.append(
                DirectoryAuthority(
                    directory,
                    details.st_dev,
                    details.st_ino,
                    details.st_uid,
                    details.st_gid,
                    details.st_mode,
                )
            )
    except OSError as error:
        raise EditorError(f"SSH_AUTH_SOCK authority is unavailable: {error}") from error
    if not authorities:
        fail("SSH_AUTH_SOCK authority chain is empty")
    current_uid = os.getuid()
    final = authorities[-1]
    if final.owner != current_uid or stat.S_IMODE(final.mode) != 0o700:
        fail("SSH_AUTH_SOCK parent is not an owner-only directory")
    for index, authority in enumerate(authorities):
        if authority.owner not in {0, current_uid}:
            fail("SSH_AUTH_SOCK authority is owned by an untrusted user")
        if stat.S_IMODE(authority.mode) & 0o022 == 0:
            continue
        child = authorities[index + 1] if index + 1 < len(authorities) else None
        sticky_owner_boundary = (
            authority.mode & stat.S_ISVTX
            and child is not None
            and child.owner in {0, current_uid}
        )
        if sticky_owner_boundary or darwin_launchd_runtime_exception(authority, child):
            continue
        fail("SSH_AUTH_SOCK authority contains an unsafe writable directory")
    return tuple(authorities)


def snapshot_host_agent(value: str) -> HostAgentSnapshot:
    """Capture one socket beneath a fully attested owner-private namespace."""
    path = canonical_socket_path(value)
    authority = host_agent_authority_chain(path.parent)
    parent_fd = open_existing_directory_path(path.parent, "SSH_AUTH_SOCK parent")
    try:
        parent = directory_identity(os.fstat(parent_fd))
        details = os.stat(path.name, dir_fd=parent_fd, follow_symlinks=False)
    except OSError as error:
        raise EditorError(f"SSH_AUTH_SOCK is unavailable: {error}") from error
    finally:
        with contextlib.suppress(OSError):
            os.close(parent_fd)
    final = authority[-1]
    if parent != DirectoryIdentity(final.device, final.inode, final.owner):
        fail("SSH_AUTH_SOCK parent directory changed during validation")
    if not stat.S_ISSOCK(details.st_mode) or details.st_uid != os.getuid():
        fail("SSH_AUTH_SOCK is not a socket owned by the current user")
    return HostAgentSnapshot(
        path,
        details.st_dev,
        details.st_ino,
        details.st_uid,
        details.st_mode,
        authority,
    )


def ssh_agent(policy: str = "auto") -> HostAgentSnapshot | None:
    """Return a validated host agent according to the public ``auto|off`` policy."""
    if policy == "off":
        return None
    if policy != "auto":
        fail("SSH-agent policy must be auto or off")
    if "SSH_AUTH_SOCK" not in os.environ:
        return None
    return snapshot_host_agent(os.environ["SSH_AUTH_SOCK"])


def revalidate_host_agent(agent: HostAgentSnapshot) -> None:
    """Require the full namespace and authorized socket to retain identity."""
    authority = host_agent_authority_chain(agent.path.parent)
    if authority != agent.authority:
        fail("host SSH-agent authority chain changed after validation")
    parent_fd = open_existing_directory_path(agent.path.parent, "SSH_AUTH_SOCK parent")
    try:
        parent = directory_identity(os.fstat(parent_fd))
        details = os.stat(
            agent.path.name,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
    except OSError as error:
        raise EditorError(f"host SSH-agent socket disappeared: {error}") from error
    finally:
        with contextlib.suppress(OSError):
            os.close(parent_fd)
    final = authority[-1]
    if parent != DirectoryIdentity(final.device, final.inode, final.owner):
        fail("host SSH-agent parent directory changed after validation")
    observed = (
        details.st_dev,
        details.st_ino,
        details.st_uid,
        details.st_mode,
    )
    expected = (agent.device, agent.inode, agent.owner, agent.mode)
    if observed != expected or not stat.S_ISSOCK(details.st_mode):
        fail("host SSH-agent socket changed after validation")


def bounded_json_command(
    argv: Sequence[str],
    label: str,
    *,
    env: Mapping[str, str] | None = None,
) -> object:
    """Run one metadata command and decode one bounded strict UTF-8 JSON value."""
    result, overflow = run_bounded_capture(
        argv,
        timeout=5.0,
        stdout_limit=MAX_PODMAN_JSON_BYTES,
        env=env,
    )
    if result.returncode != 0:
        detail = bounded_log_detail(result.stderr.decode("utf-8", "replace")).strip()
        fail(f"{label} failed" + (f": {detail}" if detail else ""))
    if overflow:
        fail(f"{label} JSON exceeds 256 KiB")
    try:
        return json.loads(result.stdout.decode("utf-8", "strict"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise EditorError(f"{label} returned invalid UTF-8 JSON: {error}") from error


def podman_json_list(value: object, label: str) -> list[Mapping[str, object]]:
    """Require one JSON array containing only objects."""
    if not isinstance(value, list) or not all(isinstance(item, dict) for item in value):
        fail(f"{label} JSON is not an array of objects")
    return value


def selected_podman_connection(
    values: Sequence[Mapping[str, object]],
    required_name: str | None = None,
) -> Mapping[str, object]:
    """Resolve the one effective Podman connection without unsafe fallback."""
    if required_name is not None:
        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", required_name) is None:
            fail("recorded Podman connection name is invalid")
        candidates = [item for item in values if item.get("Name") == required_name]
        if len(candidates) != 1:
            fail("recorded Podman connection is missing or ambiguous")
        return candidates[0]
    connection_override = os.environ.get("CONTAINER_CONNECTION")
    host_override = os.environ.get("CONTAINER_HOST")
    candidates = list(values)
    if connection_override is not None:
        candidates = [
            item for item in candidates if item.get("Name") == connection_override
        ]
    if host_override is not None:
        candidates = [item for item in candidates if item.get("URI") == host_override]
    if connection_override is None and host_override is None:
        candidates = [item for item in candidates if item.get("Default") is True]
    if len(candidates) != 1:
        fail("Podman Machine connection selection is missing or ambiguous")
    return candidates[0]


def connection_endpoint(connection: Mapping[str, object]) -> tuple[str, str, int, int]:
    """Validate and return a local rootless Podman SSH connection endpoint."""
    if connection.get("IsMachine") is not True:
        fail("effective Podman connection is not a machine connection")
    uri = connection.get("URI")
    if not isinstance(uri, str) or len(uri) > 4096 or "\0" in uri:
        fail("Podman Machine connection URI is invalid")
    parsed = urllib.parse.urlsplit(uri)
    try:
        port = parsed.port
        host = parsed.hostname
    except ValueError as error:
        raise EditorError("Podman Machine connection URI is invalid") from error
    if (
        parsed.scheme != "ssh"
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
        or not parsed.username
        or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]{0,63}", parsed.username)
        or host is None
        or port is None
    ):
        fail("Podman Machine connection is not one safe SSH endpoint")
    try:
        if not ipaddress.ip_address(host).is_loopback:
            fail("Podman Machine SSH endpoint is not loopback")
    except ValueError as error:
        raise EditorError(
            "Podman Machine SSH endpoint is not numeric loopback"
        ) from error
    match = PODMAN_CONNECTION_SOCKET_RE.fullmatch(parsed.path)
    if match is None:
        fail("Podman Machine connection is not a rootless user socket")
    return parsed.username, host, port, int(match.group("uid"))


def canonical_identity_file(value: object) -> tuple[pathlib.Path, os.stat_result]:
    """Validate one bounded owner-only Podman SSH private key file."""
    if (
        not isinstance(value, str)
        or not value.startswith("/")
        or any(character in value for character in ("\0", "\n", "\r"))
    ):
        fail("Podman Machine identity path is invalid")
    path = pathlib.Path(value)
    try:
        details = path.lstat()
        resolved = path.resolve(strict=True)
    except OSError as error:
        raise EditorError(f"Podman Machine identity is unavailable: {error}") from error
    if (
        resolved != path
        or stat.S_ISLNK(details.st_mode)
        or not stat.S_ISREG(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o600
        or details.st_nlink != 1
        or details.st_size < 1
        or details.st_size > MAX_SSH_IDENTITY_BYTES
    ):
        fail("Podman Machine identity is not one private canonical regular file")
    return path, details


def matching_machine_entry(
    values: Sequence[Mapping[str, object]], name: str
) -> Mapping[str, object]:
    """Return the unique running machine-list entry with the selected name."""
    matches = [item for item in values if item.get("Name") == name]
    if len(matches) != 1 or matches[0].get("Running") is not True:
        fail("effective Podman Machine is missing, ambiguous, or not running")
    rootful = matches[0].get("Rootful")
    if rootful is not None and rootful is not False:
        fail("effective Podman Machine is rootful")
    return matches[0]


def inspected_machine(value: object, name: str) -> Mapping[str, object]:
    """Return the unique inspect object for the selected machine."""
    values = podman_json_list(value, "podman machine inspect")
    if len(values) != 1 or values[0].get("Name") != name:
        fail("Podman Machine inspect identity does not match its connection")
    machine = values[0]
    if machine.get("State") != "running" or machine.get("Rootful") is not False:
        fail("effective Podman Machine must be running and rootless")
    return machine


def validate_machine_match(
    connection: Mapping[str, object],
    listed: Mapping[str, object],
    inspected: Mapping[str, object],
    endpoint: tuple[str, str, int, int],
) -> PodmanMachine:
    """Cross-check connection, list, inspect, and private-key identities."""
    name = connection.get("Name")
    identity_value = connection.get("Identity")
    ssh_config = inspected.get("SSHConfig")
    if (
        not isinstance(name, str)
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", name) is None
        or not isinstance(ssh_config, dict)
    ):
        fail("Podman Machine metadata is incomplete")
    user, host, port, uid = endpoint
    compared = (
        ssh_config.get("RemoteUsername"),
        ssh_config.get("Port"),
        ssh_config.get("IdentityPath"),
        listed.get("RemoteUsername"),
        listed.get("Port"),
        listed.get("IdentityPath"),
    )
    if compared != (user, port, identity_value, user, port, identity_value):
        fail("Podman Machine name, user, port, or identity metadata disagrees")
    identity, details = canonical_identity_file(identity_value)
    created = inspected.get("Created")
    if (
        not isinstance(created, str)
        or not created
        or len(created) > 512
        or "\0" in created
    ):
        fail("Podman Machine creation identity is invalid")
    pin_payload = json.dumps(
        [name, user, uid, str(identity), created],
        separators=(",", ":"),
    ).encode("utf-8")
    return PodmanMachine(
        name,
        user,
        host,
        port,
        uid,
        identity,
        details.st_dev,
        details.st_ino,
        created,
        hashlib.sha256(pin_payload).hexdigest(),
    )


def podman_discovery_environment() -> dict[str, str]:
    """Remove engine-routing overrides from read-only metadata subprocesses."""
    environment = dict(os.environ)
    for name in (
        "CONTAINER_CONNECTION",
        "CONTAINER_HOST",
        "CONTAINER_SSHKEY",
        "DOCKER_HOST",
    ):
        environment.pop(name, None)
    return environment


def discover_podman_machine(
    docker: str,
    required_name: str | None = None,
) -> PodmanMachine:
    """Resolve the effective local rootless Podman Machine from bounded JSON."""
    if required_name is None and "CONTAINER_SSHKEY" in os.environ:
        fail(
            "CONTAINER_SSHKEY is unsupported; configure the exact identity on "
            "the selected Podman connection"
        )
    environment = podman_discovery_environment()
    connections = podman_json_list(
        bounded_json_command(
            [docker, "system", "connection", "list", "--format", "json"],
            "podman system connection list",
            env=environment,
        ),
        "podman system connection list",
    )
    connection = selected_podman_connection(connections, required_name)
    endpoint = connection_endpoint(connection)
    name = connection.get("Name")
    if not isinstance(name, str):
        fail("Podman Machine connection name is invalid")
    machines = podman_json_list(
        bounded_json_command(
            [docker, "machine", "list", "--format", "json"],
            "podman machine list",
            env=environment,
        ),
        "podman machine list",
    )
    listed = matching_machine_entry(machines, name)
    inspected = inspected_machine(
        bounded_json_command(
            [docker, "machine", "inspect", "--", name],
            "podman machine inspect",
            env=environment,
        ),
        name,
    )
    return validate_machine_match(connection, listed, inspected, endpoint)


def new_relay_agent_socket() -> str:
    """Allocate an unpredictable container-owned proxy pathname per lifecycle."""
    return f"{RELAY_AGENT_DIRECTORY_PREFIX}{secrets.token_hex(16)}/agent.sock"


def validated_relay_agent_socket(value: str | None) -> str:
    """Require one launcher-generated container proxy pathname."""
    if value is None or RELAY_AGENT_SOCKET_RE.fullmatch(value) is None:
        fail("Podman SSH-agent relay socket path is invalid")
    return value


def forwarding_plan(
    root: pathlib.Path,
    docker: str,
    agent: HostAgentSnapshot | pathlib.Path | None,
    selected_machine: PodmanMachine | None = None,
) -> AgentForwarding:
    """Resolve direct bind, Podman Machine relay, or disabled forwarding."""
    podman_machine = sys.platform == "darwin" and pathlib.Path(docker).name in {
        "podman",
        "podman-remote",
    }
    if selected_machine is not None and not podman_machine:
        fail("a pinned Podman Machine cannot be used with this container engine")
    machine = selected_machine
    if machine is None and podman_machine:
        machine = discover_podman_machine(docker)
    if agent is None:
        return AgentForwarding("disabled", None, machine, None, None)
    if isinstance(agent, pathlib.Path):
        if machine is not None:
            fail("Podman Machine forwarding requires a host-agent identity snapshot")
        return AgentForwarding("direct-bind", None, None, agent, DIRECT_AGENT_SOCKET)
    snapshot = agent
    if machine is None:
        return AgentForwarding(
            "direct-bind", snapshot, None, snapshot.path, DIRECT_AGENT_SOCKET
        )
    return AgentForwarding(
        "podman-machine-relay",
        snapshot,
        machine,
        None,
        new_relay_agent_socket(),
    )


def forwarding_connection(forwarding: AgentForwarding) -> dict[str, str] | None:
    """Return the persisted identity of this lifecycle's Podman connection."""
    machine = forwarding.machine
    if machine is None:
        return None
    return {"name": machine.name, "machine_pin": machine.pin_id}


def podman_machine_uri(machine: PodmanMachine) -> str:
    """Render the validated rootless Podman Machine endpoint as an exact URI."""
    host = f"[{machine.host}]" if ":" in machine.host else machine.host
    return (
        f"ssh://{machine.user}@{host}:{machine.port}"
        f"/run/user/{machine.uid}/podman/podman.sock"
    )


def pinned_engine_environment(
    machine: PodmanMachine | None,
) -> dict[str, str] | None:
    """Build a subprocess environment pinned to one selected Podman endpoint."""
    if machine is None:
        return None
    environment = dict(os.environ)
    for name in ("CONTAINER_CONNECTION", "DOCKER_HOST"):
        environment.pop(name, None)
    environment["CONTAINER_HOST"] = podman_machine_uri(machine)
    environment["CONTAINER_SSHKEY"] = str(machine.identity)
    return environment


def pinned_engine_argv(argv: Sequence[str], machine: PodmanMachine | None) -> list[str]:
    """Wrap a detached command with an exact Podman endpoint environment."""
    if machine is None:
        return list(argv)
    executable = exact_executable_path("/usr/bin/env", "environment launcher")
    return [
        executable,
        "-u",
        "CONTAINER_CONNECTION",
        "-u",
        "DOCKER_HOST",
        f"CONTAINER_HOST={podman_machine_uri(machine)}",
        f"CONTAINER_SSHKEY={machine.identity}",
        *argv,
    ]


def validate_machine_identity(machine: PodmanMachine) -> None:
    """Require the Podman private key to retain its selected file identity."""
    identity, details = canonical_identity_file(str(machine.identity))
    if identity != machine.identity or (
        details.st_dev,
        details.st_ino,
    ) != (machine.identity_device, machine.identity_inode):
        fail("Podman Machine identity changed after metadata selection")


def receive_exact_socket(stream: socket.socket, size: int) -> bytes:
    """Receive exactly one fixed-size authentication frame or a short EOF."""
    payload = bytearray()
    while len(payload) < size:
        chunk = stream.recv(size - len(payload))
        if not chunk:
            break
        payload.extend(chunk)
    return bytes(payload)


def agent_proxy_response(token: bytes, challenge: bytes) -> bytes:
    """Authenticate one container proxy to the host gate with domain separation."""
    return hmac.new(
        token,
        AGENT_AUTH_PROXY_CONTEXT + challenge,
        hashlib.sha256,
    ).digest()


def agent_gate_acknowledgement(
    token: bytes,
    challenge: bytes,
    response: bytes,
) -> bytes:
    """Authenticate the host gate back to the container proxy."""
    return hmac.new(
        token,
        AGENT_AUTH_GATE_CONTEXT + challenge + response,
        hashlib.sha256,
    ).digest()


def relay_socket_pair(
    left: socket.socket,
    right: socket.socket,
    stop: threading.Event,
) -> None:
    """Relay one authenticated socket pair until EOF or lifecycle shutdown."""
    with selectors.DefaultSelector() as selector:
        selector.register(left, selectors.EVENT_READ, right)
        selector.register(right, selectors.EVENT_READ, left)
        while selector.get_map() and not stop.is_set():
            for key, _mask in selector.select(0.2):
                payload = key.fileobj.recv(STREAM_CHUNK_BYTES)
                if payload:
                    key.data.sendall(payload)
                    continue
                selector.unregister(key.fileobj)
                with contextlib.suppress(OSError):
                    key.data.shutdown(socket.SHUT_WR)


def close_socket(stream: socket.socket | None) -> None:
    """Close one socket without letting teardown races mask lifecycle state."""
    if stream is not None:
        with contextlib.suppress(OSError):
            stream.shutdown(socket.SHUT_RDWR)
        with contextlib.suppress(OSError):
            stream.close()


class HostAgentGate:
    """Expose an authenticated, parent-leashed gate to one host agent."""

    def __init__(
        self,
        paths: StateDirectories,
        host_agent: HostAgentSnapshot,
    ) -> None:
        """Bind gate authority to pinned state and one host-agent identity."""
        self.paths = paths
        self.host_agent = host_agent
        self.token = secrets.token_bytes(AGENT_AUTH_TOKEN_BYTES)
        self.name = f"agent-gate-{secrets.token_hex(8)}.sock"
        self.path = paths["machines"] / self.name
        self.listener: socket.socket | None = None
        self.identity: SocketIdentity | None = None
        self.accept_thread: threading.Thread | None = None
        self.stop = threading.Event()
        self.slots = threading.BoundedSemaphore(MAX_AGENT_GATE_CONNECTIONS)
        self.active: set[socket.socket] = set()
        self.workers: set[threading.Thread] = set()
        self.lock = threading.Lock()
        self.failure: str | None = None
        self.closed = False

    @property
    def token_line(self) -> bytes:
        """Return the fixed-size secret frame written only to proxy stdin."""
        return self.token.hex().encode("ascii") + b"\n"

    def _remember_failure(self, message: str) -> None:
        """Retain only the first asynchronous gate failure."""
        with self.lock:
            if self.failure is None:
                self.failure = message

    def _track_socket(self, stream: socket.socket) -> None:
        """Register one connection for deterministic lifecycle cleanup."""
        with self.lock:
            self.active.add(stream)

    def _untrack_socket(self, stream: socket.socket | None) -> None:
        """Forget one already-closed connection."""
        if stream is not None:
            with self.lock:
                self.active.discard(stream)

    def _authenticated_host_connection(
        self, client: socket.socket
    ) -> socket.socket | None:
        """Authenticate a forwarded peer before touching the host agent."""
        client.settimeout(5.0)
        challenge = secrets.token_bytes(AGENT_AUTH_CHALLENGE_BYTES)
        client.sendall(challenge)
        response = receive_exact_socket(client, AGENT_AUTH_RESPONSE_BYTES)
        expected = agent_proxy_response(self.token, challenge)
        if not hmac.compare_digest(response, expected):
            return None
        revalidate_host_agent(self.host_agent)
        upstream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        upstream.settimeout(5.0)
        try:
            upstream.connect(os.fspath(self.host_agent.path))
        except OSError as error:
            close_socket(upstream)
            raise EditorError(
                f"could not connect to the authenticated host SSH-agent: {error}"
            ) from error
        except BaseException:
            close_socket(upstream)
            raise
        acknowledgement = agent_gate_acknowledgement(
            self.token,
            challenge,
            response,
        )
        try:
            client.sendall(acknowledgement)
        except BaseException:
            close_socket(upstream)
            raise
        return upstream

    def _serve(self, client: socket.socket) -> None:
        """Serve one bounded authentication attempt and relay accepted traffic."""
        upstream: socket.socket | None = None
        try:
            upstream = self._authenticated_host_connection(client)
            if upstream is None:
                return
            self._track_socket(upstream)
            client.settimeout(None)
            upstream.settimeout(None)
            relay_socket_pair(client, upstream, self.stop)
        except EditorError as error:
            self._remember_failure(str(error))
        except OSError:
            pass
        finally:
            self._untrack_socket(upstream)
            self._untrack_socket(client)
            close_socket(upstream)
            close_socket(client)
            self.slots.release()
            with self.lock:
                self.workers.discard(threading.current_thread())

    def _start_worker(self, client: socket.socket) -> None:
        """Start one connection worker within the fixed concurrency bound."""
        if self.stop.is_set():
            close_socket(client)
            return
        if not self.slots.acquire(blocking=False):
            close_socket(client)
            return
        self._track_socket(client)
        worker = threading.Thread(target=self._serve, args=(client,), daemon=True)
        start_error: RuntimeError | None = None
        started = False
        with self.lock:
            if not self.stop.is_set():
                self.workers.add(worker)
                try:
                    worker.start()
                    started = True
                except RuntimeError as error:
                    start_error = error
                    self.workers.discard(worker)
        if not started:
            if start_error is not None:
                self._remember_failure(
                    f"could not start host SSH-agent gate worker: {start_error}"
                )
            self._untrack_socket(client)
            close_socket(client)
            self.slots.release()

    def _accept(self, listener: socket.socket) -> None:
        """Accept gate clients until the parent lifecycle closes the listener."""
        while not self.stop.is_set():
            try:
                client, _address = listener.accept()
            except socket.timeout:  # noqa: UP041 - distinct on Apple Python 3.9
                continue
            except OSError as error:
                if not self.stop.is_set():
                    self._remember_failure(
                        f"host SSH-agent gate accept failed: {error}"
                    )
                return
            self._start_worker(client)

    def _socket_identity(self) -> SocketIdentity:
        """Validate and return the just-created owner-only socket identity."""
        details = self.path.lstat()
        if (
            not stat.S_ISSOCK(details.st_mode)
            or details.st_uid != os.getuid()
            or stat.S_IMODE(details.st_mode) != 0o600
        ):
            fail("host SSH-agent gate socket metadata is unsafe")
        return SocketIdentity(
            details.st_dev,
            details.st_ino,
            details.st_uid,
            details.st_mode,
        )

    def start(self) -> None:
        """Create the private Unix gate and start its parent-owned accept loop."""
        if self.listener is not None:
            self.check()
            return
        if self.closed:
            fail("host SSH-agent gate is already closed")
        if len(os.fsencode(self.path)) > MAX_UNIX_SOCKET_PATH_BYTES:
            fail("host SSH-agent gate path exceeds the Unix path limit")
        revalidate_directory_path(
            self.paths["machines"],
            self.paths.descriptor("machines"),
            "Podman machines state",
        )
        revalidate_host_agent(self.host_agent)
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            previous_umask = os.umask(0o177)
            try:
                listener.bind(os.fspath(self.path))
            finally:
                os.umask(previous_umask)
            bound = self.path.lstat()
            if not stat.S_ISSOCK(bound.st_mode) or bound.st_uid != os.getuid():
                fail("host SSH-agent gate socket metadata is unsafe")
            bound_identity = SocketIdentity(
                bound.st_dev,
                bound.st_ino,
                bound.st_uid,
                bound.st_mode,
            )
            self.identity = bound_identity
            os.chmod(self.path, 0o600)
            created_identity = self._socket_identity()
            if (
                created_identity.device,
                created_identity.inode,
                created_identity.owner,
            ) != (
                bound_identity.device,
                bound_identity.inode,
                bound_identity.owner,
            ):
                fail("host SSH-agent gate socket changed while securing it")
            self.identity = created_identity
            listener.listen(MAX_AGENT_GATE_CONNECTIONS)
            listener.settimeout(0.2)
            accept_thread = threading.Thread(
                target=self._accept,
                args=(listener,),
                daemon=True,
            )
            accept_thread.start()
            self.listener = listener
            self.accept_thread = accept_thread
        except BaseException as primary:
            close_socket(listener)
            try:
                self._retire_socket()
            except BaseException as cleanup:  # noqa: BLE001 - preserve control flow
                report_cleanup_failure(
                    primary,
                    "host SSH-agent gate startup cleanup failed",
                    cleanup,
                )
            raise

    def check(self) -> None:
        """Revalidate live gate authority and surface asynchronous failures."""
        if self.failure is not None:
            fail(self.failure)
        if self.listener is None or self.closed:
            return
        revalidate_host_agent(self.host_agent)
        if self._socket_identity() != self.identity:
            fail("host SSH-agent gate socket changed after creation")
        if self.accept_thread is None or not self.accept_thread.is_alive():
            fail("host SSH-agent gate accept loop exited")

    def _retire_socket(self) -> None:
        """Remove only the exact socket inode created by this gate."""
        identity = self.identity
        if identity is None:
            return
        descriptor = self.paths.descriptor("machines")
        try:
            details = os.stat(self.name, dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            return
        except OSError as error:
            raise EditorError(
                f"could not inspect host SSH-agent gate: {error}"
            ) from error
        observed_authority = (details.st_dev, details.st_ino, details.st_uid)
        expected_authority = (identity.device, identity.inode, identity.owner)
        if observed_authority != expected_authority or not stat.S_ISSOCK(
            details.st_mode
        ):
            fail("host SSH-agent gate socket changed before cleanup")
        try:
            os.unlink(self.name, dir_fd=descriptor)
        except OSError as error:
            raise EditorError(
                f"could not remove host SSH-agent gate: {error}"
            ) from error

    def close(self) -> None:
        """Close every connection, join workers, and retire the exact gate inode."""
        if self.closed:
            return
        with self.lock:
            self.stop.set()
        close_socket(self.listener)
        interrupted = False
        accept_still_running = False
        accept_join_failure: str | None = None
        if self.accept_thread is not None:
            try:
                self.accept_thread.join(2.0)
            except KeyboardInterrupt:
                interrupted = True
            except RuntimeError as error:
                accept_join_failure = (
                    f"could not join the host SSH-agent gate accept loop: {error}"
                )
            try:
                accept_still_running = self.accept_thread.is_alive()
            except RuntimeError as error:
                accept_join_failure = accept_join_failure or (
                    f"could not inspect the host SSH-agent gate accept loop: {error}"
                )
        with self.lock:
            active = tuple(self.active)
            workers = tuple(self.workers)
        for stream in active:
            close_socket(stream)
        deadline = time.monotonic() + 2.0
        worker_join_failures: list[str] = []
        for worker in workers:
            try:
                worker.join(max(0.0, deadline - time.monotonic()))
            except KeyboardInterrupt:
                interrupted = True
            except RuntimeError as error:
                worker_join_failures.append(
                    f"could not join a host SSH-agent gate worker: {error}"
                )
        still_running = False
        for worker in workers:
            try:
                still_running = worker.is_alive() or still_running
            except RuntimeError as error:
                worker_join_failures.append(
                    f"could not inspect a host SSH-agent gate worker: {error}"
                )
        retirement_failure: EditorError | None = None
        try:
            self._retire_socket()
        except EditorError as error:
            retirement_failure = error
        self.listener = None
        failures: list[str] = []
        if accept_join_failure is not None:
            failures.append(accept_join_failure)
        failures.extend(worker_join_failures)
        if accept_still_running:
            failures.append("could not stop the host SSH-agent gate accept loop")
        if still_running:
            failures.append("could not stop all host SSH-agent gate workers")
        if retirement_failure is not None:
            failures.append(str(retirement_failure))
        if not failures:
            self.closed = True
        if interrupted:
            failures.append("host SSH-agent gate cleanup was interrupted")
        if failures:
            fail("; ".join(failures))


def known_hosts_path(paths: StateDirectories, machine: PodmanMachine) -> pathlib.Path:
    """Return the single host-key pin shared by one Podman Machine generation."""
    name = f"{machine.pin_id}.known_hosts"
    return paths["machines"] / name


def open_machine_pin_lock(directory_fd: int, name: str) -> int:
    """Open and validate one private machine-pin lock descriptor."""
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(name, flags, 0o600, dir_fd=directory_fd)
    except OSError as error:
        raise EditorError(f"could not open Podman Machine pin lock: {error}") from error
    try:
        os.set_inheritable(descriptor, False)
        opened = os.fstat(descriptor)
        lexical = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        validate_private_file(opened, "Podman Machine pin lock", maximum=4096)
        if file_identity(opened) != file_identity(lexical):
            fail("Podman Machine pin lock changed while opening")
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor


def acquire_machine_pin_lock(descriptor: int) -> None:
    """Acquire one machine-pin lock within the bounded first-use window."""
    deadline = time.monotonic() + MACHINE_PIN_LOCK_TIMEOUT_SECONDS
    while True:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError as error:
            if time.monotonic() >= deadline:
                raise EditorError(
                    "timed out waiting for the Podman Machine host-key pin"
                ) from error
            time.sleep(POLL_SECONDS)


@contextlib.contextmanager
def machine_pin_lock(paths: StateDirectories, machine: PodmanMachine) -> Iterator[None]:
    """Serialize first-use TOFU for one Podman Machine generation."""
    if re.fullmatch(r"[0-9a-f]{64}", machine.pin_id) is None:
        fail("Podman Machine pin identity is invalid")
    directory_fd = paths.descriptor("machines")
    name = f"{machine.pin_id}.lock"
    descriptor = open_machine_pin_lock(directory_fd, name)
    try:
        acquire_machine_pin_lock(descriptor)
        fsync_directory(directory_fd, "Podman Machine pin directory")
    except OSError as error:
        with contextlib.suppress(OSError):
            os.close(descriptor)
        raise EditorError(
            f"could not claim Podman Machine pin lock: {error}"
        ) from error
    except BaseException:
        with contextlib.suppress(OSError):
            os.close(descriptor)
        raise
    try:
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def validate_known_hosts_payload(payload: bytes, *, allow_empty: bool) -> None:
    """Validate the bounded UTF-8 payload read from one exact pin inode."""
    if not payload and allow_empty:
        return
    try:
        text = payload.decode("utf-8", "strict")
    except UnicodeError as error:
        raise EditorError("Podman known_hosts pin is not UTF-8") from error
    lines = [line for line in text.splitlines() if line and not line.startswith("#")]
    if (
        len(payload) > MAX_KNOWN_HOSTS_BYTES
        or "\0" in text
        or not lines
        or any(len(line.split()) < 3 for line in lines)
    ):
        fail("Podman known_hosts pin is unsafe or corrupt")


def read_bounded_descriptor(descriptor: int, maximum: int) -> bytes:
    """Read at most one byte beyond a descriptor's accepted payload bound."""
    try:
        os.lseek(descriptor, 0, os.SEEK_SET)
        chunks: list[bytes] = []
        total = 0
        while total <= maximum:
            chunk = os.read(
                descriptor,
                min(STREAM_CHUNK_BYTES, maximum + 1 - total),
            )
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        return b"".join(chunks)
    except OSError as error:
        raise EditorError(f"could not read private descriptor: {error}") from error


def validate_known_hosts(path: pathlib.Path, *, allow_empty: bool) -> None:
    """Validate one private, bounded, non-symlink OpenSSH host-key pin."""
    try:
        details = path.lstat()
    except OSError as error:
        raise EditorError(
            f"could not inspect Podman known_hosts pin: {error}"
        ) from error
    if (
        stat.S_ISLNK(details.st_mode)
        or not stat.S_ISREG(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o600
        or details.st_nlink != 1
        or details.st_size > MAX_KNOWN_HOSTS_BYTES
        or (not allow_empty and details.st_size == 0)
    ):
        fail("Podman known_hosts pin is unsafe or corrupt")
    descriptor: int | None = None
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        os.set_inheritable(descriptor, False)
        opened = os.fstat(descriptor)
        payload = read_bounded_descriptor(descriptor, MAX_KNOWN_HOSTS_BYTES)
        finished = os.fstat(descriptor)
        current = path.lstat()
    except OSError as error:
        raise EditorError(f"could not read Podman known_hosts pin: {error}") from error
    finally:
        if descriptor is not None:
            os.close(descriptor)
    if (
        file_identity(opened) != file_identity(details)
        or file_identity(finished) != file_identity(opened)
        or file_identity(current) != file_identity(opened)
        or len(payload) != opened.st_size
    ):
        fail("Podman known_hosts pin changed while reading")
    validate_known_hosts_payload(payload, allow_empty=allow_empty)


def prepare_known_hosts(
    paths: StateDirectories, machine: PodmanMachine
) -> pathlib.Path:
    """Create once or validate the private pin file under the machine lock."""
    path = known_hosts_path(paths, machine)
    try:
        descriptor = os.open(
            path.name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=paths.descriptor("machines"),
        )
    except FileExistsError:
        validate_known_hosts(path, allow_empty=True)
        if path.lstat().st_size:
            validate_known_hosts(path, allow_empty=False)
        return path
    except OSError as error:
        raise EditorError(
            f"could not create Podman known_hosts pin: {error}"
        ) from error
    os.close(descriptor)
    validate_known_hosts(path, allow_empty=True)
    return path


def known_hosts_location(
    paths: StateDirectories, path: pathlib.Path
) -> tuple[int, str]:
    """Resolve one pin only through the already-pinned machines directory."""
    name = private_basename(path.name)
    if path != paths["machines"] / name:
        fail("Podman known_hosts pin path is outside the machines directory")
    directory_fd = paths.descriptor("machines")
    revalidate_directory_path(
        paths["machines"],
        directory_fd,
        "Podman machines state directory",
    )
    return directory_fd, name


def open_known_hosts_snapshot(
    paths: StateDirectories,
    path: pathlib.Path,
    *,
    allow_empty: bool,
) -> tuple[int, FileIdentity]:
    """Open and validate one exact machine pin through its pinned parent."""
    directory_fd, name = known_hosts_location(paths, path)
    descriptor: int | None = None
    try:
        descriptor = os.open(
            name,
            os.O_RDWR | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=directory_fd,
        )
        os.set_inheritable(descriptor, False)
        opened = os.fstat(descriptor)
        lexical = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        identity = validate_private_file(
            opened,
            "Podman known_hosts pin",
            maximum=MAX_KNOWN_HOSTS_BYTES,
        )
        if (not allow_empty and identity.size == 0) or identity != file_identity(
            lexical
        ):
            fail("Podman known_hosts pin is unsafe or changed while opening")
        payload = read_bounded_descriptor(descriptor, MAX_KNOWN_HOSTS_BYTES)
        finished = os.fstat(descriptor)
        current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (
            identity != file_identity(finished)
            or identity != file_identity(current)
            or len(payload) != identity.size
        ):
            fail("Podman known_hosts pin changed while reading")
        validate_known_hosts_payload(payload, allow_empty=allow_empty)
        revalidate_directory_path(
            paths["machines"],
            directory_fd,
            "Podman machines state directory",
        )
        retained = descriptor
        descriptor = None
        return retained, identity
    except OSError as error:
        raise EditorError(f"could not open Podman known_hosts pin: {error}") from error
    finally:
        if descriptor is not None:
            with contextlib.suppress(OSError):
                os.close(descriptor)


def known_hosts_identity(
    paths: StateDirectories, path: pathlib.Path, *, allow_empty: bool
) -> FileIdentity:
    """Return one descriptor-validated machine-pin identity."""
    descriptor, identity = open_known_hosts_snapshot(
        paths,
        path,
        allow_empty=allow_empty,
    )
    os.close(descriptor)
    return identity


def same_known_hosts_authority(left: FileIdentity, right: FileIdentity) -> bool:
    """Compare immutable authority fields while allowing SSH to append a key."""
    return (
        left.device,
        left.inode,
        left.mode,
        left.links,
        left.owner,
    ) == (
        right.device,
        right.inode,
        right.mode,
        right.links,
        right.owner,
    )


def persist_known_hosts(
    paths: StateDirectories,
    path: pathlib.Path,
    expected: FileIdentity,
) -> None:
    """Durably commit the originally opened host-key pin and directory entry."""
    directory_fd, name = known_hosts_location(paths, path)
    descriptor, current = open_known_hosts_snapshot(
        paths,
        path,
        allow_empty=False,
    )
    try:
        if not same_known_hosts_authority(expected, current):
            fail("Podman known_hosts pin authority changed during enrollment")
        os.fsync(descriptor)
        durable = os.fstat(descriptor)
        lexical = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if current != file_identity(durable) or current != file_identity(lexical):
            fail("Podman known_hosts pin changed during persistence")
    except OSError as error:
        raise EditorError(
            f"could not persist Podman known_hosts pin: {error}"
        ) from error
    finally:
        with contextlib.suppress(OSError):
            os.close(descriptor)
    revalidate_directory_path(
        paths["machines"],
        directory_fd,
        "Podman machines state directory",
    )
    fsync_directory(directory_fd, "Podman known_hosts pin directory")


def retire_new_known_hosts(
    paths: StateDirectories,
    path: pathlib.Path,
    expected: FileIdentity,
) -> None:
    """Durably retire only the exact empty pin created for failed first use."""
    directory_fd, name = known_hosts_location(paths, path)
    if not retire_expected_private_file_at(directory_fd, name, expected):
        fail("failed first-use Podman known_hosts pin disappeared during cleanup")
    fsync_directory(directory_fd, "failed first-use Podman known_hosts cleanup")


def reconcile_failed_known_hosts(
    paths: StateDirectories,
    path: pathlib.Path,
    expected: FileIdentity,
    initially_empty: bool,
    primary: BaseException,
) -> None:
    """Persist learned trust or retire only the same still-empty failed pin."""
    try:
        current = known_hosts_identity(paths, path, allow_empty=True)
        if not same_known_hosts_authority(expected, current):
            fail("Podman known_hosts pin authority changed during enrollment")
        if initially_empty and current.size == 0:
            retire_new_known_hosts(paths, path, expected)
        else:
            persist_known_hosts(paths, path, expected)
    except BaseException as cleanup:  # noqa: BLE001 - preserve primary control flow
        report_cleanup_failure(
            primary,
            "Podman known_hosts failure reconciliation failed",
            cleanup,
        )


def inspect_known_hosts(
    machine: PodmanMachine,
) -> pathlib.Path | None:
    """Read-only validate an existing machine pin for ``doctor``."""
    machines = state_root() / "machines"
    try:
        details = machines.lstat()
    except FileNotFoundError:
        return None
    except OSError as error:
        raise EditorError(
            f"could not inspect Podman machines state: {error}"
        ) from error
    if (
        stat.S_ISLNK(details.st_mode)
        or not stat.S_ISDIR(details.st_mode)
        or details.st_uid != os.getuid()
        or stat.S_IMODE(details.st_mode) != 0o700
    ):
        fail("Podman machines state directory is unsafe")
    path = machines / f"{machine.pin_id}.known_hosts"
    try:
        path.lstat()
    except FileNotFoundError:
        return None
    except OSError as error:
        raise EditorError(
            f"could not inspect Podman known_hosts pin: {error}"
        ) from error
    validate_known_hosts(path, allow_empty=False)
    return path


def remote_shell_command(script: str, arguments: Sequence[str]) -> str:
    """Quote one fixed remote shell program and its already-validated arguments."""
    return shlex.join(["/bin/sh", "-c", script, "nvim-agent", *arguments])


def ssh_argument_path(path: pathlib.PurePath, label: str) -> str:
    """Require a path with no OpenSSH token or config-value metacharacters."""
    value = os.fspath(path)
    if SSH_ARGUMENT_PATH_RE.fullmatch(value) is None:
        fail(f"{label} contains unsupported OpenSSH path characters")
    return value


def ssh_base_argv(
    machine: PodmanMachine,
    known_hosts: pathlib.Path,
    *,
    accept_new: bool,
) -> list[str]:
    """Build the hardened OpenSSH transport prefix for a loopback VM endpoint."""
    alias = f"nvim-podman-{machine.pin_id}"
    known_hosts_value = ssh_argument_path(known_hosts, "Podman known_hosts pin")
    identity_value = ssh_argument_path(machine.identity, "Podman Machine identity")
    strictness = "accept-new" if accept_new else "yes"
    return [
        "/usr/bin/ssh",
        "-F",
        "/dev/null",
        "-T",
        "-x",
        "-a",
        "-oBatchMode=yes",
        "-oIdentitiesOnly=yes",
        "-oIdentityAgent=none",
        "-oIdentityFile=none",
        "-oExitOnForwardFailure=yes",
        "-oControlMaster=no",
        "-oControlPath=none",
        "-oProxyCommand=none",
        "-oProxyJump=none",
        "-oPermitLocalCommand=no",
        "-oRequestTTY=no",
        "-oForwardAgent=no",
        "-oForwardX11=no",
        "-oTunnel=no",
        "-oConnectTimeout=5",
        "-oServerAliveInterval=5",
        "-oServerAliveCountMax=2",
        "-oPasswordAuthentication=no",
        "-oKbdInteractiveAuthentication=no",
        "-oPreferredAuthentications=publickey",
        f"-oStrictHostKeyChecking={strictness}",
        "-oUpdateHostKeys=no",
        f"-oHostname={machine.host}",
        f"-oUserKnownHostsFile={known_hosts_value}",
        "-oGlobalKnownHostsFile=/dev/null",
        f"-oHostKeyAlias={alias}",
        "-i",
        identity_value,
        "-p",
        str(machine.port),
        "-l",
        machine.user,
        machine.host,
    ]


def attested_relay_container(
    docker: str,
    root: pathlib.Path,
    config: pathlib.Path,
    container_id: str,
    env: Mapping[str, str] | None,
) -> Mapping[str, object]:
    """Require one exact running host-network Podman Dev Container."""
    container_id = full_container_id(container_id, "Podman relay container id")
    records = podman_json_list(
        bounded_json_command(
            [docker, "inspect", "--type", "container", "--", container_id],
            "podman container inspect",
            env=env,
        ),
        "podman container inspect",
    )
    if len(records) != 1 or records[0].get("Id") != container_id:
        fail("Podman relay container inspect is missing or ambiguous")
    record = records[0]
    state = record.get("State")
    configuration = record.get("Config")
    host = record.get("HostConfig")
    if not isinstance(state, dict) or state.get("Running") is not True:
        fail("Podman relay container is not running")
    if not isinstance(configuration, dict) or not isinstance(host, dict):
        fail("Podman relay container metadata is incomplete")
    labels = configuration.get("Labels")
    expected_labels = {
        "devcontainer.local_folder": str(root),
        "devcontainer.config_file": str(config),
    }
    if not isinstance(labels, dict) or any(
        labels.get(name) != value for name, value in expected_labels.items()
    ):
        fail("Podman relay container labels do not match this workspace")
    if host.get("NetworkMode") != "host":
        fail("Podman SSH-agent relay requires the Dev Container network mode host")
    return record


def full_container_id(value: object, label: str) -> str:
    """Require one complete lowercase hexadecimal container identity."""
    if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
        fail(f"{label} is not a full hexadecimal identity")
    return value


class PodmanAgentRelay:
    """Own the authenticated host gate, VM loopback forward, and container proxy."""

    def __init__(
        self,
        paths: StateDirectories,
        root: pathlib.Path,
        forwarding: AgentForwarding,
        docker: str,
    ) -> None:
        """Bind the relay to one validated Podman forwarding plan."""
        if forwarding.transport != "podman-machine-relay":
            fail("Podman relay requires a relay forwarding plan")
        if forwarding.host is None:
            fail("Podman relay host-agent metadata is missing")
        self.paths = paths
        self.root = root
        self.forwarding = forwarding
        self.docker = docker
        self.gate = HostAgentGate(paths, forwarding.host)
        self.port: int | None = None
        self.process: subprocess.Popen[bytes] | None = None
        self.proxy_process: subprocess.Popen[bytes] | None = None
        self.stderr = bytearray()
        self.proxy_stderr = bytearray()
        self.closed = False
        self.failure: str | None = None

    @property
    def machine(self) -> PodmanMachine:
        """Return the plan's required validated machine metadata."""
        if self.forwarding.machine is None:
            fail("Podman relay machine metadata is missing")
        return self.forwarding.machine

    @property
    def host_agent(self) -> HostAgentSnapshot:
        """Return the plan's required validated host socket snapshot."""
        if self.forwarding.host is None:
            fail("Podman relay host-agent metadata is missing")
        return self.forwarding.host

    @property
    def container_socket(self) -> str:
        """Return this lifecycle's unpredictable validated proxy pathname."""
        return validated_relay_agent_socket(self.forwarding.container_socket)

    def _probe_remote(
        self,
        known_hosts: pathlib.Path,
        *,
        accept_new: bool,
    ) -> None:
        """Enroll or verify the exact Podman Machine host key and SSH endpoint."""
        command = [
            *ssh_base_argv(
                self.machine,
                known_hosts,
                accept_new=accept_new,
            ),
            remote_shell_command("true", []),
        ]
        result, overflow = run_bounded_capture(
            command,
            timeout=RELAY_TIMEOUT_SECONDS,
            stdout_limit=4096,
        )
        detail = bounded_log_detail(result.stderr.decode("utf-8", "replace")).strip()
        if result.returncode != 0:
            message = "could not authenticate the Podman Machine relay endpoint"
            fail(message + (f": {detail}" if detail else ""))
        if overflow or result.stdout:
            fail("Podman Machine relay endpoint probe output is invalid")
        validate_known_hosts(known_hosts, allow_empty=False)

    def _prepare_first_pinned_remote(self) -> pathlib.Path:
        """Serialize host-key enrollment and verify the selected machine endpoint."""
        with machine_pin_lock(self.paths, self.machine):
            known_hosts = prepare_known_hosts(self.paths, self.machine)
            expected = known_hosts_identity(
                self.paths,
                known_hosts,
                allow_empty=True,
            )
            initially_empty = expected.size == 0
            try:
                self._probe_remote(known_hosts, accept_new=initially_empty)
                persist_known_hosts(self.paths, known_hosts, expected)
            except BaseException as primary:
                reconcile_failed_known_hosts(
                    self.paths,
                    known_hosts,
                    expected,
                    initially_empty,
                    primary,
                )
                raise
            return known_hosts

    def _relay_argv(self, known_hosts: pathlib.Path, nonce: str) -> list[str]:
        """Build the VM-loopback-only reverse TCP forwarding command."""
        if self.port is None:
            fail("Podman SSH-agent relay port has not been selected")
        gate_path = ssh_argument_path(self.gate.path, "host SSH-agent gate")
        reverse = f"127.0.0.1:{self.port}:{gate_path}"
        command = remote_shell_command(REMOTE_AGENT_READY, [str(self.port), nonce])
        base = ssh_base_argv(self.machine, known_hosts, accept_new=False)
        return [*base[:-1], "-R", reverse, base[-1], command]

    @staticmethod
    def _new_relay_port(attempted: set[int]) -> int:
        """Choose a fresh ephemeral-range port for this bounded start sequence."""
        port = 49152 + secrets.randbelow(16384)
        while port in attempted:
            port = 49152 + ((port - 49152 + 1) % 16384)
        attempted.add(port)
        return port

    @staticmethod
    def _remember_stderr(tail: bytearray, payload: bytes) -> None:
        """Retain a bounded diagnostic tail while draining every received byte."""
        tail.extend(payload)
        if len(tail) > MAX_RELAY_STDERR_BYTES:
            del tail[:-MAX_RELAY_STDERR_BYTES]

    def _diagnostic_message(self, message: str) -> str:
        """Attach bounded, terminal-safe SSH and proxy diagnostic tails."""
        details = []
        for label, tail in (
            ("ssh", getattr(self, "stderr", bytearray())),
            ("proxy", getattr(self, "proxy_stderr", bytearray())),
        ):
            detail = bounded_log_detail(tail.decode("utf-8", "replace")).strip()
            if detail:
                details.append(f"{label}: {detail}")
        return message + (f": {'; '.join(details)}" if details else "")

    def _consume_readiness_events(
        self,
        selector: selectors.BaseSelector,
        events: Sequence[tuple[selectors.SelectorKey, int]],
        output: bytearray,
        tail: bytearray,
        label: str,
    ) -> None:
        """Drain one readiness poll without retaining unbounded output."""
        for key, _mask in events:
            try:
                payload = os.read(key.fileobj.fileno(), STREAM_CHUNK_BYTES)
            except BlockingIOError:
                continue
            except OSError as error:
                raise EditorError(
                    self._diagnostic_message(
                        f"could not read {label} readiness: {error}"
                    )
                ) from error
            if not payload:
                selector.unregister(key.fileobj)
            elif key.data == "stderr":
                self._remember_stderr(tail, payload)
            elif len(output) + len(payload) <= 256:
                output.extend(payload)
            else:
                fail(self._diagnostic_message(f"{label} readiness output is invalid"))

    def _wait_ready(
        self,
        nonce: str,
        process: subprocess.Popen[bytes] | None = None,
        label: str = "Podman SSH-agent relay",
        tail: bytearray | None = None,
    ) -> None:
        """Wait for one exact readiness nonce while draining both child pipes."""
        selected = process or self.process
        selected_tail = self.stderr if tail is None else tail
        if (
            selected is None
            or selected.stdin is None
            or selected.stdout is None
            or selected.stderr is None
        ):
            fail(f"{label} did not expose readiness pipes")
        output = bytearray()
        deadline = time.monotonic() + RELAY_TIMEOUT_SECONDS
        with selectors.DefaultSelector() as selector:
            for stream, stream_label in (
                (selected.stdout, "stdout"),
                (selected.stderr, "stderr"),
            ):
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ, stream_label)
            while b"\n" not in output:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    fail(self._diagnostic_message(f"timed out waiting for {label}"))
                events = selector.select(min(remaining, 0.1))
                self._consume_readiness_events(
                    selector, events, output, selected_tail, label
                )
                try:
                    exited = selected.poll() is not None
                except OSError as error:
                    raise EditorError(
                        self._diagnostic_message(f"could not inspect {label}: {error}")
                    ) from error
                if exited and b"\n" not in output:
                    fail(self._diagnostic_message(f"{label} exited before readiness"))
        if bytes(output) != f"{nonce}\n".encode("ascii"):
            fail(self._diagnostic_message(f"{label} readiness nonce did not match"))
        try:
            exited = selected.poll() is not None
        except OSError as error:
            raise EditorError(
                self._diagnostic_message(f"could not inspect {label}: {error}")
            ) from error
        if exited:
            fail(
                self._diagnostic_message(f"{label} exited immediately after readiness")
            )
        os.set_blocking(selected.stderr.fileno(), False)

    def start(self) -> None:
        """Start the private gate and its loopback-only Podman Machine forward."""
        if self.process is not None:
            self.check()
            return
        if self.failure is not None:
            fail(self.failure)
        if self.closed:
            fail("Podman SSH-agent relay is already closed")
        exact_executable_path("/usr/bin/ssh", "OpenSSH client")
        validate_machine_identity(self.machine)
        revalidate_host_agent(self.host_agent)
        known_hosts = self._prepare_first_pinned_remote()
        try:
            self.gate.start()
            attempted_ports: set[int] = set()
            for attempt in range(MAX_RELAY_START_ATTEMPTS):
                self.port = self._new_relay_port(attempted_ports)
                nonce = secrets.token_hex(32)
                self.process = subprocess.Popen(
                    self._relay_argv(known_hosts, nonce),
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    close_fds=True,
                    shell=False,
                )
                try:
                    self._wait_ready(nonce)
                except EditorError:
                    retry = (
                        attempt + 1 < MAX_RELAY_START_ATTEMPTS
                        and self._process_is_reaped(self.process)
                    )
                    if not retry:
                        raise
                    self._stop_process(self.process, "Podman SSH-agent relay")
                    self.process = None
                    self.stderr.clear()
                else:
                    break
            self.gate.check()
        except KeyboardInterrupt as error:
            failure = EditorError("Podman SSH-agent relay start was cancelled")
            self._stop_after_failure(failure)
            raise failure from error
        except OSError as error:
            failure = EditorError(f"could not start Podman SSH-agent relay: {error}")
            self._stop_after_failure(failure)
            raise failure from error
        except BaseException as error:
            self._stop_after_failure(error)
            raise

    def _proxy_argv(
        self,
        cli: str,
        config: pathlib.Path,
        container_id: str,
        nonce: str,
    ) -> list[str]:
        """Build an exact-ID Dev Containers exec for the remote-user proxy."""
        if self.port is None:
            fail("Podman SSH-agent relay port has not been selected")
        return [
            *self._container_exec_argv(cli, config, container_id),
            "/usr/bin/python3",
            "-I",
            "-S",
            "-c",
            CONTAINER_AGENT_PROXY,
            self.container_socket,
            str(self.port),
            nonce,
        ]

    def _container_exec_argv(
        self,
        cli: str,
        config: pathlib.Path,
        container_id: str,
    ) -> list[str]:
        """Build the exact-ID prefix shared by relay container probes."""
        return [
            cli,
            "exec",
            "--container-id",
            full_container_id(container_id, "Podman relay container id"),
            "--workspace-folder",
            str(self.root),
            "--config",
            str(config),
            "--docker-path",
            self.docker,
        ]

    def _probe_container_python(
        self,
        cli: str,
        config: pathlib.Path,
        container_id: str,
        env: Mapping[str, str] | None,
    ) -> None:
        """Require the exact remote user to execute the proxy runtime."""
        command = [
            *self._container_exec_argv(cli, config, container_id),
            "/usr/bin/test",
            "-x",
            "/usr/bin/python3",
        ]
        result, overflow = run_bounded_capture(
            command,
            timeout=RELAY_TIMEOUT_SECONDS,
            stdout_limit=4096,
            env=env,
        )
        if result.returncode != 0 or overflow or result.stdout:
            detail = bounded_log_detail(
                result.stderr.decode("utf-8", "replace")
            ).strip()
            message = "Podman SSH-agent relay requires executable /usr/bin/python3"
            fail(message + (f": {detail}" if detail else ""))

    def start_container_proxy(
        self,
        cli: str,
        config: pathlib.Path,
        container_id: str,
        env: Mapping[str, str] | None,
    ) -> None:
        """Attest the container and start its remote-user-owned Unix proxy."""
        if self.proxy_process is not None:
            self.check()
            return
        if self.process is None or self.closed:
            fail("Podman SSH-agent relay must be running before its container proxy")
        attested_relay_container(self.docker, self.root, config, container_id, env)
        self._probe_container_python(cli, config, container_id, env)
        nonce = secrets.token_hex(32)
        try:
            self.proxy_process = subprocess.Popen(
                self._proxy_argv(cli, config, container_id, nonce),
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=dict(env) if env is not None else None,
                close_fds=True,
                shell=False,
            )
            if self.proxy_process.stdin is None:
                fail("Podman SSH-agent container proxy did not expose its stdin leash")
            self.proxy_process.stdin.write(self.gate.token_line)
            self.proxy_process.stdin.flush()
            self._wait_ready(
                nonce,
                self.proxy_process,
                "Podman SSH-agent container proxy",
                self.proxy_stderr,
            )
            attested_relay_container(self.docker, self.root, config, container_id, env)
            self.check()
        except KeyboardInterrupt as error:
            failure = EditorError("Podman SSH-agent container proxy was cancelled")
            self._stop_after_failure(failure)
            raise failure from error
        except OSError as error:
            failure = EditorError(
                f"could not start Podman SSH-agent container proxy: {error}"
            )
            self._stop_after_failure(failure)
            raise failure from error
        except BaseException as error:
            self._stop_after_failure(error)
            raise

    def _stop_after_failure(self, primary: BaseException) -> None:
        """Stop every partial relay component without hiding its trigger."""
        try:
            self._stop_owned_components()
        except EditorError as cleanup:
            report_cleanup_failure(primary, "SSH-agent relay cleanup failed", cleanup)

    def _drain_process_stderr(
        self,
        process: subprocess.Popen[bytes] | None,
        tail: bytearray,
        label: str,
    ) -> None:
        """Drain currently available diagnostics from one supervised child."""
        if process is None or process.stderr is None or process.stderr.closed:
            return
        remaining = MAX_RELAY_DRAIN_BYTES
        while remaining > 0:
            try:
                payload = os.read(
                    process.stderr.fileno(), min(STREAM_CHUNK_BYTES, remaining)
                )
            except BlockingIOError:
                return
            except (OSError, ValueError) as error:
                raise EditorError(
                    f"could not drain {label} diagnostics: {error}"
                ) from error
            if not payload:
                return
            self._remember_stderr(tail, payload)
            remaining -= len(payload)

    def _drain_stderr(self) -> None:
        """Drain diagnostics from both supervised relay processes."""
        self._drain_process_stderr(
            getattr(self, "process", None),
            getattr(self, "stderr", bytearray()),
            "Podman SSH-agent relay",
        )
        self._drain_process_stderr(
            getattr(self, "proxy_process", None),
            getattr(self, "proxy_stderr", bytearray()),
            "Podman SSH-agent container proxy",
        )

    def _failed_process_message(self) -> str | None:
        """Return a diagnostic if either supervised child has exited."""
        for label, process in (
            ("Podman SSH-agent relay", getattr(self, "process", None)),
            (
                "Podman SSH-agent container proxy",
                getattr(self, "proxy_process", None),
            ),
        ):
            if process is not None:
                try:
                    code = process.poll()
                except OSError as error:
                    return self._diagnostic_message(
                        f"could not inspect {label}: {error}"
                    )
                if code is not None:
                    return self._diagnostic_message(f"{label} exited {code}")
        return None

    def check(self) -> None:
        """Revalidate authority and require all started components to be alive."""
        if self.failure is not None:
            fail(self.failure)
        if self.process is None or self.closed:
            return
        validate_machine_identity(self.machine)
        self.gate.check()
        self._drain_stderr()
        message = self._failed_process_message()
        if message is None:
            return
        try:
            self._stop_owned_components()
        except EditorError as cleanup:
            message = f"{message}; cleanup failed: {cleanup}"
        self.failure = message
        fail(message)

    @staticmethod
    def _wait_process(process: subprocess.Popen[bytes], timeout: float) -> bool:
        """Wait through cleanup interruptions and report whether the child exited."""
        try:
            process.wait(timeout=timeout)
            return True
        except (OSError, subprocess.TimeoutExpired, KeyboardInterrupt):
            pass
        try:
            return process.poll() is not None
        except (OSError, KeyboardInterrupt):
            return False

    def _stop_process(
        self,
        process: subprocess.Popen[bytes] | None,
        label: str,
        *,
        require_clean_exit: bool = False,
        stderr_tail: bytearray | None = None,
    ) -> None:
        """Close a stdin leash, then terminate, kill, and reap if necessary."""
        if process is None:
            return
        if process.stdin is not None and not process.stdin.closed:
            with contextlib.suppress(OSError):
                process.stdin.close()
        graceful = self._wait_process(process, 2.0)
        stopped = graceful
        if not stopped:
            with contextlib.suppress(OSError):
                process.terminate()
            stopped = self._wait_process(process, 2.0)
        if not stopped:
            with contextlib.suppress(OSError):
                process.kill()
            stopped = self._wait_process(process, 2.0)
        failures: list[str] = []
        if not stopped:
            failures.append(f"could not reap the {label} process")
        elif graceful and require_clean_exit:
            try:
                self._drain_process_stderr(
                    process,
                    stderr_tail if stderr_tail is not None else bytearray(),
                    label,
                )
            except EditorError as error:
                failures.append(str(error))
            try:
                code = process.poll()
            except OSError as error:
                failures.append(f"could not inspect {label} after cleanup: {error}")
            else:
                if code is None:
                    failures.append(f"could not confirm the {label} process exit")
                elif code != 0:
                    failures.append(self._diagnostic_message(f"{label} exited {code}"))
        for stream in (process.stdout, process.stderr):
            if stream is not None and not stream.closed:
                with contextlib.suppress(OSError):
                    stream.close()
        if failures:
            fail("; ".join(failures))

    @staticmethod
    def _process_is_reaped(process: subprocess.Popen[bytes] | None) -> bool:
        """Report whether a failed cleanup already reaped its owned process."""
        if process is None:
            return True
        try:
            return process.poll() is not None
        except OSError:
            return False

    def _stop_owned_components(self) -> None:
        """Attempt every component cleanup in dependency order."""
        failures: list[str] = []
        for attribute, label in (
            ("proxy_process", "Podman SSH-agent container proxy"),
            ("process", "Podman SSH-agent relay"),
        ):
            process = getattr(self, attribute)
            try:
                self._stop_process(
                    process,
                    label,
                    require_clean_exit=attribute == "proxy_process",
                    stderr_tail=(
                        self.proxy_stderr if attribute == "proxy_process" else None
                    ),
                )
            except EditorError as error:
                failures.append(str(error))
                if self._process_is_reaped(process):
                    setattr(self, attribute, None)
            else:
                setattr(self, attribute, None)
        try:
            self.gate.close()
        except EditorError as error:
            failures.append(str(error))
        if failures:
            fail("; ".join(failures))

    def close(self) -> None:
        """Stop and reap proxy, SSH forward, and gate exactly once."""
        if self.closed:
            return
        self._stop_owned_components()
        self.closed = True


def lockfile_path(config: pathlib.Path) -> pathlib.Path:
    """Return the Dev Containers lockfile adjacent to one configuration.

    :param config: Canonical Dev Container configuration path.
    """
    return config.with_name(f"{config.stem}-lock.json")


def preserve_lockfile_flag(
    cli: str,
    docker: str,
    config: pathlib.Path,
    env: Mapping[str, str] | None = None,
) -> str:
    """Probe used CLI surfaces and preserve lockfile state fail closed.

    :param cli: Absolute Dev Containers CLI executable.
    :param docker: Absolute Docker-compatible engine executable.
    :param config: Canonical Dev Container configuration path.
    :raises EditorError: If capability probing or lockfile inspection fails.
    """
    representative_mount = mount_argument(
        pathlib.Path("/"), "/tmp/nvim-devcontainer-capability-probe"
    )
    up_result = run(
        [
            cli,
            "up",
            "--help",
            "--docker-path",
            docker,
            "--mount",
            representative_mount,
        ],
        timeout=5.0,
        check=False,
        env=env,
    )
    exec_result = run(
        [cli, "exec", "--help", "--docker-path", docker],
        timeout=5.0,
        check=False,
        env=env,
    )
    user_commands_result = run(
        [cli, "run-user-commands", "--help", "--docker-path", docker],
        timeout=5.0,
        check=False,
        env=env,
    )
    try:
        up_help = (up_result.stdout + up_result.stderr).decode("utf-8", "strict")
        exec_help = (exec_result.stdout + exec_result.stderr).decode("utf-8", "strict")
        user_commands_help = (
            user_commands_result.stdout + user_commands_result.stderr
        ).decode("utf-8", "strict")
    except UnicodeError as error:
        raise EditorError(
            "Dev Containers CLI capability output is not UTF-8"
        ) from error
    missing_up = UP_REQUIRED_OPTIONS - set(up_help.split())
    missing_exec = EXEC_REQUIRED_OPTIONS - set(exec_help.split())
    missing_user_commands = RUN_USER_COMMANDS_REQUIRED_OPTIONS - set(
        user_commands_help.split()
    )
    if up_result.returncode != 0 or missing_up:
        fail("Dev Containers CLI does not support the required up options")
    if exec_result.returncode != 0 or missing_exec:
        fail("Dev Containers CLI does not support the required exec options")
    if user_commands_result.returncode != 0 or missing_user_commands:
        fail(
            "Dev Containers CLI does not support the required run-user-commands options"
        )
    lockfile = lockfile_path(config)
    try:
        details = lockfile.lstat()
    except FileNotFoundError:
        return "--no-lockfile"
    except OSError as error:
        raise EditorError(
            f"could not inspect Dev Container lockfile: {error}"
        ) from error
    if stat.S_ISLNK(details.st_mode) or not stat.S_ISREG(details.st_mode):
        fail("Dev Container lockfile is not one regular non-symlink file")
    return "--frozen-lockfile"


def probe_version(executable: str, label: str) -> str:
    """Read one runtime version without starting or mutating a container."""
    result = run([executable, "--version"], timeout=5.0, check=False)
    if result.returncode != 0:
        fail(f"{label} version probe failed")
    try:
        output = (result.stdout + result.stderr).decode("utf-8", "strict").strip()
    except UnicodeError as error:
        raise EditorError(f"{label} version output is not UTF-8") from error
    if not output or len(output) > 4096 or "\0" in output:
        fail(f"{label} version output is invalid")
    return output


def mount_argument(source: pathlib.Path, target: str) -> str:
    """Build one bind mount in the official Dev Containers CLI grammar."""
    source_text = os.fspath(source)
    if any(
        character in source_text or character in target
        for character in (",", "\n", "\r", "\0")
    ):
        fail("Dev Container mount paths contain an unsupported delimiter")
    if not source_text.startswith("/") or not canonical_posix_absolute(target):
        fail("Dev Container mount paths must be absolute and lexically normalized")
    return f"type=bind,source={source_text},target={target}"


def normalized_forwarding(
    agent: AgentForwarding | HostAgentSnapshot | pathlib.Path | None,
) -> AgentForwarding:
    """Normalize legacy direct-socket inputs used by internal tests and callers."""
    if isinstance(agent, AgentForwarding):
        return agent
    if agent is None:
        return AgentForwarding("disabled", None, None, None, None)
    if isinstance(agent, pathlib.Path):
        return AgentForwarding("direct-bind", None, None, agent, DIRECT_AGENT_SOCKET)
    snapshot = agent
    return AgentForwarding(
        "direct-bind", snapshot, None, snapshot.path, DIRECT_AGENT_SOCKET
    )


def up_argv(
    cli: str,
    docker: str,
    root: pathlib.Path,
    config: pathlib.Path,
    spool: pathlib.Path,
    recreate: bool,
    agent: AgentForwarding | HostAgentSnapshot | pathlib.Path | None,
    lockfile_flag: str,
) -> tuple[list[str], str]:
    """Build the exact ``devcontainer up`` argv and remote spool path."""
    remote_spool = f"/tmp/nvim-devcontainer-{workspace_id(root)[:16]}"
    if lockfile_flag not in {"--frozen-lockfile", "--no-lockfile"}:
        fail("Dev Container lockfile flag is invalid")
    argv = [
        cli,
        "up",
        "--workspace-folder",
        str(root),
        "--config",
        str(config),
        "--docker-path",
        docker,
        "--log-format",
        "json",
        lockfile_flag,
        "--mount",
        mount_argument(spool, remote_spool),
    ]
    forwarding = normalized_forwarding(agent)
    if forwarding.transport == "direct-bind":
        if forwarding.mount_source is None or forwarding.container_socket is None:
            fail("direct SSH-agent forwarding plan is incomplete")
        argv.extend(
            [
                "--mount",
                mount_argument(forwarding.mount_source, forwarding.container_socket),
                "--remote-env",
                f"SSH_AUTH_SOCK={forwarding.container_socket}",
            ]
        )
    elif forwarding.transport == "podman-machine-relay":
        if forwarding.container_socket is None:
            fail("Podman SSH-agent relay forwarding plan is incomplete")
        argv.extend(
            [
                "--remote-env",
                f"SSH_AUTH_SOCK={forwarding.container_socket}",
                "--skip-post-create",
            ]
        )
    elif forwarding.transport != "disabled":
        fail("SSH-agent forwarding transport is invalid")
    if recreate:
        argv.append("--remove-existing-container")
    return argv, remote_spool


def run_user_commands_argv(
    cli: str,
    docker: str,
    root: pathlib.Path,
    config: pathlib.Path,
    container_id: str,
    socket_path: str,
) -> list[str]:
    """Build the exact post-proxy Dev Containers lifecycle-hook command."""
    container_id = full_container_id(container_id, "Podman relay container id")
    if not canonical_posix_absolute(socket_path):
        fail("container SSH-agent socket path is invalid")
    return [
        cli,
        "run-user-commands",
        "--container-id",
        container_id,
        "--workspace-folder",
        str(root),
        "--config",
        str(config),
        "--docker-path",
        docker,
        "--log-format",
        "json",
        "--remote-env",
        f"SSH_AUTH_SOCK={socket_path}",
    ]


def close_process_stream(selector: selectors.BaseSelector, stream: Any) -> None:
    """Unregister and close one completed subprocess pipe."""
    with contextlib.suppress(KeyError):
        selector.unregister(stream)
    with contextlib.suppress(OSError):
        stream.close()


def stop_and_reap_process(process: subprocess.Popen[bytes]) -> None:
    """Terminate and synchronously reap one streamed subprocess."""
    try:
        exited = process.poll() is not None
    except OSError:
        exited = False
    if exited:
        try:
            process.wait(timeout=0)
        except (OSError, subprocess.TimeoutExpired, KeyboardInterrupt):
            pass
        return
    with contextlib.suppress(OSError, KeyboardInterrupt):
        process.terminate()
    try:
        process.wait(timeout=2.0)
        return
    except (OSError, subprocess.TimeoutExpired, KeyboardInterrupt):
        with contextlib.suppress(OSError, KeyboardInterrupt):
            process.kill()
    try:
        process.wait(timeout=2.0)
    except (OSError, subprocess.TimeoutExpired, KeyboardInterrupt) as error:
        try:
            exited = process.poll() is not None
        except OSError:
            exited = False
        if not exited:
            raise EditorError("could not reap owned subprocess") from error


def capture_stdout_chunk(captured: bytearray, payload: bytes, overflow: bool) -> bool:
    """Retain only the bounded successful JSON projection while draining all bytes."""
    remaining = MAX_JSON_BYTES - len(captured)
    if remaining > 0:
        captured.extend(payload[:remaining])
    return overflow or len(payload) > remaining


def drain_ready_up_streams(
    selector: selectors.BaseSelector,
    events: Sequence[tuple[selectors.SelectorKey, int]],
    stdout: bytearray,
    stdout_overflow: bool,
    logs: DevcontainerLogStream,
) -> bool:
    """Drain every ready pipe once and return the accumulated stdout overflow flag."""
    for key, _mask in events:
        stream = key.fileobj
        try:
            payload = os.read(stream.fileno(), STREAM_CHUNK_BYTES)
        except BlockingIOError:
            continue
        except OSError as error:
            raise EditorError(
                f"could not read devcontainer up output: {error}"
            ) from error
        if not payload:
            close_process_stream(selector, stream)
        elif key.data == "stdout":
            stdout_overflow = capture_stdout_chunk(stdout, payload, stdout_overflow)
        else:
            logs.feed(payload)
    return stdout_overflow


def wait_for_up_process(
    process: subprocess.Popen[bytes],
    deadline: float,
    timeout: float,
    relay: PodmanAgentRelay | None,
) -> None:
    """Wait for process exit while continuing to supervise the agent relay."""
    while True:
        if relay is not None:
            relay.check()
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(process.args, timeout)
        try:
            process.wait(timeout=min(remaining, 0.1))
        except subprocess.TimeoutExpired:
            continue
        return


def drain_up_process(
    process: subprocess.Popen[bytes],
    timeout: float,
    logs: DevcontainerLogStream,
    relay: PodmanAgentRelay | None = None,
) -> tuple[bytes, bool]:
    """Concurrently drain both pipes until EOF under one monotonic deadline."""
    if process.stdout is None or process.stderr is None:
        fail("devcontainer up did not expose both output pipes")
    stdout = bytearray()
    stdout_overflow = False
    deadline = time.monotonic() + timeout
    with selectors.DefaultSelector() as selector:
        for stream, label in ((process.stdout, "stdout"), (process.stderr, "stderr")):
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, label)
        while selector.get_map():
            if relay is not None:
                relay.check()
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(process.args, timeout)
            try:
                events = selector.select(min(remaining, 0.1))
            except OSError as error:
                raise EditorError(
                    f"could not poll devcontainer up output: {error}"
                ) from error
            stdout_overflow = drain_ready_up_streams(
                selector,
                events,
                stdout,
                stdout_overflow,
                logs,
            )
    logs.finish()
    wait_for_up_process(process, deadline, timeout, relay)
    return bytes(stdout), stdout_overflow


def cleanup_streamed_up_process(
    process: subprocess.Popen[bytes], primary: BaseException | None
) -> None:
    """Reap one streamed child and close its pipes without masking failures."""
    cleanup_error: EditorError | None = None
    try:
        stop_and_reap_process(process)
    except EditorError as error:
        cleanup_error = error
    for stream in (process.stdout, process.stderr):
        if stream is not None and not stream.closed:
            with contextlib.suppress(OSError):
                stream.close()
    if cleanup_error is None:
        return
    if primary is None:
        raise cleanup_error
    report_cleanup_failure(primary, "devcontainer up cleanup failed", cleanup_error)


def run_streamed_up(
    command: Sequence[str],
    timeout: float,
    writer: LifecycleLogWriter,
    relay: PodmanAgentRelay | None = None,
    env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    """Run one ``devcontainer up`` while publishing stderr events live."""
    try:
        process = subprocess.Popen(
            list(command),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=dict(env) if env is not None else None,
            close_fds=True,
            shell=False,
        )
    except OSError as error:
        raise EditorError(f"could not run {command[0]}: {error}") from error
    logs = DevcontainerLogStream(writer)
    try:
        stdout, overflow = drain_up_process(process, timeout, logs, relay)
    except subprocess.TimeoutExpired as error:
        raise EditorError(
            f"could not run {command[0]}: timed out after {timeout:g} seconds"
        ) from error
    except KeyboardInterrupt as error:
        raise EditorError(f"{command[0]} was cancelled") from error
    except OSError as error:
        raise EditorError(f"could not run {command[0]}: {error}") from error
    finally:
        cleanup_streamed_up_process(process, sys.exc_info()[1])
    result = subprocess.CompletedProcess(
        list(command),
        process.returncode,
        stdout,
        logs.error_tail.encode("utf-8", "replace"),
    )
    if overflow:
        fail("devcontainer up JSON output exceeds 64 KiB")
    if result.returncode != 0:
        detail = logs.error_tail.strip()
        fail(detail or f"{command[0]} exited {result.returncode}")
    return result


def run_up_with_pinned_spool(
    command: Sequence[str],
    spool: SpoolDirectories,
    timeout: float,
    log: pathlib.Path,
    relay: PodmanAgentRelay | None = None,
    env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    """Run the external lifecycle across exact spool-path identity checks."""
    revalidate_directory_path(spool.root, spool.root_fd, "workspace spool")
    try:
        with LifecycleLogWriter(log) as writer:
            if relay is None:
                result = run_streamed_up(command, timeout, writer, env=env)
            else:
                result = run_streamed_up(command, timeout, writer, relay, env)
    except EditorError as primary:
        try:
            revalidate_directory_path(spool.root, spool.root_fd, "workspace spool")
        except EditorError as mismatch:
            raise EditorError(f"{primary}; {mismatch}") from primary
        raise
    revalidate_directory_path(spool.root, spool.root_fd, "workspace spool")
    return result


def run_user_commands_with_pinned_spool(
    command: Sequence[str],
    spool: SpoolDirectories,
    timeout: float,
    log: pathlib.Path,
    relay: PodmanAgentRelay,
    env: Mapping[str, str] | None,
) -> None:
    """Run deferred lifecycle hooks while supervising relay and spool authority."""
    run_up_with_pinned_spool(command, spool, timeout, log, relay, env)


def decode_up(result: subprocess.CompletedProcess[bytes]) -> tuple[str, str]:
    """Validate the exact successful ``devcontainer up`` projection."""
    if len(result.stdout) > MAX_JSON_BYTES:
        fail("devcontainer up JSON output exceeds 64 KiB")
    try:
        value = json.loads(result.stdout.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise EditorError(f"devcontainer up returned invalid JSON: {error}") from error
    if not isinstance(value, dict):
        fail("devcontainer up did not return one JSON object")
    container_id = value.get("containerId")
    container_root = value.get("remoteWorkspaceFolder")
    if not isinstance(container_id, str) or not container_id or "\0" in container_id:
        fail("devcontainer up returned an invalid container id")
    if not canonical_posix_absolute(container_root):
        fail("devcontainer up returned an invalid remote workspace folder")
    return container_id, container_root


def base_record(
    root: pathlib.Path,
    config: pathlib.Path,
    log: pathlib.Path,
    allow_network: bool,
    agent: AgentForwarding | HostAgentSnapshot | pathlib.Path | None,
    tmux_pane: str,
    pane_pid: int,
    claim_id: str,
) -> dict[str, object]:
    """Build the fail-closed starting lifecycle record."""
    guessed_root = f"/workspaces/{root.name}"
    return {
        "version": RECORD_VERSION,
        "host_root": str(root),
        "config_path": str(config),
        "container_root": guessed_root,
        "container_id": None,
        "claim_id": claim_id,
        "workspace_key": {
            "runtime": "container",
            "root": guessed_root,
            "repo_identity": str(root),
        },
        "pid": os.getpid(),
        "status": "starting",
        "phase": "claimed",
        "network_authorized": allow_network,
        "ssh_agent_forwarding": (
            agent.transport != "disabled"
            if isinstance(agent, AgentForwarding)
            else agent is not None
        ),
        "tmux_pane": tmux_pane,
        "pane_pid": pane_pid,
        "log_path": str(log),
        "updated_at": utc_now(),
        "exit_code": None,
        "error": None,
        "cli_path": None,
        "docker_path": None,
        "podman_connection": None,
    }


def remote_environment(
    record: Mapping[str, object],
    remote_spool: str,
    agent_socket: str = DIRECT_AGENT_SOCKET,
) -> list[str]:
    """Build explicit editor environment arguments for ``devcontainer exec``."""
    values = {
        "NVIM_DEVCONTAINER": "1",
        "NVIM_DEVCONTAINER_START_CLAIM_ID": str(record["claim_id"]),
        "NVIM_DEVCONTAINER_HOST_ROOT": str(record["host_root"]),
        "NVIM_DEVCONTAINER_CONTAINER_ROOT": str(record["container_root"]),
        "NVIM_DEVCONTAINER_SPOOL_ROOT": remote_spool,
        "NVIM_CONFIG_OFFLINE": "0" if record["network_authorized"] else "1",
        "NVIM_EXACT_EDITOR_RUNTIME": "container",
        "NVIM_EXACT_EDITOR_WORKSPACE_ROOT": str(record["container_root"]),
        "NVIM_EXACT_EDITOR_REPO_IDENTITY": str(record["host_root"]),
    }
    if record["ssh_agent_forwarding"]:
        values["SSH_AUTH_SOCK"] = agent_socket
    result: list[str] = []
    for name, value in sorted(values.items()):
        result.extend(["--remote-env", f"{name}={value}"])
    return result


def editor_argv(
    cli: str,
    docker: str,
    root: pathlib.Path,
    config: pathlib.Path,
    record: Mapping[str, object],
    remote_spool: str,
    agent_socket: str = DIRECT_AGENT_SOCKET,
    machine: PodmanMachine | None = None,
) -> list[str]:
    """Build the exact foreground container editor argv."""
    config_snapshot = remote_snapshot_path(remote_spool, record["claim_id"])
    command = [cli, "exec"]
    if machine is not None:
        command.extend(
            [
                "--container-id",
                full_container_id(record.get("container_id"), "recorded container id"),
            ]
        )
    command.extend(
        [
            "--workspace-folder",
            str(root),
            "--config",
            str(config),
            "--docker-path",
            docker,
            *remote_environment(record, remote_spool, agent_socket),
            "nvim",
            "-u",
            posixpath.join(config_snapshot, "init.lua"),
        ]
    )
    return pinned_engine_argv(command, machine)


def validate_host_request(value: object, token: str, name: str) -> dict[str, Any]:
    """Validate one authenticated container-to-host request."""
    if not isinstance(value, dict) or set(value) != HOST_REQUEST_KEYS:
        fail("host spool request schema is invalid")
    request_id = canonical_request_id(value.get("request_id"))
    if (
        value.get("version") != MESSAGE_VERSION
        or value.get("action") not in HOST_ACTIONS
        or not recent_timestamp(value.get("created_at"))
        or not valid_message_auth(token, "host_request", value)
    ):
        fail("host spool request authentication failed")
    if name != f"{request_id}.json":
        fail("host spool request filename does not match its id")
    return dict(value)


def tmux_action(record: Mapping[str, object], action: str) -> None:
    """Execute one checked host-owned action selected by the allowlist."""
    if action == "editor_ready":
        # Reaching this dispatcher is the acknowledgement: requests are only
        # consumed by monitor_editor after the exact pane has been verified,
        # the v5 record is running, and its running log entry was appended.
        return
    pane = record.get("tmux_pane")
    if action in {"tmux_dev_refresh_check", "tmux_dev_refresh"}:
        if not isinstance(pane, str) or not pane:
            fail("dev-session refresh requires the registered tmux pane")
        helper = pathlib.Path.home() / ".config/tmux/scripts/dev-session-refresh.sh"
        if not helper.is_file() or not os.access(helper, os.X_OK):
            fail(f"tmux dev-session helper is not executable: {helper}")
        operation = "check" if action.endswith("check") else "schedule"
        run([str(helper), operation, pane], timeout=30.0)
        return
    tmux = shutil.which("tmux")
    if not valid_tmux_pane(pane) or not tmux:
        fail("host action requires the registered tmux pane")
    repo = str(record["host_root"])
    if action == "lazygit":
        session = run([tmux, "display-message", "-p", "-t", pane, "#{session_name}"])
        name = session.stdout.decode("utf-8", "replace").strip()
        if not name or "\0" in name or "\n" in name:
            fail("tmux returned an invalid session name")
        run([tmux, "select-window", "-t", name + ":=git"])
    elif action == "container_log":
        command = shlex.join(
            [str(pathlib.Path(__file__).resolve()), "log", "--repo", repo, "--pager"]
        )
        run(
            [
                tmux,
                "display-popup",
                "-E",
                "-t",
                pane,
                "-d",
                repo,
                "-w",
                "90%",
                "-h",
                "80%",
                "-T",
                " Dev Container log ",
                command,
            ],
        )


def pane_marker(root: pathlib.Path) -> str:
    """Return the exact marker binding one tmux pane to a workspace."""
    return f"nvim-devcontainer:{workspace_id(root)}"


def observe_pane(record: Mapping[str, object]) -> PaneObservation:
    """Read and validate the exact tmux pane lifecycle projection."""
    pane = record.get("tmux_pane")
    tmux = shutil.which("tmux")
    if not valid_tmux_pane(pane) or not tmux:
        fail("lifecycle requires the registered tmux pane")
    result = run(
        [tmux, "display-message", "-p", "-t", str(pane), PANE_FORMAT], timeout=5.0
    )
    fields = result.stdout.decode("utf-8", "replace").rstrip("\n").split("\t")
    if len(fields) != 4 or fields[0] not in {"0", "1"} or not fields[1].isdigit():
        fail("tmux returned an invalid pane observation")
    exit_code: int | None = None
    if fields[2]:
        try:
            exit_code = int(fields[2])
        except ValueError as error:
            raise EditorError("tmux returned an invalid pane exit status") from error
    dead = fields[0] == "1"
    if dead and exit_code is None:
        fail("tmux omitted the dead pane exit status")
    return PaneObservation(dead, int(fields[1]), exit_code, fields[3])


def parse_host_pane_snapshot(payload: bytes) -> HostPaneSnapshot:
    """Decode one strict atomic host-pane projection from tmux."""
    try:
        output = payload.decode("utf-8")
    except UnicodeDecodeError as error:
        raise EditorError("tmux returned an invalid host pane observation") from error
    if output.count("\n") != 1 or not output.endswith("\n") or "\r" in output:
        fail("tmux returned an invalid host pane observation")
    fields = output[:-1].split("\t")
    if (
        len(fields) != 8
        or fields[1] not in {"0", "1"}
        or not fields[2].isdigit()
        or not fields[4].isdigit()
    ):
        fail("tmux returned an invalid host pane observation")
    return HostPaneSnapshot(
        fields[0],
        fields[1] == "1",
        int(fields[2]),
        fields[3],
        int(fields[4]),
        fields[5],
        fields[6],
        fields[7],
    )


def observe_host_pane_for_adoption(pane: str) -> HostPaneSnapshot:
    """Read every host-editor adoption predicate in one tmux observation."""
    tmux = shutil.which("tmux")
    if not tmux:
        fail("tmux is unavailable")
    result = run(
        [tmux, "display-message", "-p", "-t", pane, HOST_ADOPTION_FORMAT],
        timeout=5.0,
    )
    return parse_host_pane_snapshot(result.stdout)


def adopt_restarted_host_pane(
    record: Mapping[str, object], requested_pane: str
) -> PaneObservation:
    """Verify and adopt an exact host editor whose pane PID changed."""
    if record.get("status") not in INACTIVE_LIFECYCLE_STATUSES:
        fail("only an inactive Dev Container lifecycle can adopt a restarted host pane")
    registered_pane = record.get("tmux_pane")
    if requested_pane != registered_pane or not valid_tmux_pane(requested_pane):
        fail("host pane does not match the workspace record")
    snapshot = observe_host_pane_for_adoption(requested_pane)
    if snapshot.pane != registered_pane:
        fail("tmux host pane identity does not match the workspace record")
    if snapshot.dead or snapshot.pid < 1 or snapshot.pid == record.get("pane_pid"):
        fail("tmux host pane does not have a live replacement PID")
    if snapshot.window_name != "editor" or snapshot.window_panes != 1:
        fail("tmux host pane is not the single-pane editor window")
    if snapshot.current_command != "nvim" or snapshot.marker:
        fail("tmux host pane is not an unmarked host Neovim process")
    try:
        current_root = canonical_root(snapshot.current_path)
    except EditorError as error:
        raise EditorError(
            "tmux host pane cwd is not the canonical workspace root"
        ) from error
    if snapshot.current_path != str(current_root) or current_root != pathlib.Path(
        str(record["host_root"])
    ):
        fail("tmux host pane cwd is not the canonical workspace root")
    return PaneObservation(False, snapshot.pid, None, "")


def verify_container_pane(record: Mapping[str, object]) -> PaneObservation:
    """Require an alive pane process carrying this workspace's exact marker."""
    observation = observe_pane(record)
    expected = pane_marker(pathlib.Path(str(record["host_root"])))
    if observation.dead or observation.pid < 1 or observation.marker != expected:
        fail("tmux did not verify the Dev Container editor pane")
    return observation


def verify_registered_container_pane(
    record: Mapping[str, object],
    *,
    allow_dead: bool,
) -> PaneObservation:
    """Require the exact registered pane PID and workspace marker."""
    observation = observe_pane(record)
    expected = pane_marker(pathlib.Path(str(record["host_root"])))
    if (
        (observation.dead and not allow_dead)
        or observation.pid != record.get("pane_pid")
        or observation.marker != expected
    ):
        fail("tmux pane no longer matches the registered Dev Container editor")
    return observation


def atomic_pane_respawn(
    tmux: str,
    pane: str,
    before: PaneObservation,
    expected_marker: str,
    commands: Sequence[Sequence[str]],
) -> int:
    """Run a pane replacement only if its exact observed state still matches."""
    marker_prefix = "nvim-devcontainer:"
    marker_digest = expected_marker.removeprefix(marker_prefix)
    valid_marker = expected_marker == "" or (
        expected_marker.startswith(marker_prefix)
        and len(marker_digest) == 64
        and all(character in "0123456789abcdef" for character in marker_digest)
    )
    if before.pid < 1 or not valid_marker:
        fail("atomic tmux pane transition received invalid expected state")
    claim = str(uuid.uuid4())
    expected = f"{int(before.dead)}|{before.pid}|{expected_marker}"
    condition = (
        f"#{{==:#{{pane_dead}}|#{{pane_pid}}|#{{@devcontainer_active}},{expected}}}"
    )
    action_commands = [list(command) for command in commands]
    action_commands.extend(
        (
            ["set-option", "-p", "-t", pane, TRANSITION_CLAIM_OPTION, claim],
            ["set-option", "-pF", "-t", pane, TRANSITION_PID_OPTION, "#{pane_pid}"],
        )
    )
    action = " ; ".join(shlex.join(command) for command in action_commands)
    run([tmux, "if-shell", "-F", "-t", pane, condition, action, ""])
    transition_format = f"#{{{TRANSITION_CLAIM_OPTION}}}\t#{{{TRANSITION_PID_OPTION}}}"
    snapshot = run([tmux, "display-message", "-p", "-t", pane, transition_format])
    fields = snapshot.stdout.decode("utf-8", "replace").rstrip("\n").split("\t")
    matched = (
        len(fields) == 2
        and fields[0] == claim
        and fields[1].isdigit()
        and int(fields[1]) > 0
    )
    cleanup_condition = f"#{{==:#{{{TRANSITION_CLAIM_OPTION}}},{claim}}}"
    cleanup = " ; ".join(
        shlex.join(["set-option", "-p", "-u", "-t", pane, option])
        for option in (TRANSITION_CLAIM_OPTION, TRANSITION_PID_OPTION)
    )
    run([tmux, "if-shell", "-F", "-t", pane, cleanup_condition, cleanup, ""])
    if not matched:
        fail("tmux editor pane changed before atomic replacement")
    return int(fields[1])


def respawn_container_editor(
    record: Mapping[str, object],
    command: Sequence[str],
    spool: SpoolDirectories,
    snapshot: ConfigSnapshot,
    *,
    allow_dead: bool = False,
) -> PaneObservation:
    """Replace the target pane with container Neovim and verify ownership."""
    pane = str(record["tmux_pane"])
    root = pathlib.Path(str(record["host_root"]))
    tmux = shutil.which("tmux")
    if not tmux:
        fail("tmux is unavailable")
    before = observe_pane(record)
    expected_marker = pane_marker(root) if allow_dead else ""
    if (
        before.dead != allow_dead
        or before.pid != record.get("pane_pid")
        or before.marker != expected_marker
    ):
        fail("tmux editor pane changed before Dev Container replacement")
    run([tmux, "set-option", "-p", "-t", pane, "remain-on-exit", "on"])
    revalidate_config_snapshot(spool, snapshot)
    transition_pid = atomic_pane_respawn(
        tmux,
        pane,
        before,
        expected_marker,
        (
            [
                "respawn-pane",
                "-k",
                "-t",
                pane,
                "-c",
                str(root),
                "exec " + shlex.join(command),
            ],
            ["set-option", "-p", "-t", pane, "@devcontainer_active", pane_marker(root)],
            ["select-pane", "-t", pane, "-T", f"Dev Container · {root.name}"],
        ),
    )
    after = verify_container_pane(record)
    if after.pid == before.pid or after.pid != transition_pid:
        fail("tmux did not verify the atomically replaced Dev Container editor pane")
    return after


def respawn_host_editor(
    record: Mapping[str, object], *, allow_dead: bool = False
) -> PaneObservation:
    """Restore host Neovim, then verify a live new PID and cleared marker."""
    before = verify_registered_container_pane(record, allow_dead=allow_dead)
    pane = str(record["tmux_pane"])
    root = pathlib.Path(str(record["host_root"]))
    tmux = shutil.which("tmux")
    if not tmux:
        fail("tmux is unavailable")
    try:
        transition_pid = atomic_pane_respawn(
            tmux,
            pane,
            before,
            pane_marker(root),
            (
                ["respawn-pane", "-k", "-t", pane, "-c", str(root), "exec nvim"],
                ["set-option", "-p", "-u", "-t", pane, "@devcontainer_active"],
                ["select-pane", "-t", pane, "-T", ""],
            ),
        )
        after = observe_pane(record)
        if (
            after.dead
            or after.pid < 1
            or (before.pid > 0 and after.pid == before.pid)
            or after.pid != transition_pid
            or after.marker
        ):
            fail("tmux did not verify the restored host editor pane")
    except EditorError as error:
        raise HostPaneTransitioned(str(error)) from error
    return after


def respawn_unowned_host_editor(
    root: pathlib.Path, pane: str, pane_pid: int
) -> PaneObservation:
    """Replace one exact unowned editor pane with host Neovim."""
    tmux = shutil.which("tmux")
    record = {"host_root": str(root), "tmux_pane": pane, "pane_pid": pane_pid}
    before = observe_pane(record)
    if before.dead or before.pid != pane_pid or before.marker:
        fail("host editor pane became owned or changed before replacement")
    if not tmux:
        fail("tmux is unavailable")
    transition_pid = atomic_pane_respawn(
        tmux,
        pane,
        before,
        "",
        (["respawn-pane", "-k", "-t", pane, "-c", str(root), "exec nvim"],),
    )
    after = observe_pane(record)
    if (
        after.dead
        or after.pid < 1
        or after.pid == pane_pid
        or after.pid != transition_pid
        or after.marker
    ):
        fail("tmux did not verify the unowned host editor pane")
    return after


def restore_or_verify_host_pane(record: Mapping[str, object]) -> PaneObservation:
    """Restore host Neovim only from the exact registered container pane."""
    observation = observe_pane(record)
    expected_marker = pane_marker(pathlib.Path(str(record["host_root"])))
    if observation.pid != record.get("pane_pid"):
        raise PanePidChanged("tmux pane PID no longer matches the lifecycle record")
    if observation.marker == expected_marker:
        return respawn_host_editor(record, allow_dead=True)
    if (
        not observation.dead
        and not observation.marker
        and record.get("status") in INACTIVE_LIFECYCLE_STATUSES
    ):
        return observation
    fail("tmux pane is not the exact registered Dev Container or restored host editor")


def recover_host_pane(
    record: Mapping[str, object], requested_pane: str | None
) -> PaneObservation:
    """Restore the registered pane or explicitly adopt its exact host replacement."""
    try:
        return restore_or_verify_host_pane(record)
    except PanePidChanged:
        if requested_pane is None:
            raise
        return adopt_restarted_host_pane(record, requested_pane)


def stage_recovered_host_record(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    record: dict[str, object],
    observation: PaneObservation,
) -> tuple[FileIdentity, bool]:
    """Persist the verified host PID and identify early errors to preserve."""
    if record.get("container_id") is None:
        identity = update_workspace_record(
            paths,
            root,
            record,
            pane_pid=observation.pid,
        )
        return identity, True
    identity = update_workspace_record(
        paths,
        root,
        record,
        status="stopped",
        pane_pid=observation.pid,
        error=None,
        exit_code=0,
    )
    return identity, False


def reconcile_host_recovery_failure(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    record: dict[str, object],
    observation: PaneObservation | None,
    error: EditorError,
    preserve_error: bool,
) -> None:
    """Record a failed recovery unless an early lifecycle error remains authoritative."""
    if preserve_error:
        return
    changes: dict[str, object] = {"status": "error", "error": str(error)}
    if observation is not None:
        changes["pane_pid"] = observation.pid
    update_workspace_record(paths, root, record, **changes)


def remove_record(path: pathlib.Path) -> None:
    """Explicitly retire one exact owner-only lifecycle record."""
    descriptor = open_directory_path(path.parent, "workspace record directory")
    try:
        unlink_regular_at(descriptor, path.name, durable=True)
    finally:
        os.close(descriptor)


def remove_workspace_record(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    expected: FileIdentity,
) -> None:
    """Retire only the record identity committed by this coordinator."""
    state = pinned_state(paths)
    unlink_regular_at(
        state.descriptor("workspaces"),
        record_name(root),
        durable=True,
        expected=expected,
    )


def write_ack(
    spool: SpoolDirectories,
    token: str,
    request: Mapping[str, object],
    ok: bool,
    error: str | None,
) -> None:
    """Publish one authenticated no-clobber acknowledgement."""
    value = signed_message(
        token,
        "ack",
        {
            "version": MESSAGE_VERSION,
            "request_id": request["request_id"],
            "ok": ok,
            "action": request["action"],
            "error": error,
        },
    )
    atomic_create_json_at(spool.acks_fd, f"{request['request_id']}.json", value)


def record_request_error(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    record: dict[str, object],
    token: str,
    request: Mapping[str, object] | None,
    primary: EditorError,
    positive_ack: bool,
) -> None:
    """Attempt every request reconciliation while preserving its primary error."""
    root = pathlib.Path(str(record["host_root"]))
    failures: list[tuple[str, str]] = []
    if request is not None and positive_ack:
        try:
            removed = unlink_regular_at(
                spool.acks_fd,
                f"{request['request_id']}.json",
                durable=True,
            )
            if not removed:
                failures.append(("positive acknowledgement", "entry disappeared"))
        except (EditorError, OSError) as cleanup_error:
            failures.append(("positive acknowledgement", str(cleanup_error)))
    if request is not None:
        try:
            write_ack(spool, token, request, False, str(primary))
        except (EditorError, OSError) as cleanup_error:
            failures.append(("negative acknowledgement", str(cleanup_error)))
    try:
        update_workspace_record(paths, root, record, status="error", error=str(primary))
    except (EditorError, OSError) as cleanup_error:
        failures.append(("record", str(cleanup_error)))
    if failures:
        summary = "; ".join(f"{label}: {message}" for label, message in failures)
        raise EditorError(
            f"{primary}; request reconciliation failures: {summary}"
        ) from primary
    if request is None:
        raise primary


def retire_invalid_request(
    spool: SpoolDirectories,
    name: str,
    identity: FileIdentity,
    primary: EditorError,
) -> None:
    """Best-effort retire one invalid snapshot without masking validation."""
    try:
        unlink_regular_at(spool.outbox_fd, name, durable=True, expected=identity)
    except (EditorError, OSError) as cleanup_error:
        warn_nonfatal(
            f"warning: {primary}; invalid request retirement also failed: {cleanup_error}"
        )
        raise EditorError(
            f"{primary}; invalid request retirement failed: {cleanup_error}"
        ) from primary


def consume_request(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    record: dict[str, object],
    token: str,
    name: str,
    expected_snapshot: DirectoryIdentity | None = None,
    relay: PodmanAgentRelay | None = None,
) -> bool:
    """Consume one request and return whether host handoff completed."""
    request: dict[str, Any] | None = None
    positive_ack = False
    host_restored = False
    request_retired = False
    try:
        payload, request_identity = read_private_snapshot_at(
            spool.outbox_fd,
            name,
            "host spool request",
        )
        try:
            raw_request = decode_json_object(payload, "host spool request")
            request = validate_host_request(
                raw_request,
                token,
                name,
            )
        except EditorError as validation_error:
            retire_invalid_request(spool, name, request_identity, validation_error)
            raise
        if not unlink_regular_at(
            spool.outbox_fd,
            name,
            durable=True,
            expected=request_identity,
        ):
            fail("host spool request disappeared before execution")
        request_retired = True
        if request["action"] == "host_editor":
            root = pathlib.Path(str(record["host_root"]))
            update_workspace_phase(paths, root, record, "returning-host")
            lease = load_snapshot_lease(
                paths,
                spool,
                root,
                record["claim_id"],
                expected_snapshot,
            )
            if expected_snapshot is not None and lease is None:
                fail("active lifecycle config snapshot authority is missing")
            observation = respawn_host_editor(record)
            host_restored = True
            if relay is not None:
                relay.close()
            stopped_identity = update_workspace_record(
                paths,
                root,
                record,
                status="stopped",
                pane_pid=observation.pid,
                error=None,
                exit_code=0,
            )
            append_log(
                pathlib.Path(str(record["log_path"])),
                f"{utc_now()} host editor handoff verified",
            )
            if lease is not None:
                retire_snapshot_lease(paths, spool, root, lease)
            write_ack(spool, token, request, True, None)
            positive_ack = True
            remove_auth(spool)
            remove_workspace_record(paths, root, stopped_identity)
            return True
        tmux_action(record, request["action"])
    except EditorError as caught:
        host_restored = host_restored or isinstance(caught, HostPaneTransitioned)
        record_request_error(paths, spool, record, token, request, caught, positive_ack)
        if host_restored:
            raise EditorError(
                f"host editor was restored; coordinator stopped after: {caught}"
            ) from caught
        if request is not None and not request_retired:
            raise
        return False
    write_ack(spool, token, request, True, None)
    return False


def consume_outbox(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    record: dict[str, object],
    token: str,
    expected_snapshot: DirectoryIdentity | None = None,
    relay: PodmanAgentRelay | None = None,
) -> tuple[int, bool]:
    """Consume authenticated host requests and report a completed handoff."""
    consumed = 0
    try:
        with os.scandir(spool.outbox_fd) as entries:
            names = sorted(
                entry.name
                for entry in entries
                if entry.name.endswith(".json") and not entry.name.startswith(".")
            )
    except OSError as error:
        raise EditorError(f"could not scan host spool outbox: {error}") from error
    for name in names:
        consumed += 1
        if consume_request(paths, spool, record, token, name, expected_snapshot, relay):
            return consumed, True
    return consumed, False


def verify_agent(
    cli: str,
    docker: str,
    root: pathlib.Path,
    config: pathlib.Path,
    socket_path: str = DIRECT_AGENT_SOCKET,
    env: Mapping[str, str] | None = None,
    container_id: str | None = None,
) -> None:
    """Require a real ssh-agent protocol response from the selected socket."""
    if not canonical_posix_absolute(socket_path):
        fail("container SSH-agent socket path is invalid")
    probe = (
        'test -S "$1" || exit 121; '
        "test -x /usr/bin/ssh-add || exit 120; "
        'SSH_AUTH_SOCK="$1" /usr/bin/ssh-add -l >/dev/null; code=$?; '
        'case "$code" in 0|1) exit 0 ;; *) exit 122 ;; esac'
    )
    command = [cli, "exec"]
    if container_id is not None:
        container_id = full_container_id(
            container_id, "container SSH-agent verification id"
        )
        command.extend(["--container-id", container_id])
    command.extend(
        [
            "--workspace-folder",
            str(root),
            "--config",
            str(config),
            "--docker-path",
            docker,
            "/bin/sh",
            "-c",
            probe,
            "nvim-agent-probe",
            socket_path,
        ]
    )
    result, overflow = run_bounded_capture(
        command,
        timeout=30.0,
        stdout_limit=4096,
        env=env,
    )
    if overflow or result.stdout:
        fail("container SSH-agent verification output is invalid")
    detail = bounded_log_detail(result.stderr.decode("utf-8", "replace")).strip()
    if result.returncode == 120:
        fail("container SSH-agent verification requires /usr/bin/ssh-add")
    if result.returncode == 121:
        label = "proxy socket" if container_id is not None else "socket"
        fail(f"container SSH-agent {label} is unavailable")
    if result.returncode == 122:
        message = "container SSH agent did not answer the ssh-add protocol probe"
        fail(message + (f": {detail}" if detail else ""))
    if result.returncode != 0:
        message = "Dev Containers CLI SSH-agent verification failed"
        fail(message + (f": {detail}" if detail else ""))


def verify_remote_config_snapshot(
    cli: str,
    docker: str,
    root: pathlib.Path,
    config: pathlib.Path,
    remote_spool: str,
    snapshot: ConfigSnapshot,
    env: Mapping[str, str] | None = None,
    container_id: str | None = None,
) -> None:
    """Prove the reused container sees this claim's readable snapshot mount."""
    remote_snapshot = posixpath.join(remote_spool, snapshot.name)
    command = [cli, "exec"]
    if container_id is not None:
        command.extend(
            [
                "--container-id",
                full_container_id(container_id, "config snapshot container id"),
            ]
        )
    command.extend(
        [
            "--workspace-folder",
            str(root),
            "--config",
            str(config),
            "--docker-path",
            docker,
            "/bin/sh",
            "-c",
            REMOTE_SNAPSHOT_PROBE,
            "nvim-config-snapshot-probe",
            posixpath.join(remote_snapshot, "init.lua"),
            posixpath.join(remote_snapshot, CONFIG_SNAPSHOT_MARKER_NAME),
            snapshot.marker,
        ]
    )
    result = run(
        command,
        timeout=30.0,
        check=False,
        env=env,
    )
    if result.returncode != 0:
        fail("container cannot read the exact current Neovim config snapshot")


def monitor_editor(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    record: dict[str, object],
    token: str,
    snapshot: ConfigSnapshot,
    relay: PodmanAgentRelay | None = None,
) -> tuple[int, bool]:
    """Reconcile the spool until the pane exits or host handoff completes."""
    try:
        while True:
            if relay is not None:
                relay.check()
            _, handed_off = consume_outbox(
                paths, spool, record, token, snapshot.identity, relay
            )
            if handed_off:
                return 0, True
            observation = verify_registered_container_pane(record, allow_dead=True)
            if observation.dead:
                _, handed_off = consume_outbox(
                    paths, spool, record, token, snapshot.identity, relay
                )
                if handed_off:
                    return 0, True
                return observation.exit_code or 0, False
            time.sleep(POLL_SECONDS)
    except KeyboardInterrupt as error:
        raise EditorError("Dev Container coordinator was cancelled") from error


def require_editor_pane(pane: str) -> tuple[str, int]:
    """Validate the exact single-pane tmux replacement contract."""
    tmux = shutil.which("tmux")
    if not valid_tmux_pane(pane) or not tmux:
        fail("DevContainerUp requires tmux's single-pane editor window")
    result = run(
        [
            tmux,
            "display-message",
            "-p",
            "-t",
            pane,
            "#{window_name}\t#{window_panes}\t#{pane_dead}\t#{pane_pid}",
        ],
        timeout=5.0,
        check=False,
    )
    fields = result.stdout.decode("utf-8", "replace").strip().split("\t")
    if (
        result.returncode != 0
        or len(fields) != 4
        or fields[:3] != ["editor", "1", "0"]
        or not fields[3].isdigit()
    ):
        fail("DevContainerUp requires tmux's single-pane editor window")
    return pane, int(fields[3])


def project_record_error(value: object) -> str | None:
    """Project one lifecycle diagnostic into the bounded record contract."""
    if value is None:
        return None
    if not isinstance(value, str):
        fail("workspace record error is invalid")
    sanitized = value.replace("\0", "\\0")
    if len(sanitized) <= MAX_RECORD_ERROR_CHARS:
        return sanitized
    prefix_size = MAX_RECORD_ERROR_CHARS - len(RECORD_ERROR_SUFFIX)
    return sanitized[:prefix_size] + RECORD_ERROR_SUFFIX


def log_projected_record_error(
    candidate: Mapping[str, object], raw: object, projected: str | None
) -> None:
    """Retain a fuller bounded diagnostic when the record projection loses detail."""
    if not isinstance(raw, str) or raw == projected:
        return
    detail = raw.replace("\0", "\\0")
    append_log(
        pathlib.Path(str(candidate["log_path"])),
        f"{utc_now()} full lifecycle error: {detail}",
    )


def update_workspace_record(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    record: dict[str, object],
    **changes: object,
) -> FileIdentity:
    """Persist one state transition through the pinned workspace directory."""
    state = pinned_state(paths)
    candidate = dict(record)
    candidate.update(changes)
    candidate["updated_at"] = utc_now()
    keys = record_keys(candidate.get("version"))
    if set(candidate) != keys:
        fail("workspace record schema is invalid")
    raw_error = candidate["error"]
    candidate["error"] = project_record_error(raw_error)
    candidate = validate_workspace_record(paths, root, candidate)
    log_projected_record_error(candidate, raw_error, candidate["error"])
    identity = atomic_replace_json_at(
        state.descriptor("workspaces"),
        record_name(root),
        candidate,
    )
    record.clear()
    record.update(candidate)
    return identity


def update_workspace_phase(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    record: dict[str, object],
    phase: str,
) -> None:
    """Persist a phase only for records implementing the progress contract."""
    if phase not in RECORD_PHASES:
        fail("workspace record phase is invalid")
    if record.get("version") in PHASE_RECORD_VERSIONS:
        update_workspace_record(paths, root, record, phase=phase)


def reconcile_lifecycle_failure(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    record: dict[str, object],
    log: pathlib.Path,
    primary: EditorError,
) -> None:
    """Attempt every fail-closed cleanup and retain the primary error first."""
    failures: list[tuple[str, str]] = []
    if record.get("status") != "dead":
        try:
            update_workspace_record(
                paths, root, record, status="error", error=str(primary)
            )
        except (EditorError, OSError) as cleanup_error:
            failures.append(("record", str(cleanup_error)))
    try:
        remove_auth(spool)
    except (EditorError, OSError) as cleanup_error:
        failures.append(("authentication", str(cleanup_error)))
    detail = f"{utc_now()} lifecycle error: {primary}"
    if failures:
        detail += "; reconciliation warnings: " + "; ".join(
            f"{label}: {message}" for label, message in failures
        )
    try:
        append_log(log, detail)
    except (EditorError, OSError) as cleanup_error:
        failures.append(("log", str(cleanup_error)))
    for label, message in failures:
        warn_nonfatal(f"warning: lifecycle {label} reconciliation failed: {message}")
    if failures:
        summary = "; ".join(f"{label}: {message}" for label, message in failures)
        raise EditorError(
            f"{primary}; lifecycle reconciliation failures: {summary}"
        ) from primary


def propagate_relay_cleanup_failure(
    primary: BaseException | None,
    cleanup: EditorError,
) -> None:
    """Preserve active control flow while reporting a relay cleanup failure."""
    if primary is None:
        raise cleanup
    report_cleanup_failure(
        primary,
        "SSH-agent relay cleanup failed",
        cleanup,
    )


def reconcile_lifecycle_interruption(
    paths: Mapping[str, pathlib.Path],
    spool: SpoolDirectories,
    root: pathlib.Path,
    record: dict[str, object],
    log: pathlib.Path,
    primary: BaseException,
) -> None:
    """Reconcile state for non-Exception control flow without masking it."""
    failure = EditorError(
        f"Dev Container lifecycle interrupted by {type(primary).__name__}"
    )
    try:
        reconcile_lifecycle_failure(paths, spool, root, record, log, failure)
    except BaseException as cleanup:  # noqa: BLE001 - never mask control flow
        message = f"lifecycle interruption reconciliation failed: {cleanup}"
        if hasattr(primary, "add_note"):
            primary.add_note(message)
        warn_nonfatal(f"warning: {message}")


def start_agent_relay(relay: PodmanAgentRelay | None, log: pathlib.Path) -> None:
    """Start and log one optional Podman Machine agent relay."""
    if relay is None:
        return
    relay.start()
    append_log(log, f"{utc_now()} SSH-agent Podman Machine relay ready")


def start_agent_container_proxy(
    relay: PodmanAgentRelay | None,
    cli: str,
    config: pathlib.Path,
    container_id: str,
    env: Mapping[str, str] | None,
    log: pathlib.Path,
) -> None:
    """Start and log the optional remote-user-owned container proxy."""
    if relay is None:
        return
    relay.start_container_proxy(cli, config, container_id, env)
    append_log(log, f"{utc_now()} SSH-agent container proxy ready")


def check_agent_relay(relay: PodmanAgentRelay | None) -> None:
    """Revalidate one optional relay at a lifecycle mutation boundary."""
    if relay is not None:
        relay.check()


def close_agent_relay(
    relay: PodmanAgentRelay | None,
    log: pathlib.Path,
    primary: BaseException | None,
) -> None:
    """Stop one optional relay without losing the active lifecycle failure."""
    if relay is None:
        return
    cleanup_error: EditorError | None = None
    try:
        relay.close()
    except EditorError as error:
        cleanup_error = error
    try:
        relay_status = (
            "stopped" if cleanup_error is None else f"cleanup failed: {cleanup_error}"
        )
        append_log(
            log,
            f"{utc_now()} SSH-agent Podman Machine relay {relay_status}",
        )
    except (EditorError, OSError) as error:
        warn_nonfatal(f"warning: could not log SSH-agent relay stop: {error}")
    if cleanup_error is not None:
        propagate_relay_cleanup_failure(primary, cleanup_error)


def revalidate_direct_agent(forwarding: AgentForwarding) -> None:
    """Revalidate a direct host socket immediately before container startup."""
    if forwarding.transport == "direct-bind" and forwarding.host is not None:
        revalidate_host_agent(forwarding.host)


def revalidate_engine_machine(machine: PodmanMachine | None) -> None:
    """Revalidate one selected Podman identity immediately before lifecycle use."""
    if machine is not None:
        validate_machine_identity(machine)


def run_container_lifecycle(
    paths: StateDirectories,
    spool: SpoolDirectories,
    root: pathlib.Path,
    config: pathlib.Path,
    record: dict[str, object],
    log: pathlib.Path,
    token: str,
    cli: str,
    docker: str,
    agent: AgentForwarding | HostAgentSnapshot | pathlib.Path | None,
    *,
    recreate: bool,
    timeout: float,
    allow_dead_pane: bool,
) -> None:
    """Run one already-claimed lifecycle through verified pane exit."""
    forwarding = normalized_forwarding(agent)
    relay = (
        PodmanAgentRelay(paths, root, forwarding, docker)
        if forwarding.transport == "podman-machine-relay"
        else None
    )
    agent_socket = (
        relay.container_socket
        if relay is not None
        else forwarding.container_socket or DIRECT_AGENT_SOCKET
    )
    update_workspace_phase(paths, root, record, "preparing-config")
    revalidate_engine_machine(forwarding.machine)
    engine_env = pinned_engine_environment(forwarding.machine)
    lockfile_flag = preserve_lockfile_flag(cli, docker, config, engine_env)
    try:
        start_agent_relay(relay, log)
        with lifecycle_config_snapshot(
            paths, spool, root, record["claim_id"]
        ) as snapshot:
            command, remote_spool = up_argv(
                cli,
                docker,
                root,
                config,
                spool.root,
                recreate,
                forwarding,
                lockfile_flag,
            )
            update_workspace_phase(paths, root, record, "starting-container")
            revalidate_direct_agent(forwarding)
            result = run_up_with_pinned_spool(
                command,
                spool,
                timeout,
                log,
                relay,
                engine_env,
            )
            check_agent_relay(relay)
            container_id, container_root = decode_up(result)
            update_workspace_record(
                paths,
                root,
                record,
                container_id=container_id,
                container_root=container_root,
                workspace_key={
                    "runtime": "container",
                    "root": container_root,
                    "repo_identity": str(root),
                },
            )
            if forwarding.transport != "disabled":
                update_workspace_phase(paths, root, record, "checking-ssh-agent")
                start_agent_container_proxy(
                    relay,
                    cli,
                    config,
                    container_id,
                    engine_env,
                    log,
                )
                verify_agent(
                    cli,
                    docker,
                    root,
                    config,
                    agent_socket,
                    engine_env,
                    container_id if relay is not None else None,
                )
                check_agent_relay(relay)
                if relay is not None:
                    command = run_user_commands_argv(
                        cli,
                        docker,
                        root,
                        config,
                        container_id,
                        agent_socket,
                    )
                    run_user_commands_with_pinned_spool(
                        command,
                        spool,
                        timeout,
                        log,
                        relay,
                        engine_env,
                    )
                    append_log(
                        log,
                        f"{utc_now()} Dev Container user commands completed",
                    )
                    check_agent_relay(relay)
                    verify_agent(
                        cli,
                        docker,
                        root,
                        config,
                        agent_socket,
                        engine_env,
                        container_id,
                    )
                    check_agent_relay(relay)
            update_workspace_phase(paths, root, record, "checking-editor-config")
            revalidate_config_snapshot(spool, snapshot)
            verify_remote_config_snapshot(
                cli,
                docker,
                root,
                config,
                remote_spool,
                snapshot,
                engine_env,
                container_id if forwarding.machine is not None else None,
            )
            check_agent_relay(relay)
            update_workspace_phase(paths, root, record, "opening-editor")
            check_agent_relay(relay)
            observation = respawn_container_editor(
                record,
                editor_argv(
                    cli,
                    docker,
                    root,
                    config,
                    record,
                    remote_spool,
                    agent_socket,
                    forwarding.machine,
                ),
                spool,
                snapshot,
                allow_dead=allow_dead_pane,
            )
            check_agent_relay(relay)
            update_workspace_record(
                paths,
                root,
                record,
                status="running",
                phase="monitoring-editor",
                pane_pid=observation.pid,
            )
            append_log(log, f"{utc_now()} lifecycle running container={container_id}")
            code, handed_off = monitor_editor(
                paths, spool, record, token, snapshot, relay
            )
            if handed_off:
                return
    finally:
        close_agent_relay(relay, log, sys.exc_info()[1])
    error = None if code == 0 else f"Dev Container editor exited {code}"
    update_workspace_record(
        paths,
        root,
        record,
        status="dead",
        exit_code=code,
        error=error,
    )
    remove_auth(spool)
    append_log(log, f"{utc_now()} editor dead exit={code}")
    if code != 0:
        raise EditorError(error)


def cmd_up(arguments: argparse.Namespace) -> None:
    """Start or recreate one Dev Container and run Neovim in it."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    config = discover_config(root, arguments.config)
    pane, pane_pid = require_editor_pane(arguments.tmux_pane)
    claim_id = canonical_uuid4(arguments.claim_id, "lifecycle claim id")
    spool_root = spool_path(paths, root)
    log = log_path(paths, root)
    token = secrets.token_urlsafe(32)
    agent = ssh_agent(getattr(arguments, "ssh_agent", "auto"))
    record = base_record(
        root, config, log, arguments.allow_network, agent, pane, pane_pid, claim_id
    )
    with (
        workspace_spool(spool_root, parent_fd=paths.descriptor("spool")) as spool,
        workspace_lock(paths, root),
    ):
        if entry_exists_at(paths.descriptor("workspaces"), record_name(root)):
            fail(
                "a Dev Container lifecycle record already exists; "
                "use host or restart-dead"
            )
        append_log(log, f"{utc_now()} lifecycle starting with @devcontainers/cli")
        update_workspace_record(paths, root, record)
        try:
            unlink_regular_at(spool.root_fd, "auth.json", durable=True)
            create_auth(spool, token)
            cli = cli_path(arguments.cli_path)
            docker = docker_path(arguments.docker_path)
            update_workspace_record(
                paths,
                root,
                record,
                cli_path=cli,
                docker_path=docker,
            )
            forwarding = forwarding_plan(root, docker, agent)
            update_workspace_record(
                paths,
                root,
                record,
                podman_connection=forwarding_connection(forwarding),
            )
            append_log(
                log,
                f"{utc_now()} SSH-agent transport={forwarding.transport}",
            )
            policy = getattr(arguments, "lockfile_policy", "preserve")
            if policy != "preserve":
                fail("Dev Container lockfile policy must be preserve")
            run_container_lifecycle(
                paths,
                spool,
                root,
                config,
                record,
                log,
                token,
                cli,
                docker,
                forwarding,
                recreate=arguments.recreate,
                timeout=arguments.timeout,
                allow_dead_pane=False,
            )
        except EditorError as error:
            reconcile_lifecycle_failure(paths, spool, root, record, log, error)
            raise
        except BaseException as error:
            reconcile_lifecycle_interruption(
                paths,
                spool,
                root,
                record,
                log,
                error,
            )
            raise


def cmd_restart_dead(arguments: argparse.Namespace) -> None:
    """Restart the exact dead container editor with its recorded CLI."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    claim_id = canonical_uuid4(arguments.claim_id, "lifecycle claim id")
    token = secrets.token_urlsafe(32)
    state = pinned_state(paths)
    with (
        workspace_spool(
            spool_path(paths, root),
            parent_fd=state.descriptor("spool"),
        ) as spool,
        workspace_lock(paths, root),
    ):
        record = load_record(paths, root)
        if record["version"] not in RUNTIME_RECORD_VERSIONS:
            fail("workspace record predates the pinned runtime executable contract")
        if record["status"] != "dead":
            fail("restart-dead requires an exact dead Dev Container lifecycle")
        if record["tmux_pane"] != arguments.tmux_pane:
            fail("restart-dead pane does not match the workspace record")
        if record["claim_id"] == claim_id:
            fail("restart-dead requires a fresh lifecycle claim id")
        lease = load_snapshot_lease(
            paths,
            spool,
            root,
            record["claim_id"],
        )
        observation = verify_registered_container_pane(record, allow_dead=True)
        log = pathlib.Path(str(record["log_path"]))
        cli, docker = stored_runtime_paths(record)
        config = contained_file(root, str(record["config_path"]))
        selected_machine = stored_podman_machine(record, docker)
        agent = ssh_agent("auto") if record["ssh_agent_forwarding"] else None
        if record["ssh_agent_forwarding"] and agent is None:
            fail("recorded SSH-agent forwarding is no longer available")
        forwarding = forwarding_plan(root, docker, agent, selected_machine)
        append_log(log, f"{utc_now()} dead editor restart starting")
        if lease is not None:
            retire_snapshot_lease(paths, spool, root, lease)
        update_workspace_record(
            paths,
            root,
            record,
            version=RECORD_VERSION,
            status="starting",
            phase="claimed",
            podman_connection=forwarding_connection(forwarding),
            pid=os.getpid(),
            claim_id=claim_id,
            pane_pid=observation.pid,
            exit_code=None,
            error=None,
        )
        try:
            unlink_regular_at(spool.root_fd, "auth.json", durable=True)
            create_auth(spool, token)
            run_container_lifecycle(
                paths,
                spool,
                root,
                config,
                record,
                log,
                token,
                cli,
                docker,
                forwarding,
                recreate=arguments.recreate,
                timeout=arguments.timeout,
                allow_dead_pane=True,
            )
        except EditorError as error:
            reconcile_lifecycle_failure(paths, spool, root, record, log, error)
            raise
        except BaseException as error:
            reconcile_lifecycle_interruption(
                paths,
                spool,
                root,
                record,
                log,
                error,
            )
            raise


def cmd_new_claim_id(_arguments: argparse.Namespace) -> None:
    """Print one canonical UUIDv4 lifecycle claim."""
    print(uuid.uuid4())


def cmd_wait_claim(arguments: argparse.Namespace) -> None:
    """Wait until one detached lifecycle publishes its exact starting claim."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    claim_id = canonical_uuid4(arguments.claim_id, "lifecycle claim id")
    deadline = time.monotonic() + arguments.timeout
    state = pinned_state(paths)
    while time.monotonic() < deadline:
        if entry_exists_at(state.descriptor("workspaces"), record_name(root)):
            record = load_record(paths, root)
            if record["claim_id"] == claim_id:
                if record["status"] in {"starting", "running"}:
                    return
                detail = record.get("error")
                if isinstance(detail, str) and detail:
                    fail(detail)
                fail(f"detached coordinator entered {record['status']}")
            if record["status"] in {"starting", "running"}:
                fail("another lifecycle claim owns the workspace")
        time.sleep(POLL_SECONDS)
    fail("detached coordinator did not publish its starting claim")


def cmd_wait_dead(arguments: argparse.Namespace) -> None:
    """Wait until the exact registered container editor is durably dead."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    deadline = time.monotonic() + arguments.timeout
    while time.monotonic() < deadline:
        record = load_record(paths, root)
        if record["version"] not in RUNTIME_RECORD_VERSIONS:
            fail("legacy workspace records cannot restart a Dev Container")
        if record["tmux_pane"] != arguments.tmux_pane:
            fail("dead-editor wait pane does not match the workspace record")
        if record["status"] == "dead":
            verify_registered_container_pane(record, allow_dead=True)
            return
        if record["status"] not in {"starting", "running"}:
            fail(f"Dev Container lifecycle entered {record['status']} before restart")
        time.sleep(POLL_SECONDS)
    fail("timed out waiting for the Dev Container editor record to become dead")


def cmd_check_active(arguments: argparse.Namespace) -> None:
    """Verify one exact live container editor pane without mutating it."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    record = selected_record(paths, root)
    if record["tmux_pane"] != arguments.tmux_pane:
        fail("active editor pane does not match the workspace record")
    verify_registered_container_pane(record, allow_dead=False)


def relative_host_file(root: pathlib.Path, value: str) -> tuple[pathlib.Path, str]:
    """Resolve one contained host file and its stable POSIX relative path."""
    target = contained_file(root, value)
    return target, target.relative_to(root).as_posix()


def validate_ack(
    value: Mapping[str, object],
    token: str,
    request: Mapping[str, object],
) -> None:
    """Validate one exact authenticated acknowledgement snapshot."""
    if set(value) != ACK_KEYS:
        fail("spool acknowledgement schema is invalid")
    if (
        value.get("version") != MESSAGE_VERSION
        or value.get("request_id") != request["request_id"]
        or value.get("action") != request["action"]
        or type(value.get("ok")) is not bool
        or (value.get("error") is not None and not isinstance(value.get("error"), str))
        or not valid_message_auth(token, "ack", value)
        or value.get("ok") is not True
    ):
        fail(str(value.get("error") or "Dev Container editor rejected the request"))


def retire_ack_snapshot(
    spool: SpoolDirectories,
    name: str,
    identity: FileIdentity,
    primary: EditorError | None = None,
) -> None:
    """Durably retire one exact acknowledgement without masking validation."""
    try:
        unlink_regular_at(
            spool.acks_fd,
            name,
            durable=True,
            expected=identity,
        )
    except (EditorError, OSError) as cleanup_error:
        if primary is None:
            raise
        warn_nonfatal(
            f"warning: {primary}; acknowledgement retirement also failed: {cleanup_error}"
        )
        raise EditorError(
            f"{primary}; acknowledgement retirement failed: {cleanup_error}"
        ) from primary


def wait_ack(
    spool: SpoolDirectories,
    token: str,
    request: Mapping[str, object],
    timeout: float,
) -> None:
    """Wait for one exact authenticated spool acknowledgement."""
    name = f"{request['request_id']}.json"
    deadline = time.monotonic() + timeout
    while not entry_exists_at(spool.acks_fd, name):
        if time.monotonic() >= deadline:
            fail("Dev Container editor request timed out; host fallback is disabled")
        time.sleep(POLL_SECONDS)
    payload, identity = read_private_snapshot_at(
        spool.acks_fd,
        name,
        "spool acknowledgement",
    )
    try:
        value = decode_json_object(payload, "spool acknowledgement")
        validate_ack(value, token, request)
    except EditorError as primary:
        retire_ack_snapshot(spool, name, identity, primary)
        raise
    retire_ack_snapshot(spool, name, identity)


def open_location(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    file: str,
    line: int,
    column: int,
    timeout: float,
    expected_pane: str | None = None,
) -> None:
    """Route one host file to the exact active container editor pane."""
    if line < 1 or column < 1:
        fail("line and column must be positive integers")
    if expected_pane is not None and not valid_tmux_pane(expected_pane):
        fail("expected editor pane must be an exact tmux pane id")
    record = selected_record(paths, root)
    if expected_pane is not None and record["tmux_pane"] != expected_pane:
        fail(
            "active Dev Container editor pane does not match the requested pane; host fallback is disabled"
        )
    _, relative = relative_host_file(root, file)
    state = pinned_state(paths)
    with workspace_spool(
        spool_path(paths, root), parent_fd=state.descriptor("spool")
    ) as spool:
        token = read_auth(spool)
        request = signed_message(
            token,
            "open_location",
            {
                "version": MESSAGE_VERSION,
                "request_id": str(uuid.uuid4()),
                "action": "open_location",
                "path": relative,
                "line": line,
                "column": column,
                "created_at": utc_now(),
            },
        )
        atomic_create_json_at(spool.inbox_fd, f"{request['request_id']}.json", request)
        wait_ack(spool, token, request, timeout)


def request_active_host_action(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    action: str,
    timeout: float,
    expected_pane: str | None = None,
) -> None:
    """Send one authenticated action to the active lifecycle coordinator.

    :param paths: Pinned private state hierarchy.
    :param root: Canonical host repository root.
    :param action: Host action accepted by the coordinator allowlist.
    :param timeout: Positive acknowledgement timeout in seconds.
    :param expected_pane: Optional exact pane identity required by the caller.
    """
    if action not in HOST_ACTIONS:
        fail("host action is not allowed")
    record = selected_record(paths, root)
    if expected_pane is not None and record["tmux_pane"] != expected_pane:
        fail("host pane does not match the workspace record")
    verify_registered_container_pane(record, allow_dead=False)
    state = pinned_state(paths)
    with workspace_spool(
        spool_path(paths, root),
        parent_fd=state.descriptor("spool"),
    ) as spool:
        token = read_auth(spool)
        request = signed_message(
            token,
            "host_request",
            {
                "version": MESSAGE_VERSION,
                "request_id": str(uuid.uuid4()),
                "action": action,
                "created_at": utc_now(),
            },
        )
        atomic_create_json_at(spool.outbox_fd, f"{request['request_id']}.json", request)
        wait_ack(spool, token, request, timeout)


def exact_fallback(arguments: argparse.Namespace, lock_descriptor: int) -> NoReturn:
    """Exec the exact host editor while retaining the lifecycle exclusion lock."""
    exact = CONFIG_ROOT / "scripts" / "exact-editor-open"
    argv = [str(exact)]
    if arguments.wait_editor:
        argv.append("--wait-editor")
        if getattr(arguments, "signal_ready", False):
            argv.append("--signal-ready")
        tmux_pane = getattr(arguments, "tmux_pane", None)
        if tmux_pane:
            argv.extend(["--tmux-pane", tmux_pane])
        argv.extend(
            [
                "--wait-timeout",
                str(getattr(arguments, "wait_timeout", SPOOL_TIMEOUT_SECONDS)),
                arguments.editor_file,
            ]
        )
    else:
        argv.extend(
            [
                "--cwd",
                arguments.cwd,
                "--file",
                arguments.file,
                "--line",
                str(arguments.line),
                "--column",
                str(arguments.column),
            ]
        )
        tmux_pane = getattr(arguments, "tmux_pane", None)
        if tmux_pane:
            argv.extend(["--tmux-pane", tmux_pane])
    try:
        # Only the exact-host router inherits this FD. Its subprocess calls use
        # Python's close-fds default, so the router process owns the lifetime.
        os.set_inheritable(lock_descriptor, True)
        os.execv(exact, argv)
    except OSError as error:
        with contextlib.suppress(OSError):
            os.set_inheritable(lock_descriptor, False)
        raise EditorError(
            f"could not hand off to the exact host editor: {error}"
        ) from error


def exact_fallback_if_absent(
    paths: Mapping[str, pathlib.Path],
    root: pathlib.Path,
    arguments: argparse.Namespace,
) -> NoReturn:
    """Recheck lifecycle absence under the lock retained by the host router."""
    with workspace_lock(paths, root) as lock_descriptor:
        try:
            selected_record(paths, root)
        except NoActiveEditor:
            exact_fallback(arguments, lock_descriptor)
        fail("a Dev Container lifecycle became active; host fallback is disabled")


def cmd_open_location(arguments: argparse.Namespace) -> None:
    """Route a normal editor location, optionally falling back exactly once."""
    paths = prepare_state()
    root = repo_root(arguments.cwd)
    try:
        open_location(
            paths,
            root,
            arguments.file,
            arguments.line,
            arguments.column,
            arguments.wait_timeout,
            getattr(arguments, "tmux_pane", None),
        )
    except NoActiveEditor:
        if arguments.fallback_exact:
            exact_fallback_if_absent(paths, root, arguments)
        raise


def cmd_editor_open(arguments: argparse.Namespace) -> None:
    """Provide a drop-in host-first exact-editor wrapper."""
    if arguments.wait_editor:
        root = repo_root(os.getcwd())
        paths = prepare_state()
        try:
            selected_record(paths, root)
        except NoActiveEditor:
            exact_fallback_if_absent(paths, root, arguments)
        fail(
            "blocking host temporary files cannot be mapped into an active container editor"
        )
    cmd_open_location(arguments)


def cmd_exec(arguments: argparse.Namespace) -> None:
    """Execute exact argv from one translated cwd without shell interpolation."""
    if isinstance(arguments.argv, (str, bytes)) or not isinstance(
        arguments.argv, Sequence
    ):
        fail("exec requires -- followed by non-empty argv")
    argv = list(arguments.argv)
    if not argv or argv.pop(0) != "--" or not argv:
        fail("exec requires -- followed by non-empty argv")
    if (
        any(not isinstance(item, str) for item in argv)
        or not argv[0]
        or any("\0" in item for item in argv)
    ):
        fail("exec requires -- followed by non-empty argv")
    paths = prepare_state()
    cwd = canonical_root(arguments.cwd or os.getcwd())
    root = repo_root(cwd)
    record = selected_record(paths, root)
    cli, docker = stored_runtime_paths(record)
    machine = stored_podman_machine(record, docker)
    engine_env = pinned_engine_environment(machine)
    config = contained_file(root, str(record["config_path"]))
    relative = cwd.relative_to(root).as_posix()
    container_cwd = str(record["container_root"])
    if relative != ".":
        container_cwd = str(pathlib.PurePosixPath(container_cwd) / relative)
    container_selection: list[str] = []
    if machine is not None:
        container_selection = [
            "--container-id",
            full_container_id(record.get("container_id"), "recorded container id"),
        ]
    result = run(
        [
            cli,
            "exec",
            *container_selection,
            "--workspace-folder",
            str(root),
            "--config",
            str(config),
            "--docker-path",
            docker,
            "/bin/sh",
            "-c",
            EXEC_CWD_TRAMPOLINE,
            "nvim-devcontainer-exec",
            container_cwd,
            *argv,
        ],
        check=False,
        env=engine_env,
    )
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    raise SystemExit(result.returncode)


def load_all_records(paths: StateDirectories) -> list[dict[str, Any]]:
    """Load every filename-bound record through the pinned workspace directory."""
    workspaces_fd = paths.descriptor("workspaces")
    records: list[dict[str, Any]] = []
    try:
        with os.scandir(workspaces_fd) as entries:
            candidates = sorted(
                entry.name
                for entry in entries
                if entry.name.endswith(".json") and not entry.name.startswith(".")
            )
    except OSError as error:
        raise EditorError(f"could not scan workspace records: {error}") from error
    for name in candidates:
        stem = name.removesuffix(".json")
        if len(stem) != 64 or any(
            character not in "0123456789abcdef" for character in stem
        ):
            fail("workspace record filename is invalid")
        value = read_private_json_at(workspaces_fd, name, "workspace record")
        host_root = value.get("host_root")
        if not isinstance(host_root, str):
            fail("workspace record host root is invalid")
        root = canonical_root(host_root)
        if name != record_name(root):
            fail("workspace record filename does not match its host root")
        records.append(validate_workspace_record(paths, root, value))
    return records


def cmd_status(arguments: argparse.Namespace) -> None:
    """Print private lifecycle state without exposing authentication tokens."""
    paths = prepare_state()
    workspaces_fd = paths.descriptor("workspaces")
    if arguments.all:
        records = load_all_records(paths)
    else:
        records = []
        root = repo_root(arguments.repo or os.getcwd())
        if entry_exists_at(workspaces_fd, record_name(root)):
            records.append(load_record(paths, root))
    payload = {"ok": True, "command": "status", "records": records}
    if arguments.json:
        print(json.dumps(payload, sort_keys=True))
    elif not records:
        print("No Dev Container workspace state")
    else:
        for value in records:
            print(f"{value['status']}\t{value['host_root']}\t{value['container_root']}")


def selected_log(paths: Mapping[str, pathlib.Path], root: pathlib.Path) -> pathlib.Path:
    """Return one safe bounded lifecycle log."""
    record = load_record(paths, root)
    path = pathlib.Path(str(record["log_path"]))
    if (
        path != log_path(paths, root)
        or not regular_owner_file(path)
        or path.stat().st_size > MAX_LOG_BYTES
    ):
        fail("private Dev Container log is unsafe or exceeds 256 KiB")
    return path


def cmd_log(arguments: argparse.Namespace) -> None:
    """Print or page one private lifecycle log."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    path = selected_log(paths, root)
    if arguments.pager:
        pager = shutil.which("less")
        if not pager:
            fail("host less is required to view the Dev Container log popup")
        os.execv(pager, [pager, "+F", "-R", "--", str(path)])
    sys.stdout.buffer.write(path.read_bytes())


def cmd_host(arguments: argparse.Namespace) -> None:
    """Explicitly stop fail-closed routing and restore host Neovim."""
    paths = prepare_state()
    root = repo_root(arguments.repo or os.getcwd())
    state = pinned_state(paths)
    requested_pane = getattr(arguments, "tmux_pane", None)
    if entry_exists_at(state.descriptor("workspaces"), record_name(root)):
        observed = load_record(paths, root)
        if requested_pane is not None and observed["tmux_pane"] != requested_pane:
            fail("host pane does not match the workspace record")
        if observed["status"] == "running":
            request_active_host_action(
                paths,
                root,
                "host_editor",
                arguments.wait_timeout,
                requested_pane,
            )
            return
    with workspace_lock(paths, root):
        if not entry_exists_at(state.descriptor("workspaces"), record_name(root)):
            if requested_pane is None:
                raise NoActiveEditor(f"no Dev Container editor owns repository {root}")
            pane, pane_pid = require_editor_pane(requested_pane)
            respawn_unowned_host_editor(root, pane, pane_pid)
            return
        record = load_record(paths, root)
        if record["status"] not in INACTIVE_LIFECYCLE_STATUSES:
            fail(
                f"Dev Container lifecycle is {record['status']}; "
                "explicit inactive recovery is required"
            )
        if requested_pane is not None and record["tmux_pane"] != requested_pane:
            fail("host pane does not match the workspace record")
        with workspace_spool(
            spool_path(paths, root),
            parent_fd=state.descriptor("spool"),
        ) as spool:
            host_observation: PaneObservation | None = None
            preserve_recovery_error = False
            try:
                lease = load_snapshot_lease(
                    paths,
                    spool,
                    root,
                    record["claim_id"],
                )
                update_workspace_phase(paths, root, record, "returning-host")
                host_observation = recover_host_pane(record, requested_pane)
                retired_identity, preserve_recovery_error = stage_recovered_host_record(
                    paths, root, record, host_observation
                )
                if lease is not None:
                    retire_snapshot_lease(paths, spool, root, lease)
                remove_auth(spool)
                remove_workspace_record(paths, root, retired_identity)
            except EditorError as error:
                reconcile_host_recovery_failure(
                    paths,
                    root,
                    record,
                    host_observation,
                    error,
                    preserve_recovery_error,
                )
                raise


def cmd_doctor(arguments: argparse.Namespace) -> None:
    """Read-only validate runtime, CLI surfaces, and snapshot inputs."""
    root = repo_root(arguments.repo or os.getcwd())
    config = discover_config(root, arguments.config)
    cli = cli_path(arguments.cli_path)
    docker = docker_path(arguments.docker_path)
    if arguments.lockfile_policy != "preserve":
        fail("Dev Container lockfile policy must be preserve")
    cli_version = probe_version(cli, "Dev Containers CLI")
    docker_version = probe_version(docker, "Docker-compatible engine")
    snapshot = validate_config_snapshot_source()
    agent = ssh_agent(arguments.ssh_agent)
    forwarding = forwarding_plan(root, docker, agent)
    engine_env = pinned_engine_environment(forwarding.machine)
    flag = preserve_lockfile_flag(cli, docker, config, engine_env)
    if forwarding.machine is not None:
        exact_executable_path("/usr/bin/ssh", "OpenSSH client")
        validate_machine_identity(forwarding.machine)
        inspect_known_hosts(forwarding.machine)
    print(
        json.dumps(
            {
                "ok": True,
                "command": "doctor",
                "cli": cli,
                "cli_version": cli_version,
                "config": str(config),
                "config_snapshot_bytes": snapshot.size,
                "config_snapshot_files": snapshot.files,
                "config_snapshot_mode": "private-per-claim",
                "docker": docker,
                "docker_version": docker_version,
                "lockfile": str(lockfile_path(config)),
                "lockfile_flag": flag,
                "ssh_agent_forwarding": agent is not None,
                "ssh_agent_transport": forwarding.transport,
                "podman_connection": forwarding_connection(forwarding),
            },
            sort_keys=True,
        )
    )


def parser() -> argparse.ArgumentParser:
    """Build the Dev Container editor command-line parser."""
    value = argparse.ArgumentParser(description=__doc__)
    commands = value.add_subparsers(dest="command", required=True)
    up = commands.add_parser("up")
    up.add_argument("--repo")
    up.add_argument("--config")
    up.add_argument("--recreate", action="store_true")
    up.add_argument("--allow-network", action="store_true")
    up.add_argument("--cli-path", required=True)
    up.add_argument("--docker-path", required=True)
    up.add_argument("--lockfile-policy", choices=("preserve",), default="preserve")
    up.add_argument("--ssh-agent", choices=("auto", "off"), default="auto")
    up.add_argument("--tmux-pane", required=True)
    up.add_argument("--claim-id", required=True)
    up.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT_SECONDS)
    up.set_defaults(callback=cmd_up)
    restart = commands.add_parser("restart-dead")
    restart.add_argument("--repo")
    restart.add_argument("--recreate", action="store_true")
    restart.add_argument("--tmux-pane", required=True)
    restart.add_argument("--claim-id", required=True)
    restart.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT_SECONDS)
    restart.set_defaults(callback=cmd_restart_dead)
    claim = commands.add_parser("new-claim-id")
    claim.set_defaults(callback=cmd_new_claim_id)
    wait_claim = commands.add_parser("wait-claim")
    wait_claim.add_argument("--repo")
    wait_claim.add_argument("--claim-id", required=True)
    wait_claim.add_argument("--timeout", type=float, default=2.0)
    wait_claim.set_defaults(callback=cmd_wait_claim)
    wait_dead = commands.add_parser("wait-dead")
    wait_dead.add_argument("--repo")
    wait_dead.add_argument("--tmux-pane", required=True)
    wait_dead.add_argument("--timeout", type=float, default=2.0)
    wait_dead.set_defaults(callback=cmd_wait_dead)
    check_active = commands.add_parser("check-active")
    check_active.add_argument("--repo")
    check_active.add_argument("--tmux-pane", required=True)
    check_active.set_defaults(callback=cmd_check_active)
    execute = commands.add_parser("exec")
    execute.add_argument("--cwd")
    execute.add_argument("argv", nargs=argparse.REMAINDER)
    execute.set_defaults(callback=cmd_exec)
    status = commands.add_parser("status")
    status.add_argument("--repo")
    status.add_argument("--json", action="store_true")
    status.add_argument("--all", action="store_true")
    status.set_defaults(callback=cmd_status)
    log = commands.add_parser("log")
    log.add_argument("--repo")
    log.add_argument("--pager", action="store_true")
    log.set_defaults(callback=cmd_log)
    host = commands.add_parser("host")
    host.add_argument("--repo")
    host.add_argument("--tmux-pane")
    host.add_argument("--wait-timeout", type=float, default=SPOOL_TIMEOUT_SECONDS)
    host.set_defaults(callback=cmd_host)
    doctor = commands.add_parser("doctor")
    doctor.add_argument("--repo")
    doctor.add_argument("--config")
    doctor.add_argument("--cli-path", required=True)
    doctor.add_argument("--docker-path", required=True)
    doctor.add_argument("--lockfile-policy", choices=("preserve",), default="preserve")
    doctor.add_argument("--ssh-agent", choices=("auto", "off"), default="auto")
    doctor.set_defaults(callback=cmd_doctor)
    location = commands.add_parser("open-location")
    location.add_argument("--cwd", required=True)
    location.add_argument("--file", required=True)
    location.add_argument("--line", type=int, default=1)
    location.add_argument("--column", type=int, default=1)
    location.add_argument("--wait-timeout", type=float, default=SPOOL_TIMEOUT_SECONDS)
    location.add_argument("--fallback-exact", action="store_true")
    location.set_defaults(callback=cmd_open_location)
    editor = commands.add_parser("editor-open")
    editor.add_argument("--cwd")
    editor.add_argument("--file")
    editor.add_argument("--line", type=int, default=1)
    editor.add_argument("--column", type=int, default=1)
    editor.add_argument("--wait-timeout", type=float, default=SPOOL_TIMEOUT_SECONDS)
    editor.add_argument("--wait-editor", action="store_true")
    editor.add_argument("--signal-ready", action="store_true")
    editor.add_argument("--tmux-pane")
    editor.add_argument("--fallback-exact", action="store_true", default=True)
    editor.add_argument("editor_file", nargs="?")
    editor.set_defaults(callback=cmd_editor_open)
    return value


def validate_arguments(arguments: argparse.Namespace) -> None:
    """Validate dependent command-line arguments."""
    if (
        getattr(arguments, "timeout", 1.0) <= 0
        or getattr(arguments, "wait_timeout", 1.0) <= 0
    ):
        fail("timeout must be positive")
    if arguments.command != "editor-open":
        return
    if arguments.wait_editor:
        if (
            not arguments.editor_file
            or arguments.cwd is not None
            or arguments.file is not None
        ):
            fail("--wait-editor requires exactly one FILE")
        if arguments.tmux_pane is not None and not valid_tmux_pane(arguments.tmux_pane):
            fail("--tmux-pane must be an exact tmux pane id")
    elif not arguments.cwd or not arguments.file or arguments.editor_file is not None:
        fail("--cwd and --file are required without --wait-editor")
    elif arguments.signal_ready:
        fail("--signal-ready requires --wait-editor")
    elif arguments.tmux_pane is not None and not valid_tmux_pane(arguments.tmux_pane):
        fail("--tmux-pane must be an exact tmux pane id")


def main(argv: Sequence[str] | None = None) -> int:
    """Run the requested lifecycle or routing command."""
    arguments = parser().parse_args(argv)
    validate_arguments(arguments)
    arguments.callback(arguments)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except NoActiveEditor as error:
        progress(str(error))
        raise SystemExit(3) from error
    except EditorError as error:
        progress(str(error))
        raise SystemExit(2) from error
